# apt-add-repo — сторонний репозиторий (исходник docs/Задания «apt add repo (21)»): добавить
# репозиторий Docker по официальной инструкции — ключ подписи в /etc/apt/keyrings, запись с
# signed-by в sources.list.d, затем apt update. Принято: ключ и запись на месте, apt update
# скачал списки download.docker.com, и последней командой был сам apt update.

image apt-add-repo:1

hidden hp

settings
  pager on

say "Список пакетов apt берёт из репозиториев. Можно добавить и чужой."
read brief.md

stage
  say "Добавь один из самых популярных репозиториев — Docker"
  solve:
    sudo apt-get update
    sudo apt-get install -y ca-certificates curl
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
    sudo apt-get update
  check exec added
  neutral ls cat pwd cd
  on pass say "apt policy покажет, откуда теперь берутся пакеты. Docker — в списке."
  hint output "Permission denied" say "Прав не хватает: всё в /etc принадлежит root. Как одолжить его права на одну команду?"
  hint output "curl: command not found" say "Инструкция начинается не с ключа: сначала ставят то, чем его скачивают."
  hint output "NO_PUBKEY" say "apt не верит репозиторию: ключа подписи нет там, куда указывает signed-by."
  hint tries 9 say "Шаги идут по порядку: инструменты, ключ, запись, update. Какой ещё не сделан? Загляни в /etc/apt/keyrings и /etc/apt/sources.list.d."
  hint idle 300 say "Долгая пауза. Сверь свои команды с инструкцией строчка за строчкой."

exec finale
