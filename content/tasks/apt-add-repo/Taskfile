# apt-add-repo — сторонний репозиторий (исходник docs/Задания «apt add repo (21)»: подключить
# репозиторий Docker по официальной инструкции). Пользователь, 2026-10-14: «чтобы пользователи
# попытались скачать, не получилось — подключили реп — скачали; проверка по появлению файла».
# Шаг: поставить docker-ce-cli. apt его не знает («has no installation candidate») — тогда приходит
# доза repo.md с инструкцией Docker. Принято, когда пакет встал: /usr/share/doc/docker-ce-cli есть
# только у пакета Docker (дебиановский docker.io даёт /usr/bin/docker, но не его).

image apt-add-repo:1

hidden hp

settings
  pager on

say "Список пакетов apt берёт из репозиториев. Можно добавить и чужой."
read brief.md

stage
  say "Поставь docker-ce-cli — консольный клиент Docker"
  solve:
    sudo apt-get update
    sudo apt-get install -y ca-certificates curl
    sudo install -m 0755 -d /etc/apt/keyrings
    sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
    sudo chmod a+r /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
    sudo apt-get update
    sudo apt-get install -y docker-ce-cli
  observe bool /usr/share/doc/docker-ce-cli
  neutral ls cat pwd cd
  on pass say "Пакет пришёл из download.docker.com — apt policy docker-ce-cli показывает, из какого репозитория."
  hint output "has no installation candidate" read repo.md
  hint output "Unable to locate package" read repo.md
  hint output "Permission denied" say "Прав не хватает: в /etc пишет только root. sudo уже стоит, а ошибка осталась? Перечитай, зачем в инструкции | sudo tee."
  hint output "NO_PUBKEY" say "apt не верит репозиторию: ключа подписи нет там, куда указывает signed-by."
  hint tries 5 say "Шаги идут по порядку: инструменты, ключ, запись, update, установка. Какой ещё не сделан?"

exec finale
