#!/bin/sh
# Принято: последней командой был apt update; ключ Docker и запись с signed-by на месте; списки
# пакетов download.docker.com скачаны (update прошёл с новым репозиторием).
printf '%s\n' "$1" | grep -Eq '^(sudo +)?apt(-get)? +update' || exit 1
[ -s /etc/apt/keyrings/docker.asc ] || exit 1
grep -q 'signed-by=/etc/apt/keyrings/docker.asc' /etc/apt/sources.list.d/docker.list 2>/dev/null || exit 1
grep -q 'download.docker.com' /etc/apt/sources.list.d/docker.list || exit 1
ls /var/lib/apt/lists/ 2>/dev/null | grep -q 'download.docker.com'
