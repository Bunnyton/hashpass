# apt-deb — установка .deb напрямую. Установка принимается по РЕЗУЛЬТАТУ (dpkg-статус
# «install ok installed»): `dpkg -i` без зависимостей оставляет пакет ненастроенным — это не
# установка. Второй шаг — запуск (accept cmd … ok: cmatrix обязан завершиться нормально).

image apt-deb:1

# В базе нет ни wget, ни curl — без них .deb не скачать.
run apt-get update >/dev/null 2>&1
run DEBIAN_FRONTEND=noninteractive apt-get install -y wget curl >/dev/null 2>&1

hidden hp

settings
  pager on

say "Иногда пакет лежит на диске .deb-файлом. Ставится и такой."
read brief.md

stage
  "Скачай .deb по ссылке из брифа и установи из него cmatrix"
  solve:
    wget -q http://ftp.debian.org/debian/pool/main/c/cmatrix/cmatrix_2.0-3_amd64.deb
    sudo apt-get install -y ./cmatrix_2.0-3_amd64.deb >/dev/null 2>&1
  check exec sh -c "dpkg-query -W -f='\${Status}' cmatrix 2>/dev/null | grep -q 'install ok installed'"
  neutral ls cat pwd
  on pass say "dpkg -L cmatrix перечислит все файлы, которые принёс пакет. Найди, где лежит сам бинарь."
  hint output "command not found" say "Такой скачивалки нет. Их как минимум две — загугли."
  hint output "dependency problems" say "dpkg сам сказал, чего не хватает. В теории есть, чем доделать."
  hint output "Unmet dependencies" say "apt отказался — и в последней строке сам написал, что попробовать. Прочитай её."
  hint output "Permission denied" say "Установщику не хватило прав. Как обычный пользователь одалживает права администратора на одну команду?"
  hint tries 3 say "Файл скачался (ls)? Дальше — по теории."
  hint tries 6 say "man dpkg — «install»; apt тоже умеет ставить ./файл.deb."
  hint idle 240 say "Долгая пауза. Перечитай цель и вывод последней команды — ответ обычно там."

stage
  "А теперь запусти cmatrix — и выйди из него клавишей q"
  accept cmd "cmatrix" ok
  neutral ls cat pwd
  on pass say "cmatrix -r — цветной дождь. А cmatrix -h расскажет остальное. Выход всё так же q."
  hint tries 4 say "Команда называется так же, как пакет."
  hint idle 240 say "Матрица ждёт. Перечитай цель."

exec finale
