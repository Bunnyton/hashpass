# apt-remove — удалить пакет через apt. Продолжение apt-update: наследуем его образ и
# воспроизводим его конечное состояние (sl установлен) — действия студента между заданиями
# не сохраняются. Без `|| true`: если sl не встал, сборка обязана упасть, а не выпустить
# задание с ложной предпосылкой.

image apt-remove:1
from apt-update:1

run apt-get update >/dev/null 2>&1 && apt-get install -y sl >/dev/null 2>&1

hidden hp

settings
  user root
  pager on

say "sl оказался слишком настойчив. Верни всё, как было."
read brief.md

stage "Удали пакет sl из системы — ls снова должен быть просто ls"
  solve apt-get remove -y sl
  check exec sh -c '! command -v sl >/dev/null 2>&1 && ! test -x /usr/games/sl'
  neutral ls cat pwd
  on enter say "Поезд ходит на каждую опечатку. Пора закрыть станцию."
  hint output "Permission denied" say "apt нужны права администратора. Ты root? Проверь: whoami."
  hint tries 3 say "sl всё ещё запускается? Проверь: command -v sl. Установка была через apt — удаление через него же, только другое действие."
  hint tries 6 say "apt --help перечисляет действия. Или загугли: «apt удалить пакет»."
  hint idle 240 say "Перечитай теорию из прошлого задания: у install есть обратное действие."

exec finale
