# apt-remove — удалить пакет через apt. Продолжение apt-update: наследуем его образ и
# воспроизводим его конечное состояние (sl установлен) — действия студента между заданиями
# не сохраняются. Без `|| true`: если sl не встал, сборка обязана упасть, а не выпустить
# задание с ложной предпосылкой.

image apt-remove:1
from apt-update:1

run apt-get update >/dev/null && apt-get install -y sl >/dev/null

hidden hp

settings
  pager on

say "Чу-чух. Чу-чух. Чу-чух…"
read brief.md

stage "Удали пакет sl из системы"
  solve sudo apt-get remove -y sl
  check exec sh -c '! command -v sl >/dev/null 2>&1 && ! test -x /usr/games/sl'
  neutral ls cat pwd
  on pass say "apt autoremove убирает библиотеки, которые остались без хозяина. Посмотри, что он предложит."
  hint output "Permission denied" say "apt отказал: прав не хватает. Кто имеет право удалять пакеты — и как одолжить его права на одну команду?"
  hint tries 3 say "Ставил через apt — удаляй через него же, другим действием."
  hint tries 6 say "apt --help перечисляет действия. Или загугли: «apt удалить пакет»."
  hint idle 240 say "Перечитай теорию из прошлого задания: у install есть обратное действие."

exec finale
