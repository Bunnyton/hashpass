#!/bin/sh
# Шаг «удали по списку»: observe каталога не замечает лишних файлов, а имена с пробелами в
# Taskfile не перечислить — поэтому проверка здесь. Список — своя копия (студентский delete.txt
# можно и стереть): ни одного имени из него в ~/photos, и ничего лишнего не удалено (150 - 12).
dir=$(dirname "$0")
cd /home/student/photos || exit 1
while IFS= read -r n; do
    [ -e "$n" ] && exit 1
done < "$dir/delete.txt"
[ "$(ls | wc -l)" -eq 138 ]
