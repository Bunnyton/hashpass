# cat-file — читаем файлы: cat, и первый grep. Приёмка — по выводу (одна строка с СЕКРЕТ).

image cat-file:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/key_here.txt --kind ads --lines 320 --seed 101 --plant 'СЕКРЕТ: black-cat-on-a-mat@0.58'
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/bank-notice.txt --kind ads --lines 60 --seed 110
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/newsletter-09.txt --kind ads --lines 90 --seed 111
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/promo-summer.txt --kind ads --lines 45 --seed 112
