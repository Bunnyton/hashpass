# cat-file — читаем файлы: cat, и первый grep. Приёмка — по выводу (одна строка с СЕКРЕТ).

image cat-file:1

run mkdir -p /home/student/mailbox
run printf 'Здесь может быть ваша реклама\nЗдесь может быть ваша реклама\nСЕКРЕТ: black-cat-on-a-mat\nЗдесь может быть ваша реклама\nЗдесь может быть ваша реклама\n' > /home/student/mailbox/key_here.txt
run chown -R student:student /home/student/mailbox

hidden hp

settings
  pager on

say "Файлы можно читать прямо в терминале. Иногда — целиком, иногда — только нужное."
read brief.md

stage "Найди в /home/student/mailbox/key_here.txt строку с СЕКРЕТОМ и выведи только её"
  solve grep СЕКРЕТ /home/student/mailbox/key_here.txt
  variant cat /home/student/mailbox/key_here.txt | grep СЕКРЕТ
  observe output
  neutral ls pwd
  on enter say "Пять писем в ящике, одно — важное. Остальное — реклама."
  on pass say "Подсказка на будущее: grep -n покажет ещё и номер строки — попробуй прямо сейчас."
  hint cmd cat say "Секрет виден. Теперь покажи только его строку."
  hint tries 3 say "cat даёт всё. В теории был инструмент для строк."
  hint tries 6 say "man grep — или загугли: «вывести из файла строки содержащие слово linux»."
  hint idle 240 say "Перечитай цель: нужна одна строка, а не весь файл."

exec finale
