# cat-file — читаем файлы: cat. Ключ спрятан в одном из пяти писем; студент знает ls (прошлое
# задание) и cat (теория этого). Приёмка — скрытая проверка по выводу последней команды
# (HP_LAST_OUT): ключ показан на экране — неважно, какой командой.

image cat-file:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/bank-notice.txt --kind ads --lines 28 --seed 110
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/newsletter-09.txt --kind ads --lines 34 --seed 111
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/promo-summer.txt --kind ads --lines 22 --seed 112
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/spam-2019.txt --kind ads --lines 30 --seed 113 --plant 'КЛЮЧ: black-cat-on-a-mat@0.6'
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/mailbox/from-grandma.txt --kind prose --lines 26 --seed 114
copy data/mailbox /home/student/mailbox
run chown -R student:student /home/student/mailbox

hidden hp

settings
  pager on

say "Окей, тебе пригодится всё, чему тебя учили."
read brief.md

stage
  say "Найди ключ! Он где-то в письмах в /home/student/mailbox"
  solve cat /home/student/mailbox/spam-2019.txt
  check exec grade
  neutral ls pwd cd
  on pass say "Ключ лежал в спаме — так часто и бывает. А cat умеет открыть и несколько файлов разом: cat a.txt b.txt."
  hint tries 5 say "Писем несколько, а ключ — в одном. Все открыл?"
  hint tries 8 say "Сначала посмотри, какие письма лежат в mailbox, потом открывай каждое командой из теории."
  hint idle 240 say "Долгая пауза. Перечитай цель и вывод последней команды."

exec finale
