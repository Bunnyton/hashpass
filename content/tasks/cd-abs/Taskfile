# cd-abs — навигация: абсолютные и относительные пути. Приёмка — по выводу pwd.

image cd-abs:1

# data/dir1: цепочка dir1/…/dir9/cd_to_me плюс 2–3 каталога-двойника и файлы на каждом этаже (gen seed 102)
copy data/dir1 /home/student/dir1
run chown -R student:student /home/student/dir1

hidden hp

settings
  pager on

say "Файлы — половина мира. Вторая половина — каталоги."
read brief.md

stage "Доберись до /home/student/dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9/cd_to_me и покажи абсолютный путь, где ты оказался"
  solve:
    cd /home/student/dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9/cd_to_me
    pwd
  observe output
  neutral ls cat
  on enter say "Девять этажей вниз. Лифта нет, зато есть клавиша Tab."
  on pass say "cd без аргументов вернёт домой откуда угодно. А cd - — на шаг назад. Проверь оба."
  hint output "No such file or directory" say "bash говорит: такого каталога нет. Проверь имя — и откуда ты идёшь: путь относительный или от корня?"
  hint tries 5 say "Ты уже внутри? В теории есть команда, которая печатает, где ты."
  hint tries 9 say "Путь можно набрать целиком от корня — Tab дополнит."
  hint idle 240 say "Перечитай цель: два действия — добраться и показать путь."

exec finale
