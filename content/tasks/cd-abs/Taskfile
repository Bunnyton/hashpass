# cd-abs — навигация (исходник docs/Задания «cd (6)»): сначала дойти до cd_to_me ТОЛЬКО абсолютным
# путём и сделать ls; розыгрыш в look_here.txt велит подняться на уровень выше — и теперь ТОЛЬКО
# через `cd ..`, после чего pwd. На неверный путь консоль отвечает репликами исходника; доза про
# относительные пути приходит, когда студент упрётся в запрет абсолютного. Третий шаг — вернуться и
# прочитать look_here.txt: там уже розыгрыш (moved), и только после него финал.

image cd-abs:1

# data: data/dir1 сделан руками один раз (цепочка dir1/…/dir9/cd_to_me + каталоги-двойники) — правь файлы напрямую
copy data/dir1 /home/student/dir1
run chown -R student:student /home/student/dir1

hidden hp

settings
  pager on
  similarity 100

say "Файлы — половина мира. Вторая половина — каталоги."
read brief.md

stage
  say "Перейди в dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9/cd_to_me и выполни там ls"
  solve ls /home/student/dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9/cd_to_me
  check exec there
  block cd unless "^cd +/home/student/" say "no no no, mister fish! Используй абсолютный путь"
  neutral pwd
  on pass say "Что-то нашлось. Загляни внутрь."
  hint output "No such file or directory" say "Такого каталога нет. Путь от корня точно набран без опечаток? Tab их не делает."
  hint tries 4 say "Абсолютный путь начинается от самого корня — с той же косой черты, что в теории."
  hint idle 240 say "Долгая пауза. Перечитай цель: дойти и сделать ls."

stage
  solve:
    cd /home/student/dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9
    pwd
  observe output
  block cd unless "^cd +(\./)?\.\./?$" say "Так, ты правда решил, что лучше будет использовать абсолютный путь?"
  neutral ls cat
  on pass say "Ты же использовал Tab, да? ;)"
  on pass apply moved
  hint output "лучше будет использовать абсолютный путь" read relative.md
  hint tries 3 say "А что написано в файле, который ты нашёл?"
  hint idle 240 say "Долгая пауза. Перечитай look_here.txt."

stage
  say "Ты почти у цели: вернись в cd_to_me — в look_here.txt тебя кое-что ждёт :)"
  solve cat /home/student/dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9/cd_to_me/look_here.txt
  check exec readback
  neutral ls pwd cd
  on pass say "Розыгрыш удался. Зато теперь cd в обе стороны — твоя стихия."
  hint tries 3 say "Где лежит look_here.txt? Ты там уже был — дорога знакомая."
  hint idle 240 say "Долгая пауза. Перечитай цель: вернуться и прочитать."

exec finale
