# cd-abs — навигация: абсолютные и относительные пути. Приёмка — по выводу pwd.

image cd-abs:1

# data: data/dir1 сделан руками один раз (цепочка dir1/…/dir9/cd_to_me + каталоги-двойники) — правь файлы напрямую
copy data/dir1 /home/student/dir1
run chown -R student:student /home/student/dir1

hidden hp

settings
  pager on

say "Файлы — половина мира. Вторая половина — каталоги."
read brief.md

stage
  "Доберись до /home/student/dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9/cd_to_me и покажи свой абсолютный путь"
  solve:
    cd /home/student/dir1/dir2/dir3/dir4/dir5/dir6/dir7/dir8/dir9/cd_to_me
    pwd
  observe output
  neutral ls cat
  on pass say "cd без аргументов вернёт домой откуда угодно. А cd - — на шаг назад. Проверь оба."
  hint output "No such file or directory" say "bash говорит: такого каталога нет. Откуда ты идёшь — от корня или от того места, где стоишь?"
  hint tries 5 say "Ты уже внутри? В теории есть команда, которая печатает, где ты."
  hint tries 9 say "Путь можно набрать целиком, от самого корня."
  hint idle 240 say "Перечитай цель: два действия — добраться и показать путь."

exec finale
