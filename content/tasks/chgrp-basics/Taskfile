# chgrp-basics — группа файла (исходник docs/Задания «chgrp (26)»): .secret/rock.txt принадлежит
# root:FiveFingerDeathPunch. Работают только chgrp (можно с sudo) и cd/cat/ls/echo — без sudo:
# прочитать файл через sudo cat не выйдет, нужно сменить группу и прочитать обычным cat.

image chgrp-basics:1

# data: data/secret/rock.txt — эмблема группы из исходника, без фона и подписи: она же и финал
# (пользователь, 2026-10-23: «эмблема группы — это и будет мем и вывод»)
copy data/secret /home/student/.secret
run chown -R student:student /home/student/.secret
run groupadd -f FiveFingerDeathPunch
run chown root:FiveFingerDeathPunch /home/student/.secret/rock.txt
run chmod 640 /home/student/.secret/rock.txt
run chmod 755 /home/student/.secret


settings
  pager on

say "Права держат тебя снаружи. Но группу можно сменить — и войти."
read brief.md

stage
  say "Прочитай /home/student/.secret/rock.txt"
  solve:
    sudo chgrp student /home/student/.secret/rock.txt
    cat /home/student/.secret/rock.txt
  # прочитал = cat этого файла завершился успешно (из любого каталога, любым путём к нему)
  accept cmd "cat /home/student/.secret/rock.txt" ok
  allow chgrp cat
  neutral ls cd echo pwd
  block cat match "^sudo " say "Команда запрещена"
  block ls match "^sudo " say "Команда запрещена"
  block cd match "^sudo " say "Команда запрещена"
  block echo match "^sudo " say "Команда запрещена"
  on pass say "id покажет все твои группы вместе с их номерами."
  hint output "Permission denied" say "Файл не твой и группа не твоя. Чью из двух поменять проще?"
  hint output "Operation not permitted" say "Сменить группу чужого файла может только root. А одолжить его права chgrp — можно."
  hint tries 5 say "ls -l .secret/rock.txt — кто владелец, какая группа, что разрешено группе?"
  hint tries 10 say "man chgrp — SYNOPSIS."
