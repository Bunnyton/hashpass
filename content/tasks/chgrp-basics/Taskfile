# chgrp-basics — сменить группу файла, чтобы получить к нему доступ.

image chgrp-basics:1

# data/secret: python3 .claude/skills/task-authoring/scripts/mkdata.py text … (rock.txt — 80 строк, ключ на 50 %)
copy data/secret /home/student/.secret
run chown -R student:student /home/student/.secret
run groupadd -f FiveFingerDeathPunch
run chown root:FiveFingerDeathPunch /home/student/.secret/rock.txt
run chmod 640 /home/student/.secret/rock.txt
run chmod 755 /home/student/.secret

hidden hp

settings
  pager on

say "Права держат тебя снаружи. Но группу можно сменить — и войти."
read brief.md

stage "Смени группу файла /home/student/.secret/rock.txt на student — тогда файл откроется"
  solve sudo chgrp student /home/student/.secret/rock.txt
  check exec sh -c 'test "$(stat -c %G /home/student/.secret/rock.txt)" = "student"'
  neutral ls cat pwd cd
  on enter say "Файл принадлежит root и группе FiveFingerDeathPunch. Ты не в группе. Пока."
  on pass say "Группы пользователя: команда groups. Ты в sudo? А в FiveFingerDeathPunch — уже нет нужды."
  hint output "Operation not permitted" say "Чей файл — того и право менять. Одолжи права."
  hint output "Permission denied" say "Читать пока нельзя. Задача — не прочитать, а сменить группу."
  hint tries 3 say "ls -l .secret/rock.txt — какая там группа? Какая команда меняет именно её?"
  hint tries 6 say "man chgrp — SYNOPSIS. Или загугли: «изменить группу файла linux»."
  hint idle 240 say "Перечитай цель: группа — student, файл — в .secret."

exec finale
