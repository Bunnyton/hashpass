# chmod-basics — права: числовая запись. Каталогу perm_dir — drwxr----x (741).

image chmod-basics:1

run mkdir -p /home/student/perm_dir
run printf '#!/bin/bash\necho "Я обязательно выживу"\n' > /home/student/perm_dir/file.txt
run printf '#!/bin/bash\necho "run me"\n' > /home/student/perm_dir/exec_me.sh
run chmod 777 /home/student/perm_dir /home/student/perm_dir/file.txt /home/student/perm_dir/exec_me.sh
run chown -R student:student /home/student/perm_dir

hidden hp

settings
  pager on

say "У каждого файла есть права. rwxrwxrwx — три тройки: владелец / группа / остальные."
read brief.md

stage "Выставь каталогу /home/student/perm_dir права drwxr----x: владельцу — всё, группе — только чтение, остальным — только вход"
  solve chmod 741 /home/student/perm_dir
  check exec sh -c 'test "$(stat -c %a /home/student/perm_dir)" = "741"'
  neutral ls cat pwd
  on enter say "Три тройки — три цифры. Сейчас там 777: можно всё и всем."
  hint output "Operation not permitted" say "Система не даёт менять права. Чей это каталог (ls -ld) — и кто ты?"
  hint tries 3 say "Проверь, что получилось: ls -ld perm_dir. Сравни букву за буквой с целью — какая тройка не сошлась?"
  hint tries 6 say "Каждая тройка — сумма: r=4, w=2, x=1. Посчитай три числа по отдельности. Или загугли: «chmod калькулятор»."
  hint idle 240 say "Перечитай цель: rwx | r-- | --x. Три цифры."

exec finale
