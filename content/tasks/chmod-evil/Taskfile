# chmod-evil — злая цепочка прав (исходник docs/Задания «chmod evil (30)»): 17 целей подряд на
# одних и тех же файлах — «чтобы ls -l показал …». Режим записи чередуется: только цифрами или только
# буквами (+/-); неверный режим консоль не пускает. Часть целей — с группой minimal (chgrp), одна —
# на файле в 34 уровнях каталогов. Значения и порядок — из исходного task.sh.

image chmod-evil:1

# data: data/home сделан скриптом из списка целей исходника (тексты файлов неважны)
copy data/home /home/student
run groupadd -f minimal
run usermod -aG minimal student
run chown -R student:student /home/student
run chmod 644 /home/student/test /home/student/test1 /home/student/test2 /home/student/test3 /home/student/test4

hidden hp

settings
  pager on

read brief.md

stage
  say "ls -l должен показать: ---x--x--x student student ./test — цифрами"
  solve chmod 111 /home/student/test
  observe perms /home/student/test
  block chmod match " [ugoa]*[-+=][rwxXst]" say "Используй только побитовую запись прав для chmod (chmod 777)"
  neutral ls cat pwd cd
  hint tries 5 say "ls -l test — сравни свои тройки с целью."

stage
  say "ls -l должен показать: ---x-w--wx student student ./test — буквами"
  solve chmod 123 /home/student/test
  observe perms /home/student/test
  block chmod match "chmod +(-[a-zA-Z]+ +)*[0-7]{3,4}( |$)" say "Используй только относительную запись прав для chmod (chmod +x)"
  neutral ls cat pwd cd
  hint tries 5 say "Буквами: какие биты добавить, какие забрать — у кого?"

