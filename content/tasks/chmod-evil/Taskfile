# chmod-evil — усложнённый chmod: относительная запись (u+r, o-x …), три файла.
# Приёмка — по итоговым правам (stat) + фоновое правило в hp/perm: последняя chmod файла — буквами.
# Цифры (chmod 111) принимаются молча НЕ будут: студенту об этой проверке не говорится, в брифе
# только «никакого chmod NNN». Переделать буквами можно в любой момент.

image chmod-evil:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/target/test2 --kind notes --lines 40 --seed 131
# data: data/target сделан руками один раз — правь файлы напрямую
copy data/target /home/student/target
run chmod 000 /home/student/target/test1 /home/student/target/test2 /home/student/target/test3
run chown -R student:student /home/student/target

hidden hp

settings
  pager on

say "Тварь ты дрожащая или право имеешь? chmod поможет разобраться."
read brief.md

stage "Выставь файлу /home/student/target/test1 права --x--x--x"
  solve chmod +x /home/student/target/test1
  check exec perm /home/student/target/test1 111
  neutral ls cat pwd
  on pass say "u, g, o — три адресата; a — все сразу. Ты только что раздал x всем одной буквой."
  hint tries 3 say "ls -l target/test1: какое право появилось и у кого?"
  hint tries 6 say "man chmod, символьный режим: u/g/o/a и +/-."
  hint idle 240 say "Перечитай цель: три тройки, в каждой — только x."

stage "Выставь файлу /home/student/target/test2 права -w-rw-r--"
  solve:
    chmod u+w,g+rw,o+r /home/student/target/test2
  check exec perm /home/student/target/test2 264
  neutral ls cat pwd
  on pass say "Кроме + и - есть ещё =: u=rw оставит владельцу ровно rw, что бы там ни было раньше."
  hint tries 3 say "Сравни тройка за тройкой — их можно менять по одной."
  hint tries 6 say "man chmod: несколько режимов через запятую."
  hint idle 240 say "Перечитай цель: -w- | rw- | r--. Кто получает что?"

stage "Выставь файлу /home/student/target/test3 права rwxr-xr-x"
  solve chmod u+rwx,go+rx /home/student/target/test3
  check exec perm /home/student/target/test3 755
  neutral ls cat pwd
  on pass say "rwxr-xr-x — 755, самые частые права скрипта. Теперь ты умеешь и буквами, и цифрами."
  hint tries 3 say "Группе и остальным нужно одно и то же — есть ли способ назвать обоих сразу?"
  hint tries 6 say "man chmod: буквы категорий объединяются."
  hint idle 240 say "Перечитай цель: rwx | r-x | r-x."

exec finale
