#!/bin/sh
# symbolic FILE — тихий шаг: последняя команда студента ($1) — chmod с ОТНОСИТЕЛЬНОЙ записью
# (u+x, go-r, a=…), задевающая FILE: сам файл, маску вроде test* или каталог над ним (-R).
# Студенту не показывается; цифры (chmod 111) этот шаг просто не проходят.
cmd=$1
f=$2
[ -n "$cmd" ] || exit 1
printf '%s\n' "$cmd" | awk -v path="$f" '
function base(p) { sub(/\/+$/, "", p); n = split(p, a, "/"); return a[n] }
function glob2re(g,   r) { r = g; gsub(/\./, "\\.", r); gsub(/\*/, ".*", r); gsub(/\?/, ".", r); return "^" r "$" }
function touches(t,   b) {
    b = base(t)
    if (b == "" || b == ".") return 1
    if (name ~ glob2re(b)) return 1
    return index("/" path "/", "/" b "/") > 0
}
BEGIN { name = base(path) }
{
    n = split($0, segs, /;|&&|\|\||\||&/)
    for (s = 1; s <= n; s++) {
        k = split(segs[s], w, /[ \t]+/)
        i = 1
        while (i <= k && w[i] == "") i++
        if (w[i] == "sudo") { i++; while (i <= k && w[i] ~ /^-/) i++ }
        if (w[i] != "chmod" && w[i] !~ /\/chmod$/) continue
        i++; mode = ""
        for (; i <= k; i++) {
            if (w[i] == "") continue
            if (mode == "" && (w[i] ~ /^--/ || w[i] ~ /^-[RvcfH]+$/)) continue
            if (mode == "") { mode = w[i]; continue }
            if (touches(w[i]) && mode !~ /^[0-7]+$/) ok = 1
        }
    }
}
END { exit ok ? 0 : 1 }
'
