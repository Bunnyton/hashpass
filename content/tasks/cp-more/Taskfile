# cp-more — рекурсивное копирование: всё содержимое dir1 → dir2 одной командой.

image cp-more:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/dir1 --seed 150 --depth 3 --dirs 9 --files 34 --lines 5-40 --plant 'file1.txt=Любопытной Варваре...' --plant 'file2.txt=...на базаре нос оторвали' --plant 'file3.txt=но она вернулась'
# data: dir1.sha256 в скрытом слое: (cd data && find dir1 -type f | LC_ALL=C sort | xargs sha256sum) — эталон для проверки
copy data/dir1 /home/student/dir1
run mkdir -p /home/student/dir2
run chown -R student:student /home/student/dir1 /home/student/dir2

hidden hp

settings
  pager on

say "Один файл скопировать легко. А если их три десятка, да ещё по каталогам?"
read brief.md

stage
  say "Скопируй всё содержимое /home/student/dir1 в /home/student/dir2 одной командой"
  solve cp -r /home/student/dir1/. /home/student/dir2/
  check exec grade
  neutral ls cat pwd
  on pass say "Тридцать восемь файлов в десяти каталогах — одной командой, и dir1 цел."
  hint output "omitting directory" say "cp пропустил каталоги: «omitting directory». Каталог с содержимым он копирует только с ключом рекурсии — -r (recursive)."
  hint cmd cp has -r say "Скопировалось — но куда именно? Загляни в dir2."
  hint cmd mv say "Переехало, а не скопировалось — dir1 должен остаться целым."
  hint tries 5 say "Загляни в dir2: что там оказалось? Всё, что было в dir1, или только часть?"
  hint tries 10 say "man cp — найди слово recursive. Или загугли: «cp скопировать каталог со всем содержимым»."

exec finale
