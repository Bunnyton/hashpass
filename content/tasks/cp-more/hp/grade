#!/bin/sh
# Принято, если dir1 цел (каждый файл совпадает с эталонным списком dir1.sha256 рядом)
# и каждый его файл лежит в dir2 с тем же содержимым — любым способом; лишнее в dir2 не мешает.
cd /home/student || exit 1
here=$(dirname "$0")
sha256sum -c --quiet "$here/dir1.sha256" >/dev/null 2>&1 || exit 1
sed 's#  dir1/#  dir2/#' "$here/dir1.sha256" | sha256sum -c --quiet >/dev/null 2>&1
