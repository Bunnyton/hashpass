# find-1 — знакомство с find: -maxdepth. Приёмка — по выводу.

image find-1:1

run mkdir -p /home/student/search/lvl1/lvl2/lvl3/lvl4/lvl5
run touch /home/student/search/f0.txt
run touch /home/student/search/lvl1/f1.txt
run touch /home/student/search/lvl1/lvl2/f2.txt
run touch /home/student/search/lvl1/lvl2/lvl3/f3.txt
run touch /home/student/search/lvl1/lvl2/lvl3/lvl4/f4.txt
run touch /home/student/search/lvl1/lvl2/lvl3/lvl4/lvl5/f5.txt
run chown -R student:student /home/student/search

hidden hp

settings
  pager on

say "find — швейцарский нож поиска. Ключей — вагон."
read brief.md

stage "Перечисли всё внутри /home/student/search, но не глубже 3-го уровня вложенности"
  solve find /home/student/search -maxdepth 3
  observe output
  neutral ls cat pwd cd
  on pass say "find -maxdepth 1 — это почти ls. Сравни: find search -maxdepth 1 и ls search."
  hint output "paths must precede expression" say "Порядок: сначала где искать, потом критерии."
  hint output "unknown predicate" say "find не знает такого ключа — присмотрись к дефисам."
  hint tries 3 say "Сравни вывод с ls -R search: лишние этажи или недостающие?"
  hint tries 6 say "man find — ищи слово «depth». Или загугли: «find ограничить глубину поиска»."
  hint idle 240 say "Сам каталог search — нулевой уровень."

exec finale
