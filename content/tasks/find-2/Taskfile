# find-2 — ровно 3-й уровень, только файлы (исходник «find 2 (14)»). -name запрещён: имена levelN_*
# выдали бы уровень. Если вывести и каталоги (забыть -type f) — Стэйтем: «чтобы видеть, нужно смотреть».

image find-2:1
from find-1:1

hidden hp

settings
  pager on

say "Продолжаем осваивать find."

stage
  say "Найди все файлы, которые находятся на 3-м уровне вложенности в search"
  solve find /home/student/search -mindepth 3 -maxdepth 3 -type f
  check exec grade
  block find match "-i?name" say "Нельзя использовать -name — уровень нужно найти, а не угадать по имени."
  neutral ls cat pwd cd
  on pass say "Это только начало..."
  hint cmd find has -mindepth missing -type exec statham
  hint tries 5 say "-maxdepth отрезает то, что глубже. А что отрежет то, что выше?"
  hint tries 10 say "man find — рядом с maxdepth живёт его брат."

exec finale
