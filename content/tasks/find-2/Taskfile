# find-2 — точный уровень: -mindepth + -maxdepth + -type. Приёмка — по выводу.

image find-2:1

run mkdir -p /home/student/search/a/b/c /home/student/search/x/y/z
run touch /home/student/search/root.txt
run touch /home/student/search/a/lvl1.txt
run touch /home/student/search/a/b/lvl2.txt
run touch /home/student/search/a/b/c/lvl3.txt
run touch /home/student/search/x/one.txt
run touch /home/student/search/x/y/two.txt
run touch /home/student/search/x/y/z/three.txt
run chown -R student:student /home/student/search

hidden hp

settings
  pager on

say "Продолжаем осваивать find. -mindepth — младший брат -maxdepth."
read brief.md

stage "Найди файлы (только файлы), лежащие ровно на 3-м уровне вложенности внутри /home/student/search"
  solve find /home/student/search -mindepth 3 -maxdepth 3 -type f
  observe output
  neutral ls cat pwd cd
  on enter say "Стенка снизу, стенка сверху — и в щели между ними ровно один этаж."
  hint output "paths must precede expression" say "find ругается на порядок: сначала ГДЕ, потом критерии."
  hint tries 3 say "В выводе есть каталоги? Или файлы с других этажей? Сравни с ls -R search — какой предикат отсекает лишнее?"
  hint tries 6 say "man find: слова «mindepth», «maxdepth», «type». Или загугли: «find файлы на определённой глубине»."
  hint idle 240 say "Перечитай цель: ровно третий уровень и только файлы. Это три условия."

exec finale
