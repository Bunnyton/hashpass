# find-2 — точный уровень: -mindepth + -maxdepth + -type. Приёмка — по выводу.

image find-2:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/search --seed 162 --depth 6 --dirs 40 --files 170 --lines 2-12
copy data/search /home/student/search
run chown -R student:student /home/student/search

hidden hp

settings
  pager on

say "Продолжаем осваивать find. Сегодня — точность до этажа."
read brief.md

stage
  say "Найди только файлы, лежащие ровно на 3-м уровне вложенности в /home/student/search"
  solve find /home/student/search -mindepth 3 -maxdepth 3 -type f
  check exec grade
  neutral ls cat pwd cd
  on pass say "Меняй -type f на -type d — и те же этажи покажут каталоги. Проверь."
  hint output "paths must precede expression" say "find ругается на порядок: сначала ГДЕ, потом критерии."
  hint tries 3 say "В выводе есть каталоги или чужие этажи? Условий три."
  hint tries 6 say "man find: mindepth, maxdepth, type."
  hint idle 240 say "Перечитай цель: ровно третий уровень и только файлы."

exec finale
