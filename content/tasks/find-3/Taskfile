# find-3 — поиск по имени (-name). Приёмка — по выводу.

image find-3:1

run mkdir -p /home/student/search/a/b/c/level4_alpha/inside
run mkdir -p /home/student/search/x/y/z/level4_beta/inside
run mkdir -p /home/student/search/m/n/o/level4_gamma
run mkdir -p /home/student/search/other/deep/tree/regular_dir
run chown -R student:student /home/student/search

hidden hp

settings
  pager on

say "Ключ -name — фильтр по имени. С шаблоном * работает тонко."
read brief.md

stage "Найди внутри /home/student/search все каталоги, чьё имя начинается с level4"
  solve find /home/student/search -type d -name "level4*"
  variant find /home/student/search -name "level4*"
  observe output
  neutral ls cat pwd cd
  on enter say "Три каталога затерялись на четвёртом этаже. Имена у них похожие."
  hint output "paths must precede expression" say "find ругается на порядок: сначала ГДЕ, потом критерии."
  hint tries 3 say "По имени find ищет одним предикатом, а «начинается с…» — это имя плюс звёздочка. Теория показывала такой пример."
  hint tries 6 say "man find — предикат «name». Или загугли: «find найти каталоги по имени с шаблоном»."
  hint idle 240 say "Перечитай цель: имя начинается с level4 — значит, после него может быть что угодно."

exec finale
