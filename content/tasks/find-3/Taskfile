# find-3 — каталоги 4-го уровня при помощи -name (исходник «find 3 (15)»). Хитрость: в этом дереве
# уровень записан в самом имени (levelN_*), и -name заменяет -mindepth/-maxdepth — догадаться надо
# самому. Принимается только команда с -name.

image find-3:1
from find-1:1

hidden hp

settings
  pager on

say "Имена обманчивы. Или наоборот — говорят больше, чем кажется."

stage
  say "Найди все директории 4-го уровня — при помощи -name"
  solve find /home/student/search -type d -name "level4*"
  check exec grade
  neutral ls cat pwd cd
  on pass say "Имя может хранить больше, чем название. Здесь оно хранило глубину."
  hint output "paths must precede expression" say "find ругается на порядок: сначала где искать, потом критерии."
  hint tries 3 say "Посмотри внимательно на имена каталогов: что в них меняется от этажа к этажу?"
  hint tries 6 say "Каталоги, а не файлы: у find есть ключ, который отсеивает по типу."
  hint idle 240 say "Долгая пауза. Перечитай цель и вывод последней команды."

exec finale
