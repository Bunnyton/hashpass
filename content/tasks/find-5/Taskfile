# find-5 — критерий -not -empty. Приёмка — по выводу.

image find-5:1

run mkdir -p /home/student/search/a /home/student/search/b
run printf 'not empty\n' > /home/student/search/full1.txt
run printf 'has content\n' > /home/student/search/a/full2.txt
run printf 'also has data\n' > /home/student/search/b/full3.txt
run touch /home/student/search/empty1.txt
run touch /home/student/search/a/empty2.txt
run touch /home/student/search/b/empty3.txt
run chown -R student:student /home/student/search

hidden hp

settings
  pager on

say "У find десятки критериев. -empty и -not — сегодняшние гости."
read brief.md

stage "Найди в /home/student/search все непустые файлы"
  solve find /home/student/search -type f -not -empty
  variant find /home/student/search -type f \! -empty
  observe output
  neutral ls cat pwd cd
  on enter say "Половина файлов — пустышки. Нужны те, в которых что-то есть."
  on pass say "-empty находит и пустые каталоги. Сколько их в search? (подсказка: -type d)"
  hint output "paths must precede expression" say "find ругается на порядок: сначала ГДЕ, потом критерии."
  hint tries 3 say "ls -lR search: какие пустые? Как перевернуть предикат?"
  hint tries 6 say "man find: «empty», «not». Или загугли: «find непустые файлы»."
  hint idle 240 say "Перечитай цель: файлы (не каталоги), НЕпустые."

exec finale
