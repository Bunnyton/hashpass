# find-5 — непустые файлы (исходник «find 5 (17)»).

image find-5:1
from find-1:1

hidden hp

settings
  pager on

say "У find десятки критериев."

stage
  say "Найди все непустые файлы в search"
  solve find /home/student/search -type f -not -empty
  check exec grade
  neutral ls cat pwd cd
  on pass say "Всё становится чуточку интереснее!))"
  hint output "paths must precede expression" say "find ругается на порядок: сначала где искать, потом критерии."
  hint tries 5 say "Пустой ли файл — find проверять умеет. А как перевернуть условие?"
  hint tries 10 say "man find — слова «empty» и «not»."

exec finale
