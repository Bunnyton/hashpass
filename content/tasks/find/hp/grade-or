#!/bin/sh
# Принято, если вывод последней команды — ровно тот набор путей, что даёт
#   find search -type f \( -name "level2*" -o -name "*3*" \)
# в любом порядке; пути могут быть абсолютными или относительно /home/student (или search).

norm() {
  # Paths of the files themselves, however they are written and wherever find was run from:
  # absolute or relative, with or without ./, from ~ or from ~/search. A `search/…` line means the
  # run started in ~ -- then `.` and ./.bashrc are outside search and dropped; otherwise ./x is
  # search/x. Only paths inside search count.
  awk -v home=/home/student '
    { l = $0; sub(/\/$/, "", l); if (index(l, home "/") == 1) l = substr(l, length(home) + 2)
      n++; line[n] = l; if (l ~ /^(\.\/)?search(\/|$)/) fromhome = 1 }
    END { for (i = 1; i <= n; i++) { l = line[i]
            if (fromhome) sub(/^\.\//, "", l)
            else if (l == ".") l = "search"
            else if (l ~ /^\.\//) { sub(/^\.\//, "", l); l = "search/" l }
            if (l ~ /^search(\/|$)/) print l } }' | sort -u
}
want=$(cd /home/student && find search -type f \( -name "level2*" -o -name "*3*" \) | norm)
got=$(printf '%s\n' "${HP_LAST_OUT_ABS:-${HP_LAST_OUT:-}}" | norm)
[ -n "$got" ] && [ "$got" = "$want" ]
