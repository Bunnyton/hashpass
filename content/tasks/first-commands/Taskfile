# first-commands — вводное: ls → cat → ls -l → ls -la → --help → man (исходники docs/Задания
# «Простейший ls (1)», «cat (2)», «ls_la (3)», «help (4)», «man (5)» — одним заданием).
# Теория приходит дозами: бриф — только ls; каждый следующий шаг приносит свою порцию.
# Шаги 2 и 4 принимаются скрытой проверкой по выводу последней команды (HP_LAST_OUT).

image first-commands:1

# data: data/home сделан руками — readme_please.txt (52 строки рекламы и одна настоящая),
# скрытый .hidden_file, пара обычных файлов и каталог
copy data/home /home/student
run chown -R student:student /home/student

hidden hp

settings
  pager on

say "Добро пожаловать в консоль. Здесь всё делается словами."
read brief.md

stage
  say "Посмотри, какие файлы лежат там, где ты сейчас"
  accept cmd "ls" ok
  on pass say "Это всё, что видно. Пока."
  hint tries 5 say "Команда из теории — всего две буквы."

stage
  say "Прочитай readme_please.txt"
  solve cat /home/student/readme_please.txt
  check exec readme
  on enter read cat.md
  neutral ls pwd
  on pass say "Пятьдесят строк рекламы ради одной настоящей — привыкай, логи бывают такими же."
  hint tries 5 say "Открыть файл помогает команда из свежей теории."

stage
  say "Выведи подробную информацию о файлах — ключом -l"
  accept cmd "ls -l" ok
  on enter read keys.md
  on pass say "Ключ -l показывает подробности, но не все файлы. Чтобы увидеть все, включая скрытые, есть ключ -a (all) — можно -la или -al."
  hint tries 5 say "Ключ пишется после команды, через пробел и дефис."

stage
  say "Где-то рядом прячется скрытый файл. Найди его и прочитай"
  solve cat /home/student/.hidden_file
  check exec hidden
  neutral ls pwd
  on pass say "Так прячут настройки: в каждом домашнем каталоге их полно."
  hint tries 5 say "Обычный ls скрытое не показывает. А с каким ключом покажет?"
  hint tries 10 say "Имя нашёл? Открой его той же командой, что и readme_please.txt."

stage
  say "Посмотри, что выведет ls --help"
  accept cmd "ls --help" ok
  on enter read help.md
  on pass say "--help есть почти у каждой команды — спрашивай её саму, прежде чем гуглить."
  hint tries 5 say "Два дефиса и слово — сразу после ls."

stage
  say "Если man — команда, может ли она заглянуть внутрь самой себя?"
  accept cmd "man man" ok
  on enter read man.md
  on pass say "Внутри man — разделы, поиск по слову (/) и выход (q). Пригодится в каждом задании."
  hint tries 5 say "man открывает руководство по команде. А какую команду дать ей самой?"

exec finale
