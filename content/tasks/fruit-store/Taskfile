# fruit-store — фруктовый ларёк: sort → uniq → wc, три шага на экране — конвейер растёт на звено
# за шаг. Вывод сравнивается множеством строк (повторы не видны), поэтому шаг uniq ещё и требует
# ровно 17 строк — столько разных фруктов в журнале.

image fruit-store:1

# Ассортимент дня — с повторами, как в реальном журнале продаж.

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py list data/store/sold.txt --items apple,banana,cherry,kiwi,mango,pear,plum,grape,lemon,lime,melon,peach,fig,quince,apricot,orange,papaya --lines 500 --seed 170
copy data/store /home/student/store
run chown -R student:student /home/student/store

hidden hp

settings
  pager on

say "Утро в ларьке. Пора разобрать вчерашний журнал продаж."
read brief.md

stage
  say "Покажи журнал /home/student/store/sold.txt по алфавиту"
  solve sort /home/student/store/sold.txt
  accept cmd "sort"
  observe output
  neutral ls cat pwd less head
  on pass say "Одинаковые фрукты теперь стоят рядом. sort -r перевернёт порядок, а sort -R перемешает строки."
  hint tries 5 say "Какая из трёх команд в брифе расставляет строки по алфавиту?"

stage
  say "Теперь убери повторы — каждый фрукт по одному разу"
  solve sort /home/student/store/sold.txt | uniq
  observe output
  accept output "\A(?:[^\n]+\n){16}[^\n]+\n?\Z"
  neutral ls cat pwd less head
  on pass say "uniq сравнивает строку только с предыдущей — поэтому sort нужен раньше. А uniq -c ещё и посчитает каждый фрукт."
  hint tries 5 say "Повторы остались? uniq видит только соседей — что должно случиться со строками до него?"
  hint tries 10 say "Добавь к отсортированному следующее звено конвейера."

stage
  say "Так сколько разных фруктов в ларьке? Покажи одно число"
  solve sort /home/student/store/sold.txt | uniq | wc -l
  observe output
  neutral ls cat pwd less head
  on pass say "Три звена — один ответ. А sort -u умеет сразу и сортировать, и убирать повторы."
  hint output "sold.txt" say "wc напечатал ещё и имя файла. А если отдать ему строки по конвейеру, а не имя файла?"
  hint tries 5 say "Ещё одно звено в конце — какое из брифа считает строки?"

exec finale
