# fruit-store — фруктовый ларёк: sort → uniq → wc, три этапа, каждый — файл для следующего.

image fruit-store:1

# Ассортимент дня — с повторами, как в реальном журнале продаж.

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py list data/store/sold.txt --items apple,banana,cherry,kiwi,mango,pear,plum,grape,lemon,lime,melon,peach,fig,quince,apricot,orange,papaya --lines 500 --seed 170
copy data/store /home/student/store
run chown -R student:student /home/student/store

hidden hp

settings
  pager on

say "Утро в ларьке. Пора разобрать вчерашний журнал продаж."
read brief.md

stage "Отсортируй журнал /home/student/store/sold.txt и сохрани результат в /home/student/store/sorted.txt"
  solve sort /home/student/store/sold.txt > /home/student/store/sorted.txt
  observe /home/student/store/sorted.txt
  neutral ls cat pwd less
  on enter say "Хозяин ларька сортировать не умеет. Зато умеет шелл."
  on pass say "sort -r перевернёт порядок. А sort | uniq -c посчитает, сколько раз продали каждый фрукт — попробуй."
  hint tries 3 say "Отсортированное на экране? Отправь в файл."
  hint tries 6 say "Загугли: «linux отсортировать строки файла» и «bash вывод команды в файл»."
  hint idle 240 say "Перечитай цель: из какого файла, в какой файл, в каком порядке."

stage "Оставь в отсортированном списке только уникальные строки — результат в /home/student/store/unique.txt"
  solve uniq /home/student/store/sorted.txt > /home/student/store/unique.txt
  observe /home/student/store/unique.txt
  neutral ls cat pwd less
  on pass say "uniq работает только по соседям — поэтому sort нужен раньше. Проверь без sort: дубли останутся."
  hint tries 3 say "Дубли ещё есть? Какая команда убирает повторы — и почему ей нужен sort?"
  hint tries 6 say "Загугли: «linux удалить повторяющиеся строки из файла». Название команды очень короткое."
  hint idle 240 say "Перечитай цель: вход — sorted.txt, выход — unique.txt."

stage "Посчитай, сколько строк в unique.txt, и запиши число в /home/student/store/howmany.txt"
  solve wc -l < /home/student/store/unique.txt > /home/student/store/howmany.txt
  observe /home/student/store/howmany.txt
  neutral ls cat pwd less
  on pass say "wc -w считает слова, wc -c — байты. Одна команда, три счётчика."
  hint tries 3 say "cat howmany.txt: там только число, без имени файла?"
  hint tries 6 say "Загугли: «wc посчитать строки без имени файла» или «bash перенаправление ввода»."
  hint idle 240 say "Перечитай цель: число строк, одно число, в файл."

exec finale
