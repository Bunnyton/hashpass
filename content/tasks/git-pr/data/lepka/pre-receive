#!/bin/sh
# main защищена: в неё попадают только слияния pull request'ов из Лепки.
[ -n "$LEPKA_INTERNAL" ] && exit 0
while read old new ref; do
    if [ "$ref" = refs/heads/main ]; then
        echo "main защищена: изменения попадают в неё только через pull request в Лепке." >&2
        exit 1
    fi
done
