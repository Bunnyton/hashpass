# grep-hunt — junior разбирает legacy: собрать TODO в файл.

image grep-hunt:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/legacy/notes.txt --kind notes --lines 400 --seed 180 --sprinkle TODO: --sprinkle-count 24
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/legacy/meeting-2025.md --kind notes --lines 60 --seed 181
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/legacy/README.old --kind prose --lines 35 --seed 182
copy data/legacy /home/student/legacy
run chown -R student:student /home/student/legacy

hidden hp

settings
  pager on

say "Тебе достался устаревший проект. Разгребай techdebt."
read brief.md

stage "Собери все строки с TODO из /home/student/legacy/notes.txt в файл /home/student/todos.txt"
  solve grep TODO /home/student/legacy/notes.txt > /home/student/todos.txt
  variant grep -F TODO /home/student/legacy/notes.txt > /home/student/todos.txt
  observe /home/student/todos.txt
  neutral ls cat less pwd
  on enter say "Тимлид в отпуске. Заметки — твои. TODO — тоже."
  on pass say "Бонус: grep -c TODO notes.txt — сколько их всего? А grep -v TODO — всё, кроме них."
  hint cmd grep missing TODO say "Ищем именно строки с TODO — проверь, что ты просишь у grep."
  hint tries 3 say "Строки видишь? Отправь их в файл, а не на экран."
  hint tries 6 say "Загугли: «grep вывод в файл» или «bash перенаправление вывода»."
  hint idle 240 say "Перечитай цель: какие строки, из какого файла, в какой файл."

exec finale
