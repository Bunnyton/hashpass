# grep-hunt — junior разбирает legacy: шаг 1 — собрать строки с TODO в файл; шаг 2 — посчитать
# их, и сделать это должен сам grep (-c): awk/wc/sed отклоняются, решение с конвейером не принимается.
# Про -c бриф молчит: доза — подсказка «grep умеет считать сам», ключ студент находит в --help.

image grep-hunt:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/legacy/notes.txt --kind notes --lines 400 --seed 180 --sprinkle TODO: --sprinkle-count 24
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/legacy/meeting-2025.md --kind notes --lines 60 --seed 181
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/legacy/README.old --kind prose --lines 35 --seed 182
copy data/legacy /home/student/legacy
run chown -R student:student /home/student/legacy

hidden hp

settings
  pager on

say "Тебе достался устаревший проект. Разгребай techdebt."
read brief.md

stage
  say "Собери строки с TODO из /home/student/legacy/notes.txt в файл /home/student/todos.txt"
  solve grep TODO /home/student/legacy/notes.txt > /home/student/todos.txt
  variant grep -F TODO /home/student/legacy/notes.txt > /home/student/todos.txt
  observe /home/student/todos.txt
  neutral ls cat less pwd
  on pass say "План работ готов. Осталось понять, насколько он большой."
  hint cmd grep missing TODO say "Ищем именно строки с TODO — проверь, что ты просишь у grep."
  hint tries 5 say "Строки видишь? Отправь их в файл, а не на экран."
  hint tries 10 say "Загугли: «grep вывод в файл» или «bash перенаправление вывода»."

stage
  say "Тимлид спрашивает, сколько всего TODO в notes.txt. Запиши число в /home/student/todo-count.txt"
  solve grep -c TODO /home/student/legacy/notes.txt > /home/student/todo-count.txt
  check exec count
  neutral ls cat less pwd
  block awk match "." say "Сегодня считает grep — awk отдыхает."
  block wc match "." say "wc сегодня в отпуске вместе с тимлидом. Считать умеет и сам grep."
  block sed match "." say "sed тут не поможет: считает grep."
  block | match "." say "Без конвейера: grep умеет считать строки сам."
  on pass say "grep -c считает совпавшие строки, а grep -v, наоборот, выводит всё, кроме них."
  hint tries 5 say "Какой ключ grep выводит не сами строки, а их количество? Ответ — в grep --help."
  hint tries 10 say "Загугли: «grep посчитать количество совпадений»."

exec finale
