# grep-search — рекурсивный поиск: grep -r. Приёмка — по выводу: только строка, без имени файла
# (с обычным -r в выводе есть путь, канон разъезжается; кто хочет -r — сам уберёт имя файла).

image grep-search:1

run mkdir -p /home/student/haystack/a/b/c /home/student/haystack/x/y /home/student/haystack/z
run printf 'обычный текст\n' > /home/student/haystack/a/f1.txt
run printf 'скучные заметки\n' > /home/student/haystack/a/b/f2.txt
run printf 'один из миллиона\n' > /home/student/haystack/a/b/c/f3.txt
run printf 'просто болталка\n' > /home/student/haystack/x/f4.txt
run printf 'здесь ничего\n' > /home/student/haystack/x/y/f5.txt
run printf 'КЛЮЧ: silver-bullet-42\n' > /home/student/haystack/z/hidden.txt
run chown -R student:student /home/student/haystack

hidden hp

settings
  pager on

say "Руками искать — долго. Настало время grep."
read brief.md

stage "Где-то в дереве /home/student/haystack есть строка, начинающаяся с КЛЮЧ: — покажи только её, без имени файла впереди"
  solve grep -rh КЛЮЧ /home/student/haystack
  observe output
  neutral ls cat pwd cd
  on enter say "Шесть файлов в трёх ветках. Руками — можно. Но зачем?"
  hint output "Is a directory" say "grep говорит: это каталог, а не файл. Прочитай его ответ — и подумай, как заставить grep заглянуть во ВСЕ файлы внутри."
  hint cmd grep has -r say "Нашёл! Но впереди — имя файла. Цель — только сама строка. grep --help | grep -i filename — там есть нужный ключ."
  hint tries 3 say "grep умеет искать не только в одном файле. Что ему дать вместо имени файла и какой ключ для этого нужен? Теория подсказывала."
  hint tries 6 say "man grep, раздел «File and Directory Selection». Или загугли: «grep искать строку во всех файлах папки рекурсивно»."
  hint idle 240 say "Перечитай цель: одна строка, без пути к файлу."

exec finale
