# grep-search — рекурсивный поиск: grep -r. Приёмка — по выводу: только строка, без имени файла
# (с обычным -r в выводе есть путь, канон разъезжается; кто хочет -r — сам уберёт имя файла).

image grep-search:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/haystack --seed 190 --depth 4 --dirs 24 --files 60 --lines 20-80
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py plant data/haystack/old/src/notes/export21/draft_2022.txt --line 'КЛЮЧ: silver-bullet-42' --at 0.5
copy data/haystack /home/student/haystack
run chown -R student:student /home/student/haystack

hidden hp

settings
  pager on

say "Иголка в стоге сена? Настало время grep."
read brief.md

stage "Покажи строку с КЛЮЧ: из дерева /home/student/haystack — только её, без имени файла"
  solve grep -rh КЛЮЧ /home/student/haystack
  observe output
  neutral ls cat pwd cd
  on pass say "grep -rn добавит номер строки, grep -ri — забудет про регистр. Попробуй оба на haystack."
  hint output "Is a directory" say "grep: это каталог. Как заставить его зайти внутрь?"
  hint cmd grep has -r say "Нашёл! Но впереди имя файла. grep --help | grep -i filename."
  hint tries 3 say "grep ищет не только в одном файле. Что дать вместо имени?"
  hint tries 6 say "man grep, «File and Directory Selection»."
  hint idle 240 say "Перечитай цель: одна строка, без пути к файлу."

exec finale
