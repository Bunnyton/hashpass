#!/usr/bin/perl
# farm — «ферма» обработчиков для задания про htop и btop: родитель farm и шесть детей
# farm-worker. Пятеро почти ничего не делают, один крутит пустой цикл и ест ядро целиком.
# На SIGTERM родитель сначала гасит детей, потом выходит сам — так ведут себя nginx, gunicorn,
# postgres: остановить всю ферму = остановить родителя.
use strict; use warnings;
$0 = "farm";
my $hog = 4;
my @kids;
for my $n (1 .. 6) {
    my $pid = fork;
    die "farm: fork: $!\n" unless defined $pid;
    if ($pid == 0) {
        $0 = "farm-worker";
        $SIG{TERM} = "DEFAULT";
        if ($n == $hog) { 1 while 1 }
        while (1) { select(undef, undef, undef, 0.5) }
    }
    push @kids, $pid;
}
# остановленный (STOP) ребёнок не получит TERM, пока его не разбудят, — поэтому следом CONT
$SIG{TERM} = sub { kill "TERM", @kids; kill "CONT", @kids; waitpid($_, 0) for @kids; exit 0 };
while (1) { my $pid = wait; last if $pid < 0; }
sleep 3600 while 1;
