# inventory — кладовщик делает опись склада: ls в файл.

image inventory:1

# data: data/warehouse сделан руками один раз (80 позиций) — правь файлы напрямую
copy data/warehouse /home/student/warehouse
run chown -R student:student /home/student/warehouse

hidden hp

settings
  pager on

say "Тебя взяли кладовщиком. Первый день, первое поручение."
read brief.md

stage
  say "Составь опись /home/student/warehouse в файле /home/student/inventory.txt"
  solve ls /home/student/warehouse > /home/student/inventory.txt
  variant ls -1 /home/student/warehouse > /home/student/inventory.txt
  observe /home/student/inventory.txt
  neutral cat less pwd
  on pass say "Стрелка > перезаписывает файл, а >> дописывает. Добавь в опись ещё одну строку через >> и проверь."
  hint tries 3 say "Список на экране есть? Отправь его не на экран, а в файл."
  hint tries 6 say "Загугли: «bash перенаправить вывод команды в файл»."
  hint idle 240 say "Долгая пауза. cat inventory.txt — там список?"

exec finale
