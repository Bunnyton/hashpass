# inventory — кладовщик делает опись склада: ls в файл.

image inventory:1

run mkdir -p /home/student/warehouse
run touch /home/student/warehouse/apples /home/student/warehouse/bread /home/student/warehouse/cheese
run chown -R student:student /home/student/warehouse

hidden hp

settings
  pager on

say "Тебя взяли кладовщиком. Первое поручение — опись."
read brief.md

stage "Составь опись содержимого /home/student/warehouse — список должен лежать в файле /home/student/inventory.txt"
  solve ls /home/student/warehouse > /home/student/inventory.txt
  variant ls -1 /home/student/warehouse > /home/student/inventory.txt
  observe /home/student/inventory.txt
  neutral cat less pwd
  on enter say "Начальник хочет бумажку. То есть файл. Со списком."
  hint tries 3 say "Список на экране у тебя уже есть? Осталось отправить его не на экран, а в файл. Как это делает шелл?"
  hint tries 6 say "Загугли: «bash перенаправить вывод команды в файл». Символ один, и он похож на стрелку."
  hint idle 240 say "Перечитай цель: список содержимого — в файл с указанным именем. Проверь: cat inventory.txt."

exec finale
