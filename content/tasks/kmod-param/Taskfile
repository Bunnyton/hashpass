# kmod-param — параметры модуля: (1) загрузить hello с who=Тук → «Привет, Тук!» в журнале и
# значение в /sys/module/hello/parameters/who; (2) не выгружая, сменить who на Боб через /sys —
# это делается в шелле учебного ядра (kernel), а права 0444 из примера брифа не дают писать:
# «Permission denied» — про права параметра сказано в sys.md (вывод шелла kernel консоль по
# командам не разбирает, hint output там не сработает). Продолжение kmod-hello (учебное ядро оттуда).

image kmod-param:1
from kmod-hello:1

# data: data/kmod — руками: hello из kmod-hello (с паспортом), без параметров
copy data/kmod /home/student/kmod
run chown -R student:student /home/student/kmod
# живые проверки (hpk run в учебном ядре) — только root
copy data/check /usr/local/lib/hpkernel/check
run chmod 700 /usr/local/lib/hpkernel/check /usr/local/lib/hpkernel/check/*

hidden hp

settings
  pager on

say "Модуль, который здоровается только с миром, — скучный модуль. Научим его слушать."
read brief.md

stage
  say "Загрузи hello с параметром who=Тук — пусть в журнале ядра появится «Привет, Тук!»"
  solve:
    cd /home/student/kmod
    printf '%s\n' \
      '#include <linux/module.h>' \
      '#include <linux/init.h>' \
      'MODULE_LICENSE("GPL");' \
      'MODULE_AUTHOR("Студент");' \
      'MODULE_DESCRIPTION("Первый модуль");' \
      'static char *who = "мир";' \
      'module_param(who, charp, 0644);' \
      'MODULE_PARM_DESC(who, "Кого приветствовать");' \
      'static int __init hello_init(void)' \
      '{' \
      '	pr_info("hello: Привет, %s!\n", who);' \
      '	return 0;' \
      '}' \
      'static void __exit hello_exit(void)' \
      '{' \
      '	pr_info("hello: Пока, %s!\n", who);' \
      '}' \
      'module_init(hello_init);' \
      'module_exit(hello_exit);' > hello.c
    make -C /lib/modules/$(ls /lib/modules)/build M=$PWD modules
  accept cmd "dmesg"
  accept cmd "tail"
  accept cmd "grep"
  accept cmd "less"
  accept cmd "head"
  accept cmd "lsmod"
  accept cmd "cat"
  accept cmd "kernel"
  check live /usr/local/lib/hpkernel/check/tuk
  neutral ls pwd cd vim nano make uname modinfo insmod rmmod
  on pass say "modinfo hello.ko теперь покажет строку parm: — так узнают, что умеет чужой модуль."
  hint output "unknown parameter" say "Ядро не знает такого параметра у модуля. Ты пересобрал hello.ko после правки?"
  hint output "File exists" say "Старый hello ещё в ядре — с прежним значением. Сначала выгрузи его."
  hint output "Operation not permitted" say "Загружать модули — дело root. Как одолжить права на одну команду?"
  hint tries 5 say "Что напечатал модуль при загрузке? sudo dmesg | tail."
  hint tries 8 say "Значение параметра пишут после имени файла: insmod файл.ko имя=значение."

stage
  say "Не выгружая модуль, смени who на Боб — пусть /sys/module/hello/parameters/who покажет «Боб»"
  on enter read sys.md
  solve true
  accept cmd "kernel"
  check live /usr/local/lib/hpkernel/check/bob
  neutral ls cat pwd cd less head tail vim nano make lsmod uname modinfo dmesg
  on pass say "Так настраивают драйверы на ходу: например, /sys/module/usbcore/parameters/autosuspend."
  hint output "No such file or directory" say "А модуль сейчас загружен? Каталог в /sys/module живёт, пока модуль в ядре."
  hint tries 5 say "Где ты это делаешь: в консоли или в учебном ядре (kernel)? /sys у них разные."
  hint tries 8 say "Как записать строку в файл, если писать в него может только root? Вспомни tee."

exec finale
