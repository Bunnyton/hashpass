# kmod — свой модуль ядра: от «привет» в dmesg до своего символьного устройства /dev/hashpass.
# Консоль живёт на ядре компьютера ученика, туда модуль не пустят (и не надо): модуль собирается
# под ядро маленькой ВМ QEMU (vm/) и грузится только в ней. Команда vm — ВМ, где ~/kmod видна
# как /mnt; vm --run <скрипт> — то же без шелла, этим пользуются проверки (свежая ВМ каждый раз).
# Ловушка первого шага: make -C /lib/modules/$(uname -r)/build — это ядро компьютера, а не ВМ.
# Решения — здесь, в solve; ученику Taskfile не виден.

image kmod:1

run apt-get update && apt-get install -y --no-install-recommends linux-image-amd64 linux-headers-amd64 build-essential qemu-system-x86 busybox-static cpio xz-utils
copy vm /usr/local/share/vm
run install -m 755 /usr/local/share/vm/vm /usr/local/bin/vm && sh /usr/local/share/vm/mkinitrd
run mkdir -p /home/student/kmod && chown student:student /home/student/kmod

hidden hp

settings
  pager on

say "Ядро — сердце системы: туда не пускают кого попало. Сегодня пустят тебя."
read brief.md

stage
  say "Собери в ~/kmod свой первый модуль — hello.ko"
  solve:
    cd /home/student/kmod
    printf '%s\n' \
      '#include <linux/module.h>' \
      '#include <linux/init.h>' \
      'MODULE_LICENSE("GPL");' \
      'static int __init hello_init(void)' \
      '{' \
      '	pr_info("hello: привет из ядра\n");' \
      '	return 0;' \
      '}' \
      'static void __exit hello_exit(void)' \
      '{' \
      '	pr_info("hello: пока\n");' \
      '}' \
      'module_init(hello_init);' \
      'module_exit(hello_exit);' > hello.c
    echo 'obj-m += hello.o' > Makefile
    make -C /lib/modules/$(ls /lib/modules)/build M=$PWD modules
  observe bool /home/student/kmod/hello.ko
  accept cmd "make" ok
  neutral ls cat pwd cd less head tail vim nano uname
  on pass say "hello.ko — это обычный объектный файл с особой секцией: ядро прочитает из неё, что звать при загрузке."
  hint output "build: No such file or directory" read kernel.md
  hint tries 5 say "Что ответил make? Последние строки его вывода обычно говорят, чего ему не хватило."
  hint tries 8 say "Kbuild собирает то, что перечислено в obj-m, — а имя там без расширения .c?"

stage
  say "Загрузи hello.ko в ядро ВМ, найди его привет в журнале ядра — и выгрузи"
  on enter read vm.md
  solve true
  accept cmd "vm" ok
  check exec check-hello
  neutral ls cat pwd cd less head tail vim nano make
  on pass say "Это сообщение «taints kernel» — не ошибка: ядро просто помечает, что в нём побывал чужой, неподписанный код."
  hint tries 5 say "Что показывает dmesg | tail сразу после insmod?"

stage
  say "Преврати hello в символьное устройство: cat /dev/hashpass в ВМ должен печатать Hello, kernel!"
  on enter read chardev.md
  solve:
    cd /home/student/kmod
    printf '%s\n' \
      '#include <linux/module.h>' \
      '#include <linux/miscdevice.h>' \
      '#include <linux/fs.h>' \
      'MODULE_LICENSE("GPL");' \
      'static const char msg[] = "Hello, kernel!\n";' \
      'static ssize_t hp_read(struct file *f, char __user *buf, size_t n, loff_t *off)' \
      '{' \
      '	return simple_read_from_buffer(buf, n, off, msg, sizeof(msg) - 1);' \
      '}' \
      'static const struct file_operations hp_fops = {' \
      '	.owner = THIS_MODULE,' \
      '	.read = hp_read,' \
      '};' \
      'static struct miscdevice hp_dev = {' \
      '	.minor = MISC_DYNAMIC_MINOR,' \
      '	.name = "hashpass",' \
      '	.fops = &hp_fops,' \
      '	.mode = 0444,' \
      '};' \
      'module_misc_device(hp_dev);' > hello.c
    make -C /lib/modules/$(ls /lib/modules)/build M=$PWD modules
  accept cmd "vm" ok
  check exec check-read
  neutral ls cat pwd cd less head tail vim nano make
  on pass say "Посмотри ls -l /dev/hashpass в ВМ: первая буква c — character device, а 10 — номер драйвера misc."
  hint tries 5 say "Что выдал cat /dev/hashpass в ВМ: ничего, бесконечный поток или ошибку?"
  hint tries 8 say "cat читает, пока read не вернёт 0. Где хранится, сколько уже прочитано?"

stage
  say "А теперь пусть /dev/hashpass запоминает: что в него записали, то cat и вернёт"
  on enter read write.md
  solve:
    cd /home/student/kmod
    printf '%s\n' \
      '#include <linux/module.h>' \
      '#include <linux/miscdevice.h>' \
      '#include <linux/fs.h>' \
      '#include <linux/uaccess.h>' \
      'MODULE_LICENSE("GPL");' \
      'static char msg[256] = "Hello, kernel!\n";' \
      'static size_t len = 15;' \
      'static ssize_t hp_read(struct file *f, char __user *buf, size_t n, loff_t *off)' \
      '{' \
      '	return simple_read_from_buffer(buf, n, off, msg, len);' \
      '}' \
      'static ssize_t hp_write(struct file *f, const char __user *buf, size_t n, loff_t *off)' \
      '{' \
      '	if (n > sizeof(msg))' \
      '		n = sizeof(msg);' \
      '	if (copy_from_user(msg, buf, n))' \
      '		return -EFAULT;' \
      '	len = n;' \
      '	return n;' \
      '}' \
      'static const struct file_operations hp_fops = {' \
      '	.owner = THIS_MODULE,' \
      '	.read = hp_read,' \
      '	.write = hp_write,' \
      '};' \
      'static struct miscdevice hp_dev = {' \
      '	.minor = MISC_DYNAMIC_MINOR,' \
      '	.name = "hashpass",' \
      '	.fops = &hp_fops,' \
      '	.mode = 0666,' \
      '};' \
      'module_misc_device(hp_dev);' > hello.c
    make -C /lib/modules/$(ls /lib/modules)/build M=$PWD modules
  accept cmd "vm" ok
  check exec check-write
  neutral ls cat pwd cd less head tail vim nano make
  on pass say "Ты только что написал драйвер. Настоящие устроены так же — только за read и write у них железо."
  hint tries 5 say "Запиши в ВМ echo abc > /dev/hashpass: что ответил шелл и что потом показал cat?"
  hint tries 8 say "Сколько байт ты вернул из write? Шелл пишет, пока ему не скажут, что всё принято."

exec finale
