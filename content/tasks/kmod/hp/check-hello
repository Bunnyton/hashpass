#!/bin/sh
# Шаг «загрузи в ВМ»: hello.ko грузится в свежее ядро ВМ, пишет в журнал своё и выгружается.
[ -f /home/student/kmod/hello.ko ] || exit 1
cat > /tmp/t.sh <<'T'
#!/bin/sh
dmesg -c >/dev/null
insmod /mnt/hello.ko || exit 0
dmesg | grep -v -e 'taints kernel' -e 'verification failed' | grep -q . && echo @@SAID
rmmod hello && echo @@GONE
T
out=$(sh "$(dirname "$0")/vmrun" /tmp/t.sh)
echo "$out" | grep -q '^@@SAID' && echo "$out" | grep -q '^@@GONE'
