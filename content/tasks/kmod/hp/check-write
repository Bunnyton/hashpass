#!/bin/sh
# Шаг «запись»: в свежей ВМ записанное в /dev/hashpass читается обратно — дважды, второй раз
# короче (длина должна запоминаться), строки каждый раз новые.
[ -f /home/student/kmod/hello.ko ] || exit 1
a="moria-$(date +%s%N)"
b="ok$$"
cat > /tmp/t.sh <<T
#!/bin/sh
insmod /mnt/hello.ko || exit 0
[ -c /dev/hashpass ] || exit 0
echo $a > /dev/hashpass
echo "@@A:\$(timeout 5 head -c 4096 /dev/hashpass)"
echo $b > /dev/hashpass
echo "@@B:\$(timeout 5 head -c 4096 /dev/hashpass)"
T
out=$(sh "$(dirname "$0")/vmrun" /tmp/t.sh)
echo "$out" | grep -qx "@@A:$a" && echo "$out" | grep -qx "@@B:$b"
