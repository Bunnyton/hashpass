#!/bin/sh
# Общая часть проверок: модуль живёт только в ядре ВМ, по файлам консоли его не увидеть. Скрипт
# $1 выполняется в СВЕЖЕЙ ВМ (папка ученика — /mnt); вывод — без \r и escape-кодов консоли.
VM_SHARE=/home/student/kmod timeout 150 vm --run "$1" </dev/null 2>&1 \
    | tr -d '\r' | sed 's/\x1bc//g; s/\x1b\[[0-9;?]*[A-Za-z]//g'
