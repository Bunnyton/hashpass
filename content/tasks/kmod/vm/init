#!/bin/busybox sh
# /init маленькой ВМ: busybox, /proc /sys /dev, папка с хоста в /mnt, потом шелл root.
/bin/busybox --install -s /bin
# Первый процесс — этот скрипт: poweroff/reboot/halt шлют ему сигнал, а он выключает ВМ.
trap 'poweroff -f' USR1 USR2 TERM
mkdir -p /proc /sys /dev /mnt /tmp
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
for m in netfs 9pnet 9pnet_virtio 9p; do insmod /lib/vm/$m.ko; done
mount -t 9p -o trans=virtio,version=9p2000.L host /mnt || echo "vm: папка с хоста не подключилась"
dmesg -n 1
cd /mnt
if [ -x /run.sh ]; then
    /run.sh
else
    echo "Ты в ВМ: ядро $(uname -r), твоя папка — /mnt. Выход — poweroff."
    setsid cttyhack sh -l &
    wait
fi
poweroff -f
