#!/bin/sh
# Собирает initramfs маленькой ВМ: busybox + /init + модули 9p (чтобы видеть папку с хоста).
set -eu
kver=$(ls /lib/modules | head -n 1)
out=/usr/local/share/vm/initrd.gz
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/lib/vm"
cp /bin/busybox "$tmp/bin/busybox"
install -m 755 /usr/local/share/vm/init "$tmp/init"
for m in fs/netfs/netfs net/9p/9pnet net/9p/9pnet_virtio fs/9p/9p; do
    xz -dc "/lib/modules/$kver/kernel/$m.ko.xz" > "$tmp/lib/vm/$(basename "$m").ko"
done
(cd "$tmp" && find . | cpio -o -H newc --quiet | gzip -9) > "$out"
