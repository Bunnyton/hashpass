# links — символьные и жёсткие ссылки (исходники it_bastion: links/25_make_sym, 26_mv_sym,
# 27_another_sym_file, 28_hard — одним заданием). Шаги: ln -s на файл и каталог (+ ls -l) →
# перенос ссылки и попытка прочитать (относительная ломается) → посмотреть на побитую ссылку
# ls -l dir (доза relative.md) → починить её путём от корня → ссылка хранит путь, а не файл:
# починить latest.log, не трогая её: перенести настоящий лог под нужное имя или сделать там ссылку на него → жёсткая ссылка (доза hard.md) → удалить
# оригинал, данные живы.

image links:1

# data: data/home сделан руками: dir/dir/dir/file.txt (текст исходника), notes.txt и логи —
# mkdata.py text --kind notes --seed 303 / --kind log --seed 301, 302
copy data/home /home/student
run ln -s logs/app.log /home/student/latest.log
run chown -R student:student /home/student/dir /home/student/logs /home/student/notes.txt
run chown -h student:student /home/student/latest.log

hidden hp

settings
  pager on
  similarity 100

say "Иногда один файл нужен сразу в нескольких местах."
read brief.md

stage
  say "Сделай символьную ссылку file_link.txt на dir/dir/dir/file.txt, а dir_link — на каталог dir/dir/dir. И посмотри на них через ls -l"
  solve:
    ln -s dir/dir/dir/file.txt /home/student/file_link.txt
    ln -s dir/dir/dir /home/student/dir_link
    ls -l /home/student
  observe /home/student/file_link.txt /home/student/dir_link
  accept cmd "ls -l"
  neutral ls cat pwd cd
  on pass say "Буква l в начале строки и стрелка — это ссылка. Её размер в ls -l — длина записанного пути, а не размер файла."
  hint output "File exists" say "Такое имя уже занято. Посмотри ls -l: может, ссылка уже есть и смотрит не туда?"
  hint tries 5 say "Сначала — на что ссылаемся, потом — как назвать ссылку. Порядок как у cp."
  hint tries 10 say "man ln — ищи слово symbolic."

stage
  say "Перенеси file_link.txt в каталог dir и прочитай файл через неё оттуда"
  solve:
    mv /home/student/file_link.txt /home/student/dir/
    cat /home/student/dir/file_link.txt || true
  observe bool /home/student/dir/file_link.txt /home/student/file_link.txt
  accept cmd "cat"
  neutral ls pwd cd
  on pass say "Ссылка на месте, а файла за ней нет."
  hint tries 5 say "mv — в каталог dir, потом cat уже оттуда: dir/file_link.txt."

stage
  say "Посмотри на побитую ссылку через ls -l dir"
  solve ls -l /home/student/dir
  accept cmd "ls -l"
  accept output "file_link\.txt -> "
  neutral pwd cd cat
  on pass read relative.md
  hint tries 5 say "ls -l и каталог, где теперь лежит ссылка."

stage
  say "Почини file_link.txt: пересоздай её с путём от корня — и прочитай файл через неё"
  solve:
    ln -sf /home/student/dir/dir/dir/file.txt /home/student/dir/file_link.txt
    cat /home/student/dir/file_link.txt
  observe /home/student/dir/file_link.txt
  observe output
  block ln unless "(/home/student|~)/dir/dir/dir/file\.txt" say "Нужен путь от корня: он начинается с / — /home/student/…"
  neutral ls pwd cd
  on pass say "Ссылка с путём от корня переносится куда угодно. Относительная — только вместе со своей целью."
  hint output "File exists" say "Ссылка с таким именем уже есть. Заменить её ln поможет с ключом -f."
  hint cmd ln missing file_link.txt say "Без второго аргумента ln назвал ссылку именем файла. Загляни в ls -l: а чинили мы file_link.txt."
  hint tries 5 say "Сначала — полный путь к файлу от /, потом — имя ссылки в dir. И -f, чтобы заменить старую."

stage
  say "Ссылка latest.log должна показывать последний лог из logs. Почини её, не трогая саму ссылку"
  solve mv /home/student/logs/app-2026-10-12.log /home/student/logs/app.log
  variant ln -s /home/student/logs/app-2026-10-12.log /home/student/logs/app.log
  # принимается любой способ: по пути из latest.log лежит сам лог или ещё одна ссылка на него
  observe /home/student/latest.log
  accept file /home/student/latest.log "^2026-09-24 09:08:32 worker-05 redis\[5593\]"
  block ln match "latest\.log" say "Саму latest.log не трогаем: путь в ней уже верный, не хватает файла по этому пути."
  neutral ls cat pwd cd
  on pass say "Символьная ссылка хранит только путь. Появилось что-то по этому пути — сам лог или ещё одна ссылка — и latest.log ожила, хотя её никто не трогал."
  hint tries 5 say "ls -l latest.log — какой путь записан в ссылке? Есть ли по нему файл?"
  hint tries 10 say "Ссылку не трогаем — значит, нужно, чтобы по её пути появился нужный лог."

stage
  say "Сделай жёсткую ссылку backup.txt на notes.txt"
  solve ln /home/student/notes.txt /home/student/backup.txt
  observe /home/student/notes.txt /home/student/backup.txt
  on enter read hard.md
  neutral ls cat pwd cd
  on pass say "ls -l теперь показывает у notes.txt и backup.txt цифру 2 — столько имён у этого файла."
  hint tries 5 say "Жёсткую ссылку делает тот же ln — только без ключа символьной."

stage
  say "Удали notes.txt и убедись, что записи никуда не делись"
  solve:
    rm /home/student/notes.txt
    cat /home/student/backup.txt
  observe bool /home/student/notes.txt
  observe output
  neutral ls pwd cd
  on pass say "Данные живут, пока у файла есть хоть одно имя. rm удаляет имя, а не файл."
  hint tries 5 say "Удали notes.txt, а потом прочитай backup.txt."

exec finale
