# ls-la — ключи команд и скрытые файлы.
# Приёмка — скрытая проверка по ВЫВОДУ: в нём виден .hidden_key И длинный формат (права).
# Любая форма подходит: ls -la attic, ls -l -a /home/student/attic, ls -al ./attic …
# (`observe output` тут неустойчив: ls -la печатает mtime, а он меняется между проходами.)

image ls-la:1

# data: data/attic сделан руками один раз (25 обычных + 4 скрытых) — правь файлы напрямую
copy data/attic /home/student/attic
run chown -R student:student /home/student/attic

hidden hp

settings
  pager on

say "Не всё, что лежит в каталоге, видно с первого взгляда."
read brief.md

stage
  say "Покажи всё содержимое /home/student/attic, включая скрытое, в длинном формате"
  solve ls -la /home/student/attic
  check exec grade
  neutral cat pwd
  on pass say "Так прячутся конфиги: загляни в ls -a ~ — твои уже там."
  hint cmd ls missing -a say "Список неполный. Чем скрытый файл отличается от обычного?"
  hint tries 3 say "Двадцать пять на виду. А сколько их там на самом деле?"
  hint tries 6 say "man ls — слово hidden. Заодно найди длинный формат."
  hint idle 240 say "Перечитай теорию: там два ключа, и нужны оба."

exec finale
