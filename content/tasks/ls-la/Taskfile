# ls-la — ключи команд и скрытые файлы.
# Задание: увидеть скрытый файл. Приёмка — по команде (учим -la / -a).

image ls-la:1

run mkdir -p /home/student/attic
run printf 'обычный файл\n' > /home/student/attic/normal.txt
run printf 'старый ключ\n' > /home/student/attic/.hidden_key
run chown -R student:student /home/student/attic

hidden hp

settings
  pager on

say "У большинства команд есть ключи. Пара букв — и поведение меняется."
read brief.md

stage "Выведите ВСЕ файлы (включая скрытые) в /home/student/attic"
  # observe output здесь неустойчив: ls -la печатает mtime, а он меняется между
  # проходами канонизации.  Принимаем по факту ВВОДА -la или -a — цель задачи
  # именно в том, чтобы студент выучил флаги, а не поймал строку в файл.
  accept cmd "ls -la /home/student/attic"
  accept cmd "ls -al /home/student/attic"
  accept cmd "ls -a /home/student/attic"
  neutral cat pwd less ls
  on enter say "Ключи -l и -a пишутся слитно (-la), раздельно (-l -a) — как удобно."
  hint tries 2 say "Точно:  ls -la /home/student/attic"
  hint idle 25 say "-l — длинный формат, -a — включая скрытые (те, что с точкой)."

exec finale
