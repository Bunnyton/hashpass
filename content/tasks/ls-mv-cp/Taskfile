# ls-mv-cp — поиск руками и автоматом (исходники docs/Задания «ls_mv_cp (11)» и «grep (12)» —
# одним заданием). Шаг 1: ключ (с фразой) спрятан в одном из файлов четырёх деревьев, а работают только
# cd ls cat mv rm cp (решается и одной командой: cat со звёздочками). Шаг 2: «автоматизируй
# поиск» — ключ перепрятан в случайный файл, каталогов стало четырнадцать, ограничение снято:
# «найди нужную команду сам. Just Google it!». Приёмка обоих шагов — фраза в выводе последней
# команды (скрытая проверка по HP_LAST_OUT).

image ls-mv-cp:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py subdirs data --count 4 --files 3 --seed 251
# data: фраза с ключом key{f2bf3954874ecebd} (исходник) дописана в конец 5-го по порядку файла третьего уровня (subdir_1/…/level3_0J5f/file_B2nJ2l.json)
copy data /home/student
run chown -R student:student /home/student

hidden hp

settings
  pager on

say "Сегодня понадобится терпение."
read brief.md

stage
  say "Найди ключ в файлах subdir_1 … subdir_4 и выведи его на экран"
  solve cat /home/student/subdir_1/level1_2GyK/level2_AB3p/level3_0J5f/file_B2nJ2l.json
  check exec found
  allow cat cp mv rm
  neutral ls cd pwd
  on pass say "Нашёл! Руками, честно — и это всего четыре каталога."
  hint tries 4 say "cat, как и cp, принимает сколько угодно файлов. А звёздочка подставит их имена — хоть на каждом уровне пути."
  hint tries 8 say "Мешает лишнее? То, что уже проверил, можно убрать: rm -rf. И не забывай про Tab."
  hint idle 300 say "Долгая пауза. Перечитай цель и вывод последней команды."

stage
  say "Теперь автоматизируй поиск: ключ перепрятан, а каталогов стало четырнадцать"
  solve grep -r Терпение /home/student
  check exec found
  on enter apply rehide
  on enter say "Команды — всё те же: cd, ls, cat, mv, rm, cp."
  on enter say "Ладно, я же не изверг! Хотя... Тебе доступно неограниченное количество команд. Но придётся самому найти нужные. Just Google it!"
  on pass say "Шестьсот с лишним файлов — одна команда. Вот зачем нужны правильные инструменты."
  hint tries 4 say "Загугли: «linux найти файл по тексту внутри» — первая же ссылка подскажет команду."
  hint tries 8 say "Нашёл команду? Спроси у неё --help: как искать во всех вложенных каталогах сразу?"
  hint idle 300 say "Долгая пауза. Перечитай цель и вывод последней команды."

exec finale
