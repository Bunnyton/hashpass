# ls-mv-cp — обход дерева руками (ls/cd/cat) или grep -r. Приёмка — по выводу (строка phrase:…).

image ls-mv-cp:1

run mkdir -p /home/student/subdir_1/lvl1/lvl2 /home/student/subdir_2/lvl1/lvl2 /home/student/subdir_3/lvl1
run printf 'обычные заметки про кроликов\n' > /home/student/subdir_1/lvl1/notes.txt
run printf 'важные данные\n' > /home/student/subdir_2/lvl1/data.txt
run printf 'кофе-брейк\n' > /home/student/subdir_2/lvl1/lvl2/coffee.txt
run printf 'ничего интересного\n' > /home/student/subdir_3/lvl1/boring.txt
run printf 'Терпение должны иметь мы, пока осядет муть.\nphrase:ветер-в-парусах\n' > /home/student/subdir_2/lvl1/lvl2/prize.txt
run chown -R student:student /home/student/subdir_1 /home/student/subdir_2 /home/student/subdir_3

hidden hp

settings
  pager on

say "Три подвала, в каждом — этажи. Карту не дали."
read brief.md

stage "Где-то в /home/student/subdir_1, subdir_2 или subdir_3 лежит файл со строкой phrase:… — найди и покажи эту строку"
  solve cat /home/student/subdir_2/lvl1/lvl2/prize.txt | grep phrase
  variant grep -rh phrase /home/student/subdir_1 /home/student/subdir_2 /home/student/subdir_3
  observe output
  neutral ls cd pwd
  on enter say "Инструменты: ls, cd, cat. И клавиша Tab, чтобы не набирать имена целиком."
  hint cmd cat say "Файл открыт — а нужная строка внутри? Если да, покажи ТОЛЬКО её. Если нет — ищи дальше."
  hint tries 4 say "Ты обошёл все три subdir до самого дна? В одном из них глубже, чем кажется."
  hint tries 8 say "Обходить руками — честно, но долго. У grep есть ключ для поиска по всем подкаталогам сразу: man grep, слово «recursive»."
  hint idle 300 say "Перечитай цель: показать нужно ТОЛЬКО строку phrase:…, а не весь файл."

exec finale
