# ls-mv-cp — поиск руками и автоматом (исходники docs/Задания «ls_mv_cp (11)» и «grep (12)» —
# одним заданием). Шаг 1: фраза (единственная строка по-русски) каждый раз прячется в новый
# случайный файл четырёх деревьев (on enter apply hide), а работают только
# cd ls cat mv rm cp (решается и одной командой: cat со звёздочками). Шаг 2: «автоматизируй
# поиск» — фраза перепрятана в случайный файл, в ~ появились subdir_5 … subdir_14, ограничение снято:
# «найди нужную команду сам. Just Google it!». Приёмка обоих шагов — фраза в выводе последней
# команды (accept output "Терпение должны иметь мы"); после находки where называет файл.

image ls-mv-cp:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py subdirs data --count 4 --files 3 --seed 251
# data: фразы в данных нет — её прячет hp/hide при входе, каждый раз в новый файл
copy data /home/student
run chown -R student:student /home/student

hidden hp

settings
  pager on

say "Сегодня понадобится терпение."
read brief.md

stage
  say "Найди в файлах subdir_1 … subdir_4 единственную строку по-русски и выведи её на экран"
  solve cat /home/student/subdir_1/level1_2GyK/level2_AB3p/level3_0J5f/file_B2nJ2l.json
  on enter apply hide
  accept output "Терпение должны иметь мы"
  allow cat cp mv rm
  neutral ls cd pwd
  on pass exec where
  on pass say "Руками, честно — и это всего четыре каталога."
  hint tries 5 say "cat, как и cp, принимает сколько угодно файлов. А звёздочка подставит их имена — хоть на каждом уровне пути."
  hint tries 10 say "Мешает лишнее? То, что уже проверил, можно убрать: rm -rf. И не забывай про Tab."

stage
  say "Теперь автоматизируй поиск: фраза перепрятана, а в домашнем каталоге уже subdir_1 … subdir_14"
  solve grep -r Терпение /home/student
  accept output "Терпение должны иметь мы"
  on enter apply rehide
  on enter say "Команды — всё те же: cd, ls, cat, mv, rm, cp."
  on enter say "Ладно, я же не изверг! Хотя... Тебе доступно неограниченное количество команд. Но придётся самому найти нужные. Just Google it!"
  on pass exec where
  on pass say "Шестьсот с лишним файлов — одна команда. Вот зачем нужны правильные инструменты."
  hint tries 5 say "Загугли: «linux найти файл по тексту внутри» — первая же ссылка подскажет команду."
  hint tries 10 say "Нашёл команду? Спроси у неё --help: как искать во всех вложенных каталогах сразу?"

exec finale
