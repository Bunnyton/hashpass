# ls-mv-cp — обход дерева руками (ls/cd/cat) или grep -r. Приёмка — по выводу (строка phrase:…).

image ls-mv-cp:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/subdir_1 --seed 221 --depth 3 --dirs 7 --files 26 --lines 3-25 --plant lvl1/lvl2/ --plant 'lvl1/notes.txt=обычные заметки про кроликов'
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/subdir_2 --seed 222 --depth 3 --dirs 8 --files 30 --lines 3-25 --plant 'lvl1/data.txt=важные данные' --plant 'lvl1/lvl2/coffee.txt=кофе-брейк' --plant 'lvl1/lvl2/prize.txt=Терпение должны иметь мы, пока осядет муть.'
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py plant data/subdir_2/lvl1/lvl2/prize.txt --line 'phrase:ветер-в-парусах' --at 2
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/subdir_3 --seed 223 --depth 3 --dirs 6 --files 22 --lines 3-25 --plant lvl1/lvl2/ --plant 'lvl1/boring.txt=ничего интересного'
copy data/subdir_1 /home/student/subdir_1
copy data/subdir_2 /home/student/subdir_2
copy data/subdir_3 /home/student/subdir_3
run chown -R student:student /home/student/subdir_1 /home/student/subdir_2 /home/student/subdir_3

hidden hp

settings
  pager on

say "Три подвала, в каждом — этажи. Карту не дали."
read brief.md

stage
  say "Найди в /home/student/subdir_1, subdir_2 или subdir_3 строку phrase:… и покажи только её"
  solve cat /home/student/subdir_2/lvl1/lvl2/prize.txt | grep phrase
  variant grep -rh phrase /home/student/subdir_1 /home/student/subdir_2 /home/student/subdir_3
  observe output
  neutral ls cd pwd
  on pass say "На дне подвала набери pwd, а потом cd без аргументов — и ты сразу дома."
  hint cmd cat say "Файл открыт — покажи только нужную строку."
  hint tries 4 say "Все три subdir до самого дна?"
  hint tries 8 say "У grep есть ключ для поиска по всем подкаталогам."
  hint idle 300 say "Долгая пауза. Перечитай цель и вывод последней команды."

exec finale
