# ls-mv-cp — обход дерева ограниченным набором: в консоли работают только ls, cd, cat, cp, mv, rm
# (+ pwd). Ключ спрятан в одном из ~50 коротких файлов четырёх деревьев. Руками — долго; смысл
# задания — увидеть, что всё нужное уже пройдено: cat принимает много файлов, а * стоит в любом
# уровне пути — и хватает одной команды. Приёмка — скрытая проверка по выводу последней команды
# (HP_LAST_OUT): ключ показан на экране.

image ls-mv-cp:1

# data: for i in 1 2 3 4; do python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/subdir_$i --seed 23$i --depth 3 --dirs 5 --files 12 --lines 1-2; done
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py plant data/subdir_3/staging_2022/reports6/photo.cfg --line '«Терпение должны иметь мы, пока осядет муть и вода чистой станет» key{f2bf3954874ecebd}' --at 1
copy data/subdir_1 /home/student/subdir_1
copy data/subdir_2 /home/student/subdir_2
copy data/subdir_3 /home/student/subdir_3
copy data/subdir_4 /home/student/subdir_4
run chown -R student:student /home/student/subdir_1 /home/student/subdir_2 /home/student/subdir_3 /home/student/subdir_4

hidden hp

settings
  pager on

say "Четыре подвала, в каждом — этажи. Карту не дали, инструментов — шесть."
read brief.md

stage
  say "Найди ключ к следующему заданию — он в одном из файлов /home/student/subdir_1 … subdir_4"
  solve cat /home/student/subdir_3/staging_2022/reports6/photo.cfg
  check exec grade
  allow cat cp mv rm
  neutral ls cd pwd
  on pass say "Сорок восемь файлов — одна команда: звёздочка на каждом уровне пути, cat subdir_*/*/*/*. Руками ушло бы минут десять."
  hint tries 4 say "Файлов десятки. Открывать по одному долго — а сколько файлов cat берёт за раз?"
  hint tries 8 say "Перечитай в брифе, где ещё может стоять звёздочка."
  hint idle 300 say "Долгая пауза. Перечитай цель и вывод последней команды."

exec finale
