# ls-mv-cp — комбинированный обход дерева ограниченным набором команд.
# Задание: найти секретную фразу в одном из файлов и записать её.

image ls-mv-cp:1

run mkdir -p /home/student/subdir_1/lvl1/lvl2 /home/student/subdir_2/lvl1/lvl2 /home/student/subdir_3/lvl1
run printf 'обычные заметки про кроликов\n' > /home/student/subdir_1/lvl1/notes.txt
run printf 'важные данные\n' > /home/student/subdir_2/lvl1/data.txt
run printf 'кофе-брейк\n' > /home/student/subdir_2/lvl1/lvl2/coffee.txt
run printf 'ничего интересного\n' > /home/student/subdir_3/lvl1/boring.txt
run printf 'Терпение должны иметь мы, пока осядет муть.\nphrase:ветер-в-парусах\n' > /home/student/subdir_2/lvl1/lvl2/prize.txt
run chown -R student:student /home/student/subdir_1 /home/student/subdir_2 /home/student/subdir_3

hidden hp

settings
  pager on

say "Ограниченный набор команд. Задача — обход дерева руками."
read brief.md

stage "Найдите строку phrase:... в одном из файлов и запишите её в /home/student/found.txt"
  solve cat /home/student/subdir_2/lvl1/lvl2/prize.txt | grep phrase > /home/student/found.txt
  variant:
    grep -r phrase /home/student/subdir_1 /home/student/subdir_2 /home/student/subdir_3 > /tmp/g.txt
    cat /tmp/g.txt | awk -F: '{print $2":"$3}' | head -1 > /home/student/found.txt
  observe /home/student/found.txt
  neutral ls cat pwd cd
  on enter say "Обход руками: ls / cd / cat. Или grep — если совсем невмоготу."
  hint tries 2 say "Пройдитесь по subdir_1/2/3, найдите файл с phrase: и cat > нужный файл."
  hint idle 30 say "Tab-дополнение — ваш союзник. Ищите файл, где встречается слово phrase."

exec finale
