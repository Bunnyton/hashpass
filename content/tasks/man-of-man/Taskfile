# man-of-man — знакомство с man.
# Задание: запустить  man man  — и убедиться, что man может заглянуть в самого себя.

image man-of-man:1

# man-db не входит в базовый образ (там строго systemd + bash + procps + sudo — всё остальное
# задачи ставят сами, где это уместно).  Здесь без man нельзя: студент печатает `man man`,
# и терминал должен показать страницу руководства, а не «command not found».
run apt-get update >/dev/null 2>&1
run DEBIAN_FRONTEND=noninteractive apt-get install -y man-db >/dev/null 2>&1

hidden hp

settings
  pager on

say "У всякой команды есть большая справка. Открывается — командой man."
read brief.md

stage "Откройте страницу руководства самой команды man — наберите  man man"
  accept cmd "man man"
  neutral ls cat pwd
  on enter say "Если man — команда, то может ли она заглянуть внутрь самой себя?"
  hint tries 2 say "Наберите:  man man"
  hint idle 25 say "Выход из man — клавиша q."

exec finale
