# mc — Midnight Commander (исходник it_bastion: base_commands/50_mc «найдите в случайных текстовых
# файлах пароль; вам теперь доступен midnight commander»). Пароль от Wi-Fi спрятан в одном из
# сорока пяти файлов notes/ (data/). Из команд доступны только mc и mcedit: найти (поиск по содержимому) и
# записать ответ в ~/answer.txt его редактором; принимается содержимое answer.txt (observe).
# После находки where называет файл.

image mc:1

run apt-get update >/dev/null 2>&1
run DEBIAN_FRONTEND=noninteractive apt-get install -y mc >/dev/null 2>&1
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/notes --seed 50 --depth 4 --dirs 14 --files 45 --kind notes --lines 15-40
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py plant data/notes/drafts/photos38/staging_2021/index35.csv --line "пароль от wi-fi в переговорке: walrus-6610" --at 0.6
copy data /home/student
run chown -R student:student /home/student/notes

hidden hp

settings
  pager on

say "Сорок пять файлов заметок, и где-то среди них — пароль от Wi-Fi."
read brief.md

stage
  say "Найди в notes пароль от Wi-Fi и запиши его в ~/answer.txt. Из команд у тебя только mc и mcedit"
  solve echo walrus-6610 > /home/student/answer.txt
  observe /home/student/answer.txt
  allow mc mcedit
  neutral ls cd pwd
  on pass exec where
  hint tries 5 say "Открывать файлы по одному долго. mc умеет искать по содержимому: Alt+? — поле Content."
  hint tries 10 say "Новый файл — Shift+F4 или mcedit answer.txt в строке внизу mc; сохранить — F2."

exec finale
