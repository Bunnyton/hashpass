#!/bin/sh
# Каждый раз — новый пароль в новом случайном файле notes/ (выполняется в живой системе, apply).
# Ожидаемый пароль — в /var/lib/hp-mc/pass (только root): по нему проверка.
cd /home/student/notes || exit 0
for f in $(grep -rl 'пароль от wi-fi' . 2>/dev/null); do sed -i '/пароль от wi-fi/d' "$f"; done
r=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
set -- cactus penguin samovar bagel hedgehog teapot walrus pretzel
shift $((r % 8)); word=$1
pass="$word-$(( (r / 8) % 9000 + 1000 ))"
f=$(find . -type f | awk -v r="$r" '{a[NR]=$0} END{print a[int(r / 7) % NR + 1]}')
n=$(wc -l < "$f"); at=$(( r % (n > 0 ? n : 1) + 1 ))
sed -i "$at a пароль от wi-fi в переговорке: $pass" "$f"
chown student:student "$f"
mkdir -p -m 700 /var/lib/hp-mc && printf '%s\n' "$pass" > /var/lib/hp-mc/pass
exit 0
