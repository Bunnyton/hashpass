# mv-basics — mv (исходник docs/Задания «mv (9)»): сначала перенести всё содержимое dir в ТЕКУЩУЮ
# директорию (понятия «текущая» и «.»), потом «переименуй file5 в file2. Думай!» — что mv
# переименовывает, студент догадывается сам. Награда и финал — сам file2: Скала с бровью и текст
# про расширения (затравка — после первого шага: у файлов нет расширений).

image mv-basics:1

# data: data/dir/file5 — картинка meme.py render https://i.imgflip.com/5tyc0u.png --width 60
# («The Rock eyebrow») + текст исходника про расширения под ней; текст правь прямо в файле;
# остальные — mkdata (ниже)
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/dir/file1 --kind prose --lines 12 --seed 230
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/dir/file3 --kind prose --lines 15 --seed 231
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/dir/file4 --kind prose --lines 18 --seed 232
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/dir/file6 --kind prose --lines 21 --seed 233
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/dir/file7 --kind prose --lines 24 --seed 234
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/dir/file8 --kind prose --lines 27 --seed 235
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/dir/file9 --kind prose --lines 30 --seed 236
copy data/dir /home/student/dir
run chown -R student:student /home/student/dir

hidden hp

settings
  pager on

say "cp — copy, mv — move."
read brief.md

stage
  say "Перенеси всё содержимое директории dir в текущую"
  solve mv /home/student/dir/file1 /home/student/dir/file3 /home/student/dir/file4 /home/student/dir/file5 /home/student/dir/file6 /home/student/dir/file7 /home/student/dir/file8 /home/student/dir/file9 /home/student/
  check exec moved
  neutral ls cat pwd cd
  on pass say "dir опустел, всё здесь. Заметил? Ни у одного файла нет расширения — ни .txt, ни .doc. Странно…"
  hint output "No such file or directory" say "Чего mv не нашёл? Сверь имя с ls."
  hint cmd cp say "Это копия: в dir всё осталось. Нужен перенос."
  hint tries 3 say "Где ты сейчас? pwd скажет. Как назвать «сюда» в пути — сказано в теории."
  hint tries 6 say "Файлов много — вспомни звёздочку из уроков про cp."
  hint idle 240 say "Долгая пауза. Перечитай цель и вывод последней команды."

stage
  say "Теперь переименуй file5 в file2. Думай. Думай!"
  solve mv /home/student/file5 /home/student/file2
  observe /home/student/file2
  observe bool /home/student/file5
  neutral ls cat pwd cd
  on pass exec cat /home/student/file2
  hint cmd cp say "Теперь файлов два, а нужен один — с новым именем."
  hint tries 3 say "Какая команда меняет у файла место? А имя — не часть ли его места?"
  hint tries 6 say "man mv — первые строки DESCRIPTION."
  hint idle 240 say "Долгая пауза. Думай. Думай!"

