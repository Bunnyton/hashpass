# mv-basics — перемещение и переименование. Наблюдаем новое имя И отсутствие старого:
# cp вместо mv не проходит.

image mv-basics:1

# data: data/workspace/file5 — руками; остальные — mkdata (ниже)
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/workspace/file1 --kind prose --lines 12 --seed 230
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/workspace/file3 --kind prose --lines 15 --seed 231
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/workspace/file4 --kind prose --lines 18 --seed 232
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/workspace/file6 --kind prose --lines 21 --seed 233
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/workspace/file7 --kind prose --lines 24 --seed 234
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/workspace/file8 --kind prose --lines 27 --seed 235
# data: python3 .claude/skills/task-authoring/scripts/mkdata.py text data/workspace/file9 --kind prose --lines 30 --seed 236
copy data/workspace /home/student/workspace
run chown -R student:student /home/student/workspace

hidden hp

settings
  pager on

say "cp — copy, mv — move. А ещё mv умеет то, о чём не говорит его имя."
read brief.md

stage "В /home/student/workspace файл file5 должен называться file2"
  solve mv /home/student/workspace/file5 /home/student/workspace/file2
  observe /home/student/workspace/file2
  observe bool /home/student/workspace/file5
  neutral ls cat pwd
  on enter say "Кто-то перепутал цифру. Содержимое верное — имя нет."
  on pass say "mv переименовывает и каталоги, и сразу несколько файлов в другой каталог. Перенеси file2 в новый каталог done."
  hint output "No such file or directory" say "Какой файл не нашёлся? Сверь имя с ls."
  hint cmd cp say "Теперь файлов два, а нужен один с новым именем."
  hint tries 3 say "Переименование — это перемещение на новое имя."
  hint tries 6 say "man mv — второй абзац DESCRIPTION."
  hint idle 240 say "Перечитай цель: старое имя, новое имя, один каталог."

exec finale
