#!/bin/sh
# Шаг 1: counter запускается из любого каталога и печатает одно число, каждый раз на 1 больше.
# Проверка идёт на копии системы — счётчик студента после неё не меняется.
run=$(dirname "$0")/run-counter
a=$("$run")
printf '%s\n' "$a" | grep -Eqx '[0-9]+' || exit 1
for i in 1 2 3; do
  [ "$("$run")" = "$((a + i))" ] || exit 1
done
