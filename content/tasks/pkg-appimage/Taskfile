# pkg-appimage — «один файл на любой Linux»: «смотри готовый — собери так же». В ~/appimage при сборке
# образа собран образец: data/Hello.AppDir → Hello-x86_64.AppImage. (1) запустить его и распаковать
# (--appimage-extract → squashfs-root: AppRun, .desktop, иконка, usr/bin); (2) Pelmeni.AppDir по
# образцу → appimagetool → Pelmeni-x86_64.AppImage --version. appimagetool и runtime скачаны в pkg-deb
# (/opt/appimage); обёртка подставляет runtime. Образ и ~/pelmeni — из pkg-deb.

image pkg-appimage:1
from pkg-deb:1

# fusermount — чтобы AppImage монтировал себя сам (FUSE)
run apt-get update >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends fuse3 >/dev/null 2>&1
run printf '#!/bin/sh\n# appimagetool с заранее скачанным runtime (иначе он полез бы за ним в GitHub)\nexport ARCH=${ARCH:-x86_64}\nexec /opt/appimage/appimagetool --appimage-extract-and-run --runtime-file /opt/appimage/runtime-x86_64 "$@"\n' > /usr/local/bin/appimagetool && chmod 755 /usr/local/bin/appimagetool
# data: data/Hello.AppDir — руками: образец AppDir, его упаковывают здесь же
copy data/Hello.AppDir /home/student/appimage/Hello.AppDir
run chown -R student:student /home/student/appimage
run runuser -u student -- sh -c 'cd /home/student/appimage && HOME=/home/student appimagetool Hello.AppDir >/dev/null 2>&1 && rm -rf squashfs-root'
run test -x /home/student/appimage/Hello-x86_64.AppImage

hidden hp

settings
  pager on

say "Пакеты для каждого дистрибутива — это много работы. А можно один файл, который запустится везде?"
read brief.md

stage
  say "Запусти образец ~/appimage/Hello-x86_64.AppImage и распакуй его — посмотри, что внутри"
  solve:
    cd /home/student/appimage
    ./Hello-x86_64.AppImage
    ./Hello-x86_64.AppImage --appimage-extract
  check exec extracted
  neutral ls cat pwd cd less head tail tree file
  on pass say "Внутри — тот же Hello.AppDir, что лежит рядом: AppRun, .desktop, иконка и usr/bin. Это и есть рецепт."
  hint tries 5 say "Как распаковать AppImage — в теории: ключ у самого файла."

stage
  say "Собери так же Pelmeni-x86_64.AppImage и запусти его с --version"
  solve:
    cd /home/student
    mkdir -p Pelmeni.AppDir/usr/bin
    cp pelmeni/pelmeni Pelmeni.AppDir/usr/bin/
    cp pelmeni/pelmeni.desktop pelmeni/pelmeni.svg Pelmeni.AppDir/
    sed 's/hello/pelmeni/' appimage/Hello.AppDir/AppRun > Pelmeni.AppDir/AppRun
    chmod 755 Pelmeni.AppDir/AppRun
    appimagetool Pelmeni.AppDir
    ./Pelmeni-x86_64.AppImage --version
  accept cmd "Pelmeni-x86_64.AppImage --version" ok
  check exec built
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file chmod
  on pass say "Так раздают Krita, Inkscape и Obsidian: один файл, а внутри — свой маленький корень."
  hint output "AppRun" read apprun.md
  hint output "Desktop file not found" say "В корне AppDir должен лежать .desktop-файл — как у образца. В ~/pelmeni такой есть."
  hint output "icon" say "Иконка ищется в корне AppDir по имени из строки Icon= в .desktop — с расширением .png или .svg."
  hint output "Permission denied" say "AppImage — программа: ему нужен бит исполнения."
  hint tries 5 say "Сравни свой AppDir с образцом: ls -R. Чего не хватает?"
  hint tries 8 say "Имя файла appimagetool берёт из Name= в .desktop и архитектуры. Что у тебя получилось? ls."

exec finale
