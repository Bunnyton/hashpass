# pkg-arch — пакет для Arch Linux: «смотри готовый — собери так же». В ~/arch-hello при сборке образа
# собран образец (data/hello-1.0 + data/PKGBUILD → hello-1.0-1-any.pkg.tar.gz; сумма вписана тогда же).
# (1) заглянуть в пакет pacman-ом (-Qip/-Qlp); (2) pelmeni 1.0 по образцу в своём каталоге:
# естественная ошибка — сумма от hello («FAILED» → доза sums.md: makepkg -g); (3) поставить свой
# пакет pacman -U. В Debian есть и makepkg, и pacman (с пустой базой). Образ и ~/pelmeni — из pkg-deb.

image pkg-arch:1
from pkg-deb:1

# makepkg без бинаря pacman падает с «unknown error» (type -P pacman под trap ERR); база pacman пустая
run apt-get update >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends pacman-package-manager >/dev/null 2>&1
# база pacman создаётся при первом обращении root-а — иначе pacman -Qp у студента: «could not create database»
run mkdir -p /var/lib/pacman && pacman -Q >/dev/null 2>&1; test -d /var/lib/pacman/local
# data: data/hello-1.0, data/PKGBUILD — руками: образец пакета, его собирают здесь же
copy data/hello-1.0 /home/student/arch-hello/hello-1.0
copy data/PKGBUILD /home/student/arch-hello/PKGBUILD
run chown -R student:student /home/student/arch-hello
run runuser -u student -- sh -c 'cd /home/student/arch-hello && tar czf hello-1.0.tar.gz hello-1.0 && rm -rf hello-1.0 && sed -i "s/SUM/$(sha256sum hello-1.0.tar.gz | cut -d" " -f1)/" PKGBUILD && HOME=/home/student makepkg >/dev/null 2>&1 && rm -rf src pkg'
run test -f /home/student/arch-hello/hello-1.0-1-any.pkg.tar.gz

hidden hp

settings
  pager on

say "Arch Linux собирает пакеты одним коротким скриптом. Короче рецепта не бывает."
read brief.md

stage
  say "Загляни в готовый пакет из ~/arch-hello: что о нём сказано и какие файлы он ставит"
  solve:
    pacman -Qilp /home/student/arch-hello/hello-1.0-1-any.pkg.tar.gz
  accept cmd "pacman"
  accept output "/usr/bin/hello"
  neutral ls cat pwd cd less head tail tree file bsdtar
  on pass say "Рецепт этого пакета — ~/arch-hello/PKGBUILD. Прочитай: следующий шаг по нему."
  hint output "was not found" say "pacman -Q спрашивает базу установленных пакетов. Чтобы спросить файл, нужен ещё ключ — в теории."
  hint tries 5 say "Как спросить у файла пакета его паспорт и список файлов — в теории."

stage
  say "Собери так же свой пакет pelmeni 1.0 — makepkg должен выдать pelmeni-1.0-1-any.pkg.tar"
  solve:
    mkdir -p /home/student/arch
    cd /home/student
    cp -r pelmeni pelmeni-1.0
    tar czf arch/pelmeni-1.0.tar.gz pelmeni-1.0
    rm -rf pelmeni-1.0
    cd arch
    sed 's/^pkgname=.*/pkgname=pelmeni/; s/^pkgdesc=.*/pkgdesc="Сколько варить и сколько кидать"/; /^sha256sums=/d' ../arch-hello/PKGBUILD > PKGBUILD
    makepkg -g >> PKGBUILD
    makepkg
  check exec pkg 1.0-1
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file tar bsdtar
  on pass say "Внутри пакета — .PKGINFO с паспортом: bsdtar -xOf файл .PKGINFO."
  hint output "FAILED" read sums.md
  hint output "Integrity checks" read sums.md
  hint output "was not found in the build directory" say "makepkg не нашёл исходник. Лежит ли тарбол рядом с PKGBUILD под тем именем, что в source?"
  hint output "Running makepkg as root is not allowed" say "makepkg принципиально не работает от root: сборка не должна трогать систему. Запусти без sudo."
  hint output "cd: pelmeni-1.0: No such file" say "package() заходит в каталог из распакованного тарбола. Какой каталог внутри? tar tzf."
  hint output "already been built" say "Пакет уже собран — он рядом с PKGBUILD. Пересобрать поверх — makepkg -f."
  hint tries 5 say "Что makepkg сказал последним? Строки с ==> ERROR: — главное."
  hint tries 8 say "Готовый пакет makepkg кладёт рядом с PKGBUILD. Что там появилось?"

stage
  say "Поставь свой пакет так, как это сделали бы в Arch, — pacman-ом, и запусти pelmeni"
  on enter read pacman.md
  solve:
    cd /home/student/arch
    sudo pacman -U --noconfirm pelmeni-1.0-1-any.pkg.tar.gz
    pelmeni
  check exec pacman
  accept cmd "pelmeni" ok
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file tar bsdtar
  on pass say "pacman -Ql pelmeni — его файлы, pacman -Qi pelmeni — паспорт, sudo pacman -R pelmeni — убрать."
  hint output "you cannot perform this operation unless you are root" say "Ставить пакеты — дело root."
  hint output "failed to init transaction" say "pacman не смог занять свою базу. Ставить пакеты — дело root."
  hint tries 5 say "Что ответил pacman последней строкой? error: — главное."

exec finale
