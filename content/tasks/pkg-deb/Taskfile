# pkg-deb — .deb: «смотри, как устроен готовый — собери так же». (1) apt download sl + dpkg-deb -R:
# дерево и DEBIAN/control настоящего пакета; (2) по образцу — pelmeni 1.0 (all) с /usr/bin/pelmeni
# и Depends: figlet (pelmeni рисует заголовок figlet-ом, если он есть); (3) apt install ./… и запуск.
# Образ — база всего блока «Сборка пакетов»: все сборщики стоят (figlet — нет, это нарочно);
# остальные pkg-* — from pkg-deb:1, исходники pelmeni берут из ~/pelmeni.

image pkg-deb:1

run apt-get update >/dev/null 2>&1
run DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends build-essential dpkg-dev debhelper devscripts lintian fakeroot rpm makepkg libarchive-tools zstd squashfs-tools snapd file desktop-file-utils wget xz-utils man-db >/dev/null 2>&1
run ! dpkg -s figlet >/dev/null 2>&1
# appimagetool и его runtime — для pkg-appimage (здесь, чтобы все сборщики жили в одной базе)
run mkdir -p /opt/appimage && wget -q -O /opt/appimage/appimagetool https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage && wget -q -O /opt/appimage/runtime-x86_64 https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-x86_64 && chmod 755 /opt/appimage/appimagetool
# data: data/pelmeni — руками: программа-скрипт, man, иконка, .desktop, Makefile с DESTDIR
copy data/pelmeni /home/student/pelmeni
run chown -R student:student /home/student/pelmeni

hidden hp

settings
  pager on

say "Программа pelmeni готова и даже работает. Осталось, чтобы её можно было поставить одной командой."
read brief.md

stage
  say "Скачай пакет sl и разложи его в каталог вместе с паспортом — посмотри, из чего он сделан"
  solve:
    cd /home/student
    apt download sl
    dpkg-deb -R sl_*.deb sl-tree
  check exec explored
  neutral ls cat pwd cd less head tail vim nano tree file
  on pass say "Заметил строку Depends в паспорте sl? Это то, что apt доставит вместе с пакетом сам."
  hint output "Unable to locate package" say "apt не знает такого пакета — список пакетов устарел? Кто его обновляет?"
  hint tries 5 say "Как разложить .deb в каталог вместе с паспортом — в теории, третья команда."
  hint tries 8 say "dpkg -x тоже распаковывает, но без паспорта DEBIAN/ — а он здесь главное."

stage
  say "Собери так же свой пакет pelmeni 1.0: программа — в /usr/bin, а figlet пусть apt ставит вместе с ним"
  solve:
    cd /home/student
    mkdir -p pkg/DEBIAN pkg/usr/bin
    cp pelmeni/pelmeni pkg/usr/bin/
    printf '%s\n' 'Package: pelmeni' 'Version: 1.0' 'Architecture: all' 'Depends: figlet' 'Maintainer: Student <student@example.com>' 'Description: сколько варить и сколько кидать' > pkg/DEBIAN/control
    dpkg-deb --root-owner-group --build pkg pelmeni_1.0_all.deb
  check exec built
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file
  on pass say "dpkg-deb -I pelmeni_1.0_all.deb — у твоего пакета теперь такой же паспорт, как у sl."
  hint output "failed to open package info file" read control.md
  hint output "missing 'Package' field" read control.md
  hint output "missing 'Maintainer' field" read control.md
  hint output "missing 'Description' field" read control.md
  hint output "missing 'Architecture' field" read control.md
  hint output "bad permissions" say "dpkg-deb требует, чтобы каталог DEBIAN был 0755 — не больше и не меньше. chmod поможет."
  hint tries 5 say "Сравни со своим разложенным sl: где лежит паспорт, где программа? dpkg-deb -c твой.deb."
  hint tries 8 say "Зависимость пишется в паспорте той же строкой, что у sl, — Depends."

stage
  say "Поставь свой пакет и запусти pelmeni 2"
  solve:
    cd /home/student
    sudo apt-get install -y ./pelmeni_1.0_all.deb
    pelmeni 2
  check exec installed
  accept cmd "pelmeni" ok
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file
  on pass say "apt show pelmeni — твой пакет в одном ряду со всеми, а sudo apt remove pelmeni уберёт его так же чисто."
  hint output "Could not open lock file" say "Ставить пакеты — дело root."
  hint output "Unable to locate package" say "apt ищет пакет с таким именем в репозиториях. Как сказать ему, что это файл рядом? Путь начинается с ./"
  hint output "dependency problems" say "dpkg ставит только этот файл, зависимости — не его забота. Кто их умеет доставать из репозитория?"
  hint tries 5 say "Пакет стоит? dpkg -l pelmeni. Что ответила сама программа?"

exec finale
