# pkg-debsrc — пакет «по-дебиановски»: исходники + каталог debian/ + dpkg-buildpackage (debhelper).
# «Смотри, как сделано у настоящего — сделай так же»: (1) apt-get source sl (в образе включены
# deb-src) и найти в его debian/rules, чем он собирается (dh $@ — debhelper делает всё сам);
# (2) для pelmeni: dh_make -n (заготовка debian/ одной командой) + dpkg-buildpackage -us -uc -b.
# Makefile pelmeni ставит в PREFIX=/usr (иначе dh_usrlocal). Образ и ~/pelmeni — из pkg-deb.

image pkg-debsrc:1
from pkg-deb:1

# исходники пакетов (apt-get source) и dh_make — заготовка каталога debian/
run sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources && grep -q deb-src /etc/apt/sources.list.d/debian.sources
run apt-get update >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends dh-make >/dev/null 2>&1

hidden hp

settings
  pager on

say "Руками собранный .deb — самоделка. Пакеты для настоящего репозитория Debian собирают иначе."
read brief.md

stage
  say "Скачай исходники пакета sl и найди в них, какой командой он собирается"
  solve:
    cd /home/student
    apt-get source sl
    cat sl-*/debian/rules
  check exec srcs
  accept output "dh \$@"
  neutral ls pwd cd tree file
  on pass say "Вся сборка sl — одна строка dh $@: debhelper сам знает, что делать с Makefile, куда класть файлы и как упаковать."
  hint output "You must put some 'deb-src' URIs" say "apt не знает, где брать исходники. Здесь они уже подключены — список пакетов свежий?"
  hint tries 5 say "Рецепт сборки лежит в каталоге debian/ внутри исходников. Какой файл в нём отвечает за сборку — в теории."
  hint tries 8 say "debian/rules — обычный текстовый файл, cat его покажет."

stage
  say "Сделай так же для pelmeni: каталог debian/ — и пакет через dpkg-buildpackage"
  solve:
    cd /home/student/pelmeni
    DEBFULLNAME=Student DEBEMAIL=student@example.com dh_make -n -s -y -p pelmeni_1.0
    dpkg-buildpackage -us -uc -b
  check exec built
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file
  on pass say "Рядом с .deb легли .buildinfo и .changes: с чем собирали и что выкладывать в репозиторий. Для настоящего выпуска в debian/control и debian/changelog ещё дописывают описание и историю."
  hint output "No secret key" say "dpkg-buildpackage хочет подписать результат твоим ключом. Для своей сборки подпись не нужна — ключи в теории."
  hint output "unmet build dependencies" say "dpkg-buildpackage проверяет Build-Depends. Что из перечисленного там не установлено?"
  hint output "Could not find" say "dh_make хочет знать имя и версию: каталог pelmeni-1.0 или ключ -p имя_версия."
  hint output "debian/ already exists" say "debian/ уже есть — второй раз заготовка не нужна. Собирай."
  hint tries 5 say "Что dpkg-buildpackage сказал последним? Ошибка обычно в самом низу."
  hint tries 8 say "Готовый пакет dpkg-buildpackage кладёт на уровень выше каталога исходников. Что там?"

exec finale
