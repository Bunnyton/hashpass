#!/bin/sh
# check-deb <версия>: dpkg-buildpackage собрал pelmeni этой версии — рядом с .deb лежит
# .buildinfo (его делает только dpkg-buildpackage), программа в /usr/bin, Depends — figlet.
v=$1
for f in $(find /home/student -name "pelmeni_${v}_all.deb" 2>/dev/null); do
    [ -f "${f%_all.deb}_amd64.buildinfo" ] || [ -f "${f%_all.deb}_all.buildinfo" ] || continue
    [ "$(dpkg-deb -f "$f" Version)" = "$v" ] || continue
    dpkg-deb -f "$f" Depends | grep -qw figlet || continue
    dpkg-deb -c "$f" | grep -Eq '^-rwx.* \./usr/bin/pelmeni$' && exit 0
done
exit 1
