# pkg-flatpak — flatpak: приложение = metadata + files/ (внутри песочницы — /app) поверх runtime.
# «Смотри готовый — собери так же». flatpak-builder и flatpak run в консоли не работают: им нужен bwrap,
# а он в контейнере не монтирует /proc; runtime/SDK — гигабайты из сети. Поэтому собираем, как
# flatpak-builder в конце: metadata руками (build-init требует SDK), build-finish --command,
# build-export в репозиторий ostree, build-bundle в один файл. В ~/flatpak при сборке образа собран
# образец org.example.Hello (data/hello-app → hello.flatpak). (1) заглянуть в образец (metadata, files/);
# (2) pelmeni.flatpak по образцу. Проверка импортирует бандл во временный репозиторий, достаёт его
# (ostree checkout) и запускает с /app → распакованный files/. Образ и ~/pelmeni — из pkg-deb.

image pkg-flatpak:1
from pkg-deb:1

run apt-get update >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends flatpak ostree >/dev/null 2>&1
# data: data/hello-app — руками: образец приложения, его упаковывают здесь же
copy data/hello-app /home/student/flatpak/hello-app
run chown -R student:student /home/student/flatpak
run runuser -u student -- sh -c 'cd /home/student/flatpak && flatpak build-finish hello-app --command=hello >/dev/null 2>&1 && flatpak build-export repo hello-app >/dev/null 2>&1 && flatpak build-bundle repo hello.flatpak org.example.Hello >/dev/null 2>&1'
run test -f /home/student/flatpak/hello.flatpak

hidden hp

settings
  pager on

say "Snap — от Canonical. А у Fedora, GNOME и KDE своё «приложение на любой Linux» — flatpak."
read brief.md

stage
  say "Загляни в образец ~/flatpak/hello-app: что записано в паспорте и что лежит внутри"
  solve:
    cat /home/student/flatpak/hello-app/metadata
  accept output "command=hello"
  neutral ls pwd cd less head tail tree file
  on pass say "build-finish дописал в паспорт command=, а files/ внутри песочницы станет /app. Из этого каталога и сделан hello.flatpak рядом."
  hint tries 5 say "Паспорт приложения — файл metadata в его каталоге, обычный текст."

stage
  say "Собери так же из ~/pelmeni файл pelmeni.flatpak — приложение org.hashpass.Pelmeni, команда pelmeni"
  solve:
    cd /home/student
    mkdir -p pelmeni-app/files/bin
    cp pelmeni/pelmeni pelmeni-app/files/bin/
    printf '%s\n' '[Application]' 'name=org.hashpass.Pelmeni' 'runtime=org.freedesktop.Platform/x86_64/24.08' 'sdk=org.freedesktop.Sdk/x86_64/24.08' > pelmeni-app/metadata
    flatpak build-finish pelmeni-app --command=pelmeni
    flatpak build-export repo pelmeni-app
    flatpak build-bundle repo pelmeni.flatpak org.hashpass.Pelmeni
  check exec flatpaks
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file chmod ostree
  on pass say "Бандл — это коммит ostree в одном файле: flatpak install --user pelmeni.flatpak поставил бы его как из Flathub."
  hint output "not initialized" read metadata.md
  hint output "not installed" read metadata.md
  hint output "already finalized" say "build-finish дважды не работает: паспорт уже готов. Это обычный текстовый файл — поправь его сам."
  hint output "Names must contain at least 2 periods" say "Идентификатор приложения — перевёрнутый домен: минимум три части через точку."
  hint output "is not a valid repository" say "build-bundle берёт приложение из репозитория. Кто его туда кладёт?"
  hint output "not found" say "В репозитории нет приложения с таким именем. Какое имя записано в metadata?"
  hint tries 5 say "Сравни свой каталог с образцом: ls -R. Чего не хватает?"
  hint tries 8 say "Порядок такой: каталог приложения → build-finish → build-export в репозиторий → build-bundle в файл."

exec finale
