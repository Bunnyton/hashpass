#!/bin/sh
# Найти в доме бандл .flatpak приложения org.hashpass.Pelmeni: в metadata name и command, этот файл в
# files/bin исполняемый, и запущенный, как в песочнице (/app → распакованный files/), он считает пельмени.
# Бандл импортируется во временный репозиторий ostree и достаётся checkout — flatpak run в консоли
# невозможен (bwrap).
for f in $(find /home/student -name '*.flatpak' 2>/dev/null); do
    d=$(mktemp -d)
    ostree --repo="$d/r" init --mode=archive >/dev/null 2>&1 || continue
    flatpak build-import-bundle "$d/r" "$f" >/dev/null 2>&1 || continue
    ostree --repo="$d/r" checkout -U app/org.hashpass.Pelmeni/x86_64/master "$d/a" >/dev/null 2>&1 || continue
    m=$d/a/metadata
    grep -qx 'name=org.hashpass.Pelmeni' "$m" || continue
    cmd=$(sed -n 's/^command=//p' "$m" | head -n 1)
    [ -n "$cmd" ] || continue
    A=$d/a/files
    case $cmd in /*) exe=$A${cmd#/app} ;; *) exe=$A/bin/$cmd ;; esac
    [ -f "$exe" ] && [ -x "$exe" ] || continue
    (cd /tmp && env -i HOME=/tmp PATH="$A/bin:/usr/bin:/bin" "$exe" 2 2>&1) | grep -q 'Порций: 2' && exit 0
done
exit 1
