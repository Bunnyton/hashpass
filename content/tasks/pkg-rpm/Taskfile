# pkg-rpm — пакет для Fedora/RHEL/openSUSE: rpmbuild + spec. (1) ~/rpmbuild/SOURCES/pelmeni-1.0.tar.gz
# (тарбол делает студент: tar с каталогом pelmeni-1.0/) + SPECS/pelmeni.spec → noarch.rpm;
# ловушки — нет тарбола в SOURCES, файлы не перечислены в %files, /usr/local вместо %{_bindir};
# (2) Requires: figlet + 1.1 с %changelog. Ставить rpm на Debian нельзя — проверка по rpm -qp.
# Образ и ~/pelmeni — из pkg-deb.

image pkg-rpm:1
from pkg-deb:1

# rpm в Debian приходит без базы пакетов — rpmbuild на каждом шаге ругался бы на sqlite
run rpmdb --initdb

hidden hp

settings
  pager on

say "Debian — не весь мир. В Fedora, RHEL и openSUSE пакеты — .rpm, и рецепт у них свой."
read brief.md

stage
  say "Собери из ~/pelmeni пакет pelmeni-1.0 для Fedora: noarch.rpm с программой в /usr/bin"
  solve:
    cd /home/student
    mkdir -p rpmbuild/SOURCES rpmbuild/SPECS
    cp -r pelmeni pelmeni-1.0
    tar czf rpmbuild/SOURCES/pelmeni-1.0.tar.gz pelmeni-1.0
    rm -rf pelmeni-1.0
    printf '%s\n' 'Name: pelmeni' 'Version: 1.0' 'Release: 1' 'Summary: Сколько варить и сколько кидать' 'License: MIT' 'BuildArch: noarch' 'Source0: %{name}-%{version}.tar.gz' '' '%description' 'Считает пельмени, воду и соль.' '' '%prep' '%setup -q' '' '%install' 'make install DESTDIR=%{buildroot} PREFIX=/usr' '' '%files' '%{_bindir}/pelmeni' '%{_mandir}/man1/pelmeni.1*' '/usr/share/applications/pelmeni.desktop' '/usr/share/icons/hicolor/scalable/apps/pelmeni.svg' > rpmbuild/SPECS/pelmeni.spec
    rpmbuild -bb rpmbuild/SPECS/pelmeni.spec
  check exec rpm 1.0
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file tar
  on pass say "rpm -qpil файл.rpm — паспорт и список файлов. Тот же пакет на Fedora ставится через sudo dnf install ./файл.rpm."
  hint output "No such file or directory" say "rpmbuild ищет исходники в ~/rpmbuild/SOURCES. Что там лежит и как оно названо в Source0?"
  hint output "Installed (but unpackaged) file(s) found" read files.md
  hint output "File not found:" say "В %files перечислен путь, которого после %install нет. Куда make install на самом деле положил файлы? Смотри строки install в выводе."
  hint output "Bad exit status from" say "Упал один из разделов spec — какой, rpmbuild пишет в той же строке. Чуть выше — вывод его команд."
  hint tries 5 say "Готовые пакеты rpmbuild кладёт в ~/rpmbuild/RPMS/<архитектура>/. Что там?"
  hint tries 8 say "%setup распаковывает тарбол и заходит в каталог имя-версия. Такой каталог в тарболе есть? tar tzf."

stage
  say "Выпусти pelmeni 1.1: пусть пакет требует figlet, а в истории будет запись о выпуске"
  on enter read requires.md
  solve:
    cd /home/student
    cp -r pelmeni pelmeni-1.1
    tar czf rpmbuild/SOURCES/pelmeni-1.1.tar.gz pelmeni-1.1
    rm -rf pelmeni-1.1
    sed -i 's/^Version: 1.0/Version: 1.1/; /^BuildArch/a Requires: figlet' rpmbuild/SPECS/pelmeni.spec
    printf '%s\n' '' '%changelog' '* Mon Nov 09 2026 Student <student@example.com> - 1.1-1' '- Требует figlet.' >> rpmbuild/SPECS/pelmeni.spec
    rpmbuild -bb rpmbuild/SPECS/pelmeni.spec
  check exec rpm 1.1 requires
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file tar
  on pass say "rpm -qp --requires покажет и то, что rpmbuild добавил сам: /bin/sh — он заметил строку #! в скрипте."
  hint output "bogus date in %changelog" say "Дата в %changelog — по-английски и строго: * Mon Nov 09 2026 Имя <почта> - версия-релиз. День недели должен совпасть с датой."
  hint output "No such file or directory" say "Для новой версии нужен и новый тарбол: Source0 собирается из имени и версии."
  hint tries 5 say "rpm -qp --requires файл.rpm — что пакет требует? rpm -qp --changelog — что в истории?"

exec finale
