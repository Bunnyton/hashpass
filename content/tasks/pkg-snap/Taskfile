# pkg-snap — snap: squashfs с meta/snap.yaml. «Смотри готовый — собери так же». snapcraft в консоли не
# работает (ему нужны LXD/multipass), поэтому собираем, как он сам в конце: каталог → snap pack. В ~/snaps
# при сборке образа собран образец: data/hello-snap → hello_1.0_all.snap. (1) заглянуть внутрь
# (unsquashfs -l / -cat meta/snap.yaml); (2) pelmeni 1.0 по образцу → snap pack. Ставить снап здесь
# некуда (snapd в контейнере не монтирует squashfs) — проверка распаковывает его. Образ — из pkg-deb.

image pkg-snap:1
from pkg-deb:1

# data: data/hello-snap — руками: образец каталога снапа, его упаковывают здесь же
copy data/hello-snap /home/student/snaps/hello-snap
run chown -R student:student /home/student/snaps
run runuser -u student -- sh -c 'cd /home/student/snaps && snap pack hello-snap >/dev/null 2>&1'
run test -f /home/student/snaps/hello_1.0_all.snap

hidden hp

settings
  pager on

say "Ubuntu ставит Firefox не из .deb, а снапом. Посмотрим, что это за зверь."
read brief.md

stage
  say "Загляни в образец ~/snaps/hello_1.0_all.snap: какие в нём файлы и какой у него паспорт"
  solve:
    unsquashfs -cat /home/student/snaps/hello_1.0_all.snap meta/snap.yaml
  accept cmd "unsquashfs"
  accept output "command: *bin/hello"
  neutral ls cat pwd cd less head tail tree file
  on pass say "Каталог, из которого снап собран, лежит рядом — ~/snaps/hello-snap. Это и есть рецепт."
  hint tries 5 say "Как посмотреть файл внутри снапа, не распаковывая его, — в теории."

stage
  say "Собери так же из ~/pelmeni снап pelmeni версии 1.0"
  solve:
    cd /home/student
    mkdir -p snap-pelmeni/meta snap-pelmeni/bin
    cp pelmeni/pelmeni snap-pelmeni/bin/
    sed 's/hello/pelmeni/g; s/^summary: .*/summary: Сколько варить и сколько кидать/; s/^description: .*/description: Считает пельмени, воду и соль./' snaps/hello-snap/meta/snap.yaml > snap-pelmeni/meta/snap.yaml
    snap pack snap-pelmeni
  check exec snaps
  neutral ls cat pwd cd less head tail vim nano mkdir cp tree file chmod
  on pass say "На Ubuntu его поставил бы sudo snap install --dangerous pelmeni_1.0_all.snap: --dangerous — потому что снап не подписан магазином."
  hint output "cannot validate" read yaml.md
  hint output "bad permissions" say "snap pack проверяет, что команда приложения — исполняемый файл. Как дать файлу право на запуск?"
  hint output "does not exist" say "Путь в command считается от корня снапа. Лежит ли файл ровно там?"
  hint tries 5 say "Сравни свой каталог с образцом: ls -R. Чего не хватает?"
  hint tries 8 say "Без meta/snap.yaml снап не соберётся: имя, версия, описание и приложения — оттуда."

exec finale
