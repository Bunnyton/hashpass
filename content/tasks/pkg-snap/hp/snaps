#!/bin/sh
# Найти в доме .snap пакета pelmeni: в meta/snap.yaml name pelmeni и version 1.0, у приложения есть
# command, этот файл внутри снапа исполняемый, и запущенный он считает пельмени.
for f in $(find /home/student -name '*.snap' 2>/dev/null); do
    y=$(unsquashfs -cat "$f" meta/snap.yaml 2>/dev/null) || continue
    echo "$y" | grep -Eq "^name: *['\"]?pelmeni['\"]? *$" || continue
    echo "$y" | grep -Eq "^version: *['\"]?1\.0['\"]? *$" || continue
    cmd=$(echo "$y" | sed -n "s/^ *command: *['\"]\{0,1\}\([^'\" ]*\).*/\1/p" | head -n 1)
    [ -n "$cmd" ] || continue
    d=$(mktemp -d)
    unsquashfs -q -d "$d/s" "$f" >/dev/null 2>&1 || continue
    [ -x "$d/s/$cmd" ] || continue
    "$d/s/$cmd" 2 2>&1 | grep -q 'Порций: 2' && exit 0
done
exit 1
