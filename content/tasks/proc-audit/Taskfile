# proc-audit — a two-stage task: install a package (big FS change via apt), then audit processes.
# The base is minimal (systemd + fish, no ps/pgrep), so installing procps is a real, needed step
# that also unlocks the process-search stage. Acceptance observes DISTINCTIVE TEXT ARTIFACTS the
# student PRODUCES (the dpkg install status; the sleep-process count) — never a bare binary's
# presence or the volatile process table, so the tolerant grader has a strong signal to match.

image proc-audit:1

# This task installs packages and writes to / -- it needs a root console.
settings
  user root

stage "Install the procps package with apt, then record its dpkg status into /install-status.txt"
  solve:
    apt-get update >/dev/null 2>&1
    apt-get install -y procps >/dev/null 2>&1
    dpkg -s procps | grep '^Status:' > /install-status.txt
  observe /install-status.txt

stage "Launch a background 'sleep 600', then count the running sleep processes with pgrep into /proc-count.txt"
  solve:
    sleep 600 &
    sleep 0.3
    pgrep -x sleep | wc -l > /proc-count.txt
  observe /proc-count.txt
