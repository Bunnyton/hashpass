# proc-audit — первое задание блока «Процессы»: что такое процесс, PID/PPID, дерево, службы.
# Шаг 1: поставить psmisc (pstree, killall, fuser). Шаг 2: дерево процессов с PID — найти свою
# оболочку. Шаг 3: от чьего имени работает служба sentry (системный пользователь daemon).
# Ответы видны на экране — принимаются по выводу (accept output), без файлов.

image proc-audit:1

# data: data/bin, data/systemd — руками: служба sentry от пользователя daemon
copy data/bin /usr/local/bin
copy data/systemd /etc/systemd/system
run systemctl enable sentry.service

hidden hp

settings
  pager on

# kill -1 — «сигнал всем процессам»: снесёт консоль вместе с системой
block kill match " -1 *$" say "kill с номером -1 бьёт по всем процессам сразу — вместе с этой консолью. Укажи конкретный PID."

say "Тебя позвали на аудит сервера: что на нём работает и кто за этим стоит."
read theory.md
read brief.md

stage
  say "Поставь пакет psmisc"
  solve:
    sudo apt-get update >/dev/null 2>&1
    sudo apt-get install -y psmisc >/dev/null 2>&1
  observe bool /usr/bin/pstree
  neutral ls cat pwd
  on pass say "psmisc на месте: теперь у тебя есть pstree, killall и fuser."
  hint output "Permission denied" say "apt отказал: прав не хватает. Как обычный пользователь одалживает права администратора на одну команду?"
  hint output "Unable to locate package" say "apt не знает такого пакета. Когда он в последний раз обновлял список? Два шага."
  hint tries 5 say "Как ставили пакеты в прошлых заданиях?"

stage
  say "Покажи дерево процессов с их номерами и найди в нём свою оболочку"
  solve pstree -p
  accept output "bash\([0-9]+\)"
  neutral ls cat pwd
  on pass say "Иди от bash влево, к корню: каждый следующий — родитель предыдущего. На вершине — systemd(1): первая программа, которую запустило ядро, а она — всё остальное."
  hint cmd pstree missing -p say "Дерево есть, а номеров нет. Что пишет pstree --help про PID?"
  hint tries 5 say "Какая команда из psmisc рисует процессы деревом?"

stage
  say "На сервере работает служба sentry. Узнай, от имени какого пользователя она работает"
  solve ps -o user= -C sentry
  accept output "(^|\n) *daemon( |\n|$)"
  neutral ls cat pwd
  on pass say "daemon — системный пользователь: войти под ним нельзя, это пропуск для служб. Взломают sentry — взломщик получит права daemon, а не root."
  hint tries 5 say "Какой столбец ps aux отвечает на вопрос «от чьего имени»?"
  hint tries 10 say "Длинный список удобно сужать конвейером с grep."

exec finale
