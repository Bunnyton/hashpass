# rm-basics — удаление: всё содержимое workdir, включая скрытое; сам каталог остаётся.

image rm-basics:1

# data: python3 .claude/skills/task-authoring/scripts/mkdata.py tree data/workdir --seed 240 --depth 2 --dirs 5 --files 40 --lines 1-8 --plant '.secret_junk=спрятанный мусор' --plant '.hidden_junk/inside.txt=ещё мусор' --plant .cache/index.bin= --plant '.cache/pages/1.html=<html>мусор</html>' --plant .old_config=junk=1
copy data/workdir /home/student/workdir
run chown -R student:student /home/student/workdir

hidden hp

settings
  pager on

say "rm — remove. Крушить, ломать! Но по правилам."
read brief.md

stage
  "Очисти /home/student/workdir до нуля, скрытое тоже — сам каталог оставь"
  solve:
    rm -rf /home/student/workdir/*
    rm -rf /home/student/workdir/.[!.]*
  check exec sh -c 'test -d /home/student/workdir && test -z "$(ls -A /home/student/workdir 2>/dev/null)"'
  neutral ls cat pwd
  on pass say "Ты только что удалил скрытое. Помни: rm не спрашивает и корзины у него нет — вот почему ls -a идёт первым."
  hint output "Is a directory" say "rm отказался: это каталог. В теории был ключ."
  hint tries 3 say "Проверь, что осталось: ls показывает пусто? А ls -a?"
  hint tries 6 say "Что в теории сказано про звёздочку и имена с точкой? Или загугли: «bash glob скрытые файлы»."
  hint tries 10 say "Один шаблон — для видимого, другой — для имён с точкой; в одной команде их может быть оба."
  hint idle 240 say "Долгая пауза. Перечитай цель и вывод последней команды."

exec finale
