# rm-basics — удаление: всё содержимое workdir, включая скрытое; сам каталог остаётся.

image rm-basics:1

# data/workdir: python3 .claude/skills/task-authoring/scripts/mkdata.py tree … --seed 240 --dirs 5 --files 40 + скрытые файлы и каталоги
copy data/workdir /home/student/workdir
run chown -R student:student /home/student/workdir

hidden hp

settings
  pager on

say "rm — remove. Крушить, ломать! Но по правилам."
read brief.md

stage "Очисти /home/student/workdir до нуля — включая скрытое, — но сам каталог оставь"
  solve:
    rm -rf /home/student/workdir/*
    rm -rf /home/student/workdir/.[!.]*
  check exec sh -c 'test -d /home/student/workdir && test -z "$(ls -A /home/student/workdir 2>/dev/null)"'
  neutral ls cat pwd
  on enter say "Мусор бывает на виду, а бывает — с точкой в начале имени."
  on pass say "Ты только что удалил скрытое. Помни: rm не спрашивает и корзины у него нет — вот почему ls -a идёт первым."
  hint output "Is a directory" say "rm отказался: это каталог. В теории был ключ."
  hint tries 3 say "Проверь, что осталось: ls показывает пусто? А ls -a?"
  hint tries 6 say "Звёздочка не подставляет имена с точкой. Загугли: «bash glob скрытые файлы»."
  hint tries 10 say "Скрытое удаляется отдельным шаблоном. Каталог оставь."
  hint idle 240 say "Перечитай цель: ВСЁ содержимое, каталог остаётся. Проверяй через ls -A."

exec finale
