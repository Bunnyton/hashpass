# rm-basics — удаление: всё содержимое workdir, включая скрытое; сам каталог остаётся.

image rm-basics:1

run mkdir -p /home/student/workdir /home/student/workdir/.hidden_junk
run printf 'мусор 1\n' > /home/student/workdir/junk1.txt
run printf 'мусор 2\n' > /home/student/workdir/junk2.txt
run printf 'спрятанный мусор\n' > /home/student/workdir/.secret_junk
run printf 'ещё мусор\n' > /home/student/workdir/.hidden_junk/inside.txt
run chown -R student:student /home/student/workdir

hidden hp

settings
  pager on

say "rm — remove. Крушить, ломать! Но по правилам."
read brief.md

stage "Очисти /home/student/workdir до нуля — включая скрытое, — но сам каталог оставь"
  solve:
    rm -rf /home/student/workdir/*
    rm -rf /home/student/workdir/.[!.]*
  check exec sh -c 'test -d /home/student/workdir && test -z "$(ls -A /home/student/workdir 2>/dev/null)"'
  neutral ls cat pwd
  on enter say "Мусор бывает на виду, а бывает — с точкой в начале имени."
  hint output "Is a directory" say "rm отказался: это каталог. Прочитай его ответ — и вспомни из теории, какой ключ делает удаление рекурсивным."
  hint tries 3 say "Проверь, что осталось: ls показывает пусто? А ls -a?"
  hint tries 6 say "Звёздочка в шелле не подставляет имена с точкой. Загугли: «bash glob скрытые файлы» — или man bash, раздел Pathname Expansion."
  hint tries 10 say "Скрытое удаляется отдельным шаблоном (или через find). Каталог workdir при этом должен уцелеть — а если снёс, пересоздай."
  hint idle 240 say "Перечитай цель: ВСЁ содержимое, каталог остаётся. Проверяй через ls -A."

exec finale
