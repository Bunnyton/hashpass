#!/bin/sh
set -eu

words() {
  tr -s '[:space:]' '\n' | sed '/^$/d' | sort
}

got=$(printf '%s\n' "${HP_LAST_OUT:-}" | words)
# Во время этой проверки служебный /hp временно смонтирован, но в студенческой
# консоли его нет. Не включаем его в ожидаемый список корня.
want=$(ls -1 / | sed '/^hp$/d' | words)
[ "$got" = "$want" ]
