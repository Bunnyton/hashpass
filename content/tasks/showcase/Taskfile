# ============================================================================
# showcase — образцовое задание, демонстрирующее почти все возможности, вживую.
#   Сборка:  cd content/tasks/showcase && hashpass build Taskfile
#   Запуск:  hashpass run showcase:1
# Пути hidden/copy/readme резолвятся относительно ПАПКИ этого Taskfile — собирать можно откуда угодно.
# Комментарии — только на отдельной строке.
# ============================================================================

image showcase:1

run mkdir -p /srv
run mkdir -p /var/log/app
run printf 'ERROR alpha\nok\nERROR beta\nERROR gamma\n' > /var/log/app/service.log
copy welcome.txt /opt/welcome.txt

hidden hp
readme README.md

settings
  type-mode normal
  type-speed 90
  pager on
  user student
  sudo on
  similarity 85

voice
  hello say dramatic "Здравствуйте, оператор. Я наблюдаю."

react on command exec react

# --- ВСТУПЛЕНИЕ: печатается вживую в консоли до заданий ---
say "Введу вас в курс дела, прежде чем начнём."
read theory.md

# --- Задание 1: наблюдаемый артефакт (без привилегий) ---
stage "Запишите слово ГОТОВО в файл /home/student/report.txt"
  solve:
    echo ГОТОВО > /home/student/report.txt
  observe /home/student/report.txt
  neutral ls cat pwd
  on enter say "Задание 1: оставьте короткий отчёт."
  on enter read clue1.md
  on pass say dramatic "Отчёт принят."
  hint tries 2 say "Подсказка:  echo ГОТОВО > /home/student/report.txt"
  hint cmd echo missing ГОТОВО say "В echo должно быть ровно слово ГОТОВО."

# --- Задание 2: приёмка по ВЫВОДУ команды (нечётко, по settings similarity) ---
# Оценивается сам stdout команды против эталона, а не файл на диске. Живой захват вывода
# делает это возможным в консоли; `hint output` тоже срабатывает по выводу вживую.
stage "Напечатайте, сколько строк содержат ERROR в /var/log/app/service.log"
  solve grep -c ERROR /var/log/app/service.log
  observe output
  neutral ls cat less
  on enter say "Задание 2: проверка по ВЫВОДУ команды — важен сам вывод, а не файл."
  hint tries 2 say "Подсказка:  grep -c ERROR /var/log/app/service.log"
  hint output "0" say "Ноль? В журнале точно есть строки ERROR — присмотритесь к команде."
  on pass say dramatic "Вывод верный — принято."

# --- Задание 3: классический sudo ---
stage "Через sudo установите procps и сохраните его dpkg-статус в /srv/status.txt"
  solve:
    apt-get update >/dev/null 2>&1
    apt-get install -y procps >/dev/null 2>&1
    dpkg -s procps | grep '^Status:' > /srv/status.txt
  observe /srv/status.txt
  on enter say "Задание 3: нужны права root. Используйте sudo — пароль 'student'."
  on enter exec intro2
  on pass say "Привилегированно и точно."
  hint idle 30 say "sudo apt-get install -y procps ; затем: dpkg -s procps | grep Status | sudo tee /srv/status.txt"

# --- Задание 4: скрытый грейдер в /hp судит ответ ---
stage "Создайте /home/student/secret с секретной фразой, которую ждёт скрытый грейдер"
  solve:
    echo open-sesame > /home/student/secret
  check exec grade
  on enter say "Задание 4: в /hp живёт секретный грейдер. Угадайте его фразу."
  on enter read clue3.md
  on pass exec celebrate

# --- ФИНАЛ: печатается при полном зачёте ---
say dramatic "Вот и всё. Отличная работа, оператор."
