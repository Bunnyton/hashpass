# ============================================================================
# showcase — a reference task exercising (nearly) every hashpass feature, LIVE.
#   Build:  cd content/tasks/showcase && hashpass build Taskfile
#   Run:    hashpass run showcase:1
# `hidden`/`copy`/`readme` paths resolve from the CWD, so build from this dir.
# Comments must be on their OWN line (no trailing inline comments).
# ============================================================================

image showcase:1

# --- image build steps (baked in) ---
run mkdir -p /srv
copy welcome.txt /opt/welcome.txt

# --- hidden /hp materials: graders + theory the student never sees directly ---
hidden hp

# --- author briefing (Markdown, paged, shown at the start) ---
readme README.md

# --- render + identity settings ---
settings
  type-mode normal
  type-speed 90
  pager on
  user student
  sudo on

# --- session voice ---
voice
  hello say dramatic "Welcome, operator -- I am watching."

# --- a catch-all that reacts after EVERY command ---
react on command exec react

# --- top-level INTRO: fires live in the console before the stages ---
say "Let me brief you before we begin."
read theory.md

# --- Stage 1: observe an artifact you produce (no privileges) ---
stage "Write the word DONE into /home/student/report.txt"
  solve:
    echo DONE > /home/student/report.txt
  observe /home/student/report.txt
  neutral ls cat pwd
  on enter say "Task 1: leave a one-word report."
  on enter read clue1.md
  on pass say dramatic "Report received."
  hint tries 2 say "Try:  echo DONE > /home/student/report.txt"
  hint cmd echo missing DONE say "Your echo must contain the exact word DONE."

# --- Stage 2: classic sudo ---
stage "With sudo, install procps and save its dpkg status to /srv/status.txt"
  solve:
    apt-get update >/dev/null 2>&1
    apt-get install -y procps >/dev/null 2>&1
    dpkg -s procps | grep '^Status:' > /srv/status.txt
  observe /srv/status.txt
  on enter say "Task 2: this needs root. Use sudo -- your password is 'student'."
  on enter exec intro2
  on pass say "Privileged and precise."
  hint idle 30 say "sudo apt-get install -y procps ; then pipe status through: sudo tee /srv/status.txt"

# --- Stage 3: a HIDDEN grader in /hp judges your answer ---
stage "Create /home/student/secret holding the pass-phrase the hidden grader expects"
  solve:
    echo open-sesame > /home/student/secret
  check exec grade
  on enter say "Task 3: a secret grader lives in /hp. Find its phrase."
  on enter read clue3.md
  on pass exec celebrate

# --- top-level OUTRO: fires when every stage passes ---
say dramatic "That's everything. Excellent work, operator."
