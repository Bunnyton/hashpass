# ============================================================================
# showcase — образцовое задание, демонстрирующее почти все возможности, вживую.
#   Сборка:  cd content/tasks/showcase && hashpass build Taskfile
#   Запуск:  hashpass run showcase:1
# Пути hidden/copy/readme резолвятся относительно ПАПКИ этого Taskfile — собирать можно откуда угодно.
# Комментарии — только на отдельной строке.
# ============================================================================

image showcase:1

run mkdir -p /var/log/app
run printf 'ERROR alpha\nok\nERROR beta\nERROR gamma\n' > /var/log/app/service.log
copy welcome.txt /opt/welcome.txt

hidden hp

# Хорошие умолчания — почти ничего настраивать не нужно (type-mode/speed/flow, user student, sudo on
# по умолчанию). Переопределяем только осмысленное: пейджер для длинной теории и строгую приёмку вывода.
settings
  pager on
  similarity 100

# --- ВСТУПЛЕНИЕ: печатается вживую в консоли до заданий (theory.md — теория для студента) ---
say "Введу вас в курс дела, прежде чем начнём."
read theory.md

# --- Задание 1: наблюдаемый артефакт (без привилегий) ---
stage "Запишите слово ГОТОВО в файл /home/student/report.txt"
  solve:
    echo ГОТОВО > /home/student/report.txt
  observe /home/student/report.txt
  neutral ls cat pwd
  on enter say "Задание 1: оставьте короткий отчёт."
  on enter read clue1.md
  hint tries 2 say "Подсказка:  echo ГОТОВО > /home/student/report.txt"
  hint cmd echo missing ГОТОВО say "В echo должно быть ровно слово ГОТОВО."

# --- Задание 2: приёмка по ВЫВОДУ команды (СТРОГО: similarity 100) + варианты + whitelist ---
# Оценивается чистый stdout (вырезается по OSC-133-маркерам fish) против эталона. Эталон = вывод,
# ОБЩИЙ для нескольких `variant`-решений: их канонизация оставляет только «3» — какой командой не важно.
# `allow` — в консоли выполняются ТОЛЬКО эти команды (+ neutral-навигация): `echo 3`-подстава даже
# не запустится (шелл её заблокирует). Посчитать надо по-настоящему — grep/awk/wc.
stage "Напечатайте, сколько строк содержат ERROR в /var/log/app/service.log"
  solve grep -c ERROR /var/log/app/service.log
  variant grep ERROR /var/log/app/service.log | wc -l
  variant awk '/ERROR/{c++} END{print c}' /var/log/app/service.log
  observe output
  allow grep awk wc
  neutral ls cat less
  on enter say "Задание 2: важен ВЫВОД (ровно число), а посчитать надо по-настоящему — grep/awk/wc."
  hint tries 2 say "Подсказка:  grep -c ERROR /var/log/app/service.log"
  hint output "0" say "Ноль? В журнале точно есть строки ERROR — присмотритесь к команде."

# --- Задание 3: sudo + пакет, которого НЕТ; проверка ОДНОЙ inline-командой (без скрипта) ---
# `check exec <команда>` запускает проверку прямо строкой (exit 0 = принято). Скрипт не нужен;
# и это sentinel-стадия — `solve` при сборке НЕ выполняется (apt не гоняется во время build).
stage "Установите пакет sl (его нет в системе) через sudo"
  solve:
    apt-get update >/dev/null 2>&1
    apt-get install -y sl >/dev/null 2>&1
  check exec command -v sl || test -x /usr/games/sl
  on enter say "Задание 3: пакета sl в системе нет. Установите его (sudo, пароль student)."
  on enter exec intro2
  hint idle 25 say "sudo apt-get update ; sudo apt-get install -y sl"

# --- Задание 4: проверяем сам ЗАПУСК команды — прямо в DSL, без скрытого грейдера ---
# `accept cmd "<подстрока>"` засчитывает стадию по САМОЙ команде студента (у поезда нет следа на ФС).
stage "Запустите поезд командой  sl"
  accept cmd "sl"
  neutral ls cat less
  on enter say "Задание 4: теперь запустите — sl. Стадия ловит саму команду, файлов она не оставляет."
  hint idle 20 say "Просто наберите:  sl"

# --- Задание 5: скрытый грейдер в /hp судит ответ ---
stage "Создайте /home/student/secret с секретной фразой, которую ждёт скрытый грейдер"
  solve:
    echo open-sesame > /home/student/secret
  check exec grade
  on enter say "Задание 5: в /hp живёт секретный грейдер. Угадайте его фразу."
  on enter read clue3.md

# --- ФИНАЛ: ASCII-арт из скрытого /hp; он и отмечает полный зачёт (обязательных фраз нет) ---
exec finale
