# ============================================================================
# showcase — образцовое задание, демонстрирующее почти все возможности, вживую.
#   Сборка:  cd content/tasks/showcase && hashengine build Taskfile
#   Запуск:  hashpass run showcase:1   (или через пул: hashpass run <номер>)
# Пути hidden/copy/readme резолвятся относительно ПАПКИ этого Taskfile — собирать можно откуда угодно.
# Комментарии — только на отдельной строке. Стиль подсказок — по skill task-authoring:
# вопрос → куда смотреть → понятие; каждое правило срабатывает один раз за этап.
# ============================================================================

image showcase:1

run mkdir -p /var/log/app
run printf 'ERROR alpha\nok\nERROR beta\nERROR gamma\n' > /var/log/app/service.log
copy welcome.txt /opt/welcome.txt

hidden hp

# Хорошие умолчания — почти ничего настраивать не нужно (type-mode/speed, user student, sudo on
# по умолчанию). Переопределяем только осмысленное: пейджер для длинной теории и строгую приёмку вывода.
settings
  pager on
  similarity 100

# --- ВСТУПЛЕНИЕ: печатается вживую в консоли до заданий (theory.md — теория для студента) ---
say "Введу тебя в курс дела, прежде чем начнём."
read theory.md

# --- Задание 1: наблюдаемый артефакт (без привилегий) + `on enter read` + реактивная cmd-подсказка ---
stage "Оставь короткий отчёт: в /home/student/report.txt должно лежать одно слово — ГОТОВО"
  solve:
    echo ГОТОВО > /home/student/report.txt
  observe /home/student/report.txt
  neutral ls cat pwd
  on enter say "Отчёт из одного слова. Где именно и какого — сказано в цели."
  on enter read clue1.md
  on pass say "Бонус: cat report.txt — файл на месте."
  hint cmd echo missing ГОТОВО say "В echo должно быть ровно слово ГОТОВО — заглавными."
  hint tries 3 say "Файл появился? cat его. Слово одно, регистр важен."
  hint tries 6 say "Загугли: «bash записать слово в файл»."

# --- Задание 2: приёмка по ВЫВОДУ команды (СТРОГО: similarity 100) + варианты + whitelist ---
# Оценивается чистый stdout (по OSC-133-маркерам) против эталона. Эталон = вывод, ОБЩИЙ для
# нескольких `variant`-решений: их канонизация оставляет только «3» — какой командой не важно.
# `allow` — в консоли выполняются ТОЛЬКО эти команды (+ neutral-навигация): `echo 3`-подстава даже
# не запустится (шелл её заблокирует). Посчитать надо по-настоящему — grep/awk/wc.
stage "Напечатай, сколько строк в /var/log/app/service.log содержат ERROR — ровно число"
  solve grep -c ERROR /var/log/app/service.log
  variant grep ERROR /var/log/app/service.log | wc -l
  variant awk '/ERROR/{c++} END{print c}' /var/log/app/service.log
  observe output
  allow grep awk wc
  neutral ls cat less
  on enter say "Важен ВЫВОД — ровно число. И посчитать надо по-настоящему: echo с ответом не пройдёт."
  on pass say "grep -c — счётчик; grep -n — номера строк."
  hint output "0" say "Ноль? В журнале точно есть строки ERROR — присмотрись к команде: регистр, путь."
  hint tries 3 say "Строки с ERROR ты уже видишь? Теперь их надо не показать, а посчитать. У grep есть ключ для счёта, у wc — для строк."
  hint tries 6 say "man grep — ищи «count». Или загугли: «посчитать строки со словом в файле linux»."

# --- Задание 3: sudo + пакет, которого НЕТ; проверка ОДНОЙ inline-командой (без скрипта) ---
# `check exec <команда>` запускает проверку прямо строкой (exit 0 = принято). Скрипт не нужен;
# и это sentinel-стадия — `solve` при сборке НЕ выполняется (apt не гоняется во время build).
# `on enter exec intro2` — пример действия-скрипта из скрытого /hp.
stage "Установи пакет sl — его в системе нет; понадобятся права администратора"
  solve:
    apt-get update >/dev/null 2>&1
    apt-get install -y sl >/dev/null 2>&1
  check exec command -v sl || test -x /usr/games/sl
  neutral ls cat pwd
  on enter say "Пакета sl нет. Ты — student, а apt слушается только root."
  on enter exec intro2
  on pass say "sl -F: поезд улетит."
  hint output "Permission denied" say "apt отказал: прав не хватает. Как обычный пользователь одалживает права root на одну команду?"
  hint output "Unable to locate package" say "apt не нашёл пакет — когда он обновлял список? Два шага."
  hint tries 3 say "Прочитай, что ответил apt: он говорит прямым текстом, чего хочет."
  hint idle 240 say "Загугли: «apt установить пакет sudo»."

# --- Задание 4: проверяем сам ЗАПУСК команды — прямо в DSL, без скрытого грейдера ---
# `accept cmd "<команда>" ok` засчитывает стадию по САМОЙ команде студента (у поезда нет следа
# на ФС): позиционные слова образца по порядку, опции где угодно; `ok` — успешное завершение.
stage "Запусти установленный поезд"
  accept cmd "sl" ok
  neutral ls cat less
  on enter say "Пакет называется sl, команда — тоже. Поезд следов на диске не оставляет — его нужно просто запустить."
  on pass say "Поезд ушёл. Попробуй sl -l."
  hint idle 240 say "Имя команды совпадает с именем пакета."

# --- Задание 5: скрытый грейдер в /hp судит ответ ---
stage "Создай /home/student/secret с одной фразой — той самой, что открывает пещеру"
  solve:
    echo open-sesame > /home/student/secret
  check exec grade
  neutral ls cat pwd
  on enter say "Фразу подсмотреть негде — зато есть подсказка."
  on enter read clue3.md
  on pass say "Фраза известна. Пещера открыта."
  hint tries 3 say "Фраза — по-английски, строчными, два слова через дефис, без лишних пробелов. cat /home/student/secret — точно так?"
  hint tries 6 say "Загугли: «Али-Баба заклинание пещера по-английски»."
  hint idle 240 say "Перечитай подсказку: два слова, дефис, Али-Баба."

# --- ФИНАЛ: ASCII-арт из скрытого /hp; он и отмечает полный зачёт (обязательных фраз нет) ---
exec finale
