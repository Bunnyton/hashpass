# simple-ls — первая настоящая команда: ls.
# Приёмка — по ВЫВОДУ: студент любым способом увидел содержимое room (ls room, ls -l room,
# cd room и ls …). `observe output` для ls нестабилен (колонки в TTY vs строки в pipe),
# поэтому судит скрытый грейдер по HP_LAST_OUT.

image simple-ls:1

# data: data/room сделан руками один раз — правь файлы напрямую
copy data/room /home/student/room
run chown -R student:student /home/student/room

hidden hp

settings
  pager on

say "Первая команда — самая простая. Она показывает, что вокруг."
read brief.md

stage "Посмотри, что лежит в /home/student/room"
  solve ls /home/student/room
  check exec grade
  neutral cat pwd
  on enter say "Ты стоишь в /home/student. Комната — прямо здесь, рядом."
  on pass say "Голый ls — самое частое, что набирают в терминале. Попробуй ls -l: те же вещи, но с паспортами."
  hint tries 4 say "Одна команда из теории. Ей можно сказать, куда смотреть."
  hint idle 240 say "Команда одна и короткая."

exec finale
