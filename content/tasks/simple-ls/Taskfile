# simple-ls — первая настоящая команда: ls.
# Задание: посмотреть, что лежит в /home/student/room. Приёмка — по выводу ls.

image simple-ls:1

run mkdir -p /home/student/room
run printf 'ковёр\n' > /home/student/room/carpet.txt
run printf 'лампа\n' > /home/student/room/lamp.txt
run printf 'кот\n' > /home/student/room/cat.txt
run chown -R student:student /home/student/room

hidden hp

settings
  pager on

say "Первая команда — самая простая. ls покажет, что вокруг."
read brief.md

stage "Выведите содержимое /home/student/room"
  # observe output неустойчив: ls печатает в колонки в терминал, но построчно в pipe;
  # канон между build (pipe) и runtime (TTY) разъезжается.  Принимаем по ВВОДУ команды --
  # любое естественное действие студента, которое приводит к просмотру содержимого room.
  # варианты «естественного» ввода — любой из них принимаем
  accept cmd "ls /home/student/room"
  accept cmd "ls room"
  accept cmd "cd /home/student/room"
  accept cmd "cd room"
  neutral cat pwd
  on enter say "Загляните внутрь: ls room  (или ls /home/student/room)"
  hint tries 2 say "Просто:  ls room"
  hint idle 25 say "cwd — /home/student.  Внутри есть каталог `room` — покажите его содержимое."

exec finale
