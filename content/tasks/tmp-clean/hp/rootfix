#!/bin/sh
# Корень системы должен принадлежать root. systemd-tmpfiles отказывается идти по пути, где
# каталог обычного пользователя ведёт к каталогу root («unsafe path transition»), а корень
# этой машины достаётся пользователю 1000 от каталога, в котором она собрана. Возвращаем его root,
# иначе правила tmpfiles.d (и при restart, и в проверке) не выполняются вовсе.
chown root:root /
