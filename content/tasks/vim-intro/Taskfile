# vim-intro — vim (исходник docs/Задания «vim intro (24)»): ./task.sh открывает vim -O edit.txt
# true.txt; искажённый отрывок «Онегина» надо исправить, чтобы он совпал с эталоном рядом
# (:diffthis, Ctrl+w l/h — в шапке самого файла), проверка — ./check.sh. В консоли работают только
# ./task.sh, ./check.sh, ls и vimtutor. Принято после выхода из vim, когда файлы совпали.

image vim-intro:1

# vim (и vimtutor) в базе нет.
run apt-get update >/dev/null 2>&1
run DEBIAN_FRONTEND=noninteractive apt-get install -y vim >/dev/null 2>&1
# data: data/vim — edit.txt, true.txt, task.sh, check.sh из исходника
copy data/vim /home/student
run chown student:student /home/student/edit.txt /home/student/task.sh /home/student/check.sh
run chmod 755 /home/student/task.sh /home/student/check.sh
run chown root:root /home/student/true.txt
run chmod 444 /home/student/true.txt

hidden hp

settings
  pager on

say "Те самые три буквы..."
read brief.md

stage
  say "Отредактируй edit.txt, чтобы он в точности совпадал с текстом сбоку. Начни с ./task.sh"
  solve cp /home/student/true.txt /home/student/edit.txt
  check exec same
  allow ./task.sh task.sh ./check.sh check.sh vimtutor
  neutral ls
  on pass say "Вот теперь ты знаешь vim чуть-чуть. Остальное — в vimtutor: семь уроков, по одному в день."
  hint output "Внимательнее, салага!" say "Различия ещё есть. :diffthis в обоих окнах подсветит каждое."
  hint tries 4 say "Как выйти из vim, сохранив оба окна? Посмотри в шапку файла — там всё сказано."
  hint idle 300 say "Застрял? В шапке edit.txt — как сравнить окна, переключиться и выйти."

exec finale
