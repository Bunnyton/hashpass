#!/bin/sh
# lesson FILE (после команды студента в $1) — упражнения урока 1.1 в FILE исправлены: каждая
# строка со стрелкой ---> совпадает со строкой-образцом под ней (хвостовые пробелы не в счёт),
# и стрелок ровно три.
shift          # $1 — последняя команда студента; дальше — аргументы проверки
f=$1
awk '
/^---> / { line = $0; sub(/^---> /, "", line); sub(/[ \t]+$/, "", line); want = 1; arrows++; next }
want {
    sample = $0; sub(/^[ \t]+/, "", sample); sub(/[ \t]+$/, "", sample)
    if (line != sample) bad = 1
    want = 0
}
END { exit (arrows == 3 && !bad) ? 0 : 1 }
' "$f"
