# vim-more — замена :s в vim (исходник it_bastion: vim/20_s «:%s, остановитесь на wonderful»).
# Три конкретные замены, каждая принимается по содержимому файла (observe):
#   1) vim.txt — обернуть в print(data["…"]) слова с Adorable (строка 1) до Wonderful (33):
#      диапазон строк. Строки-инструкции в файле нет: шаблон диапазона (/Adorable/) цеплял её
#      и портил файл — цель звучит в консоли;
#   2) links.txt — все http:// на https:// (в строке бывает до трёх ссылок — нужен флаг g);
#   3) report.py — переименовать переменную cnt в orders_count, не задев cnt_max и
#      discount_cnt: замена с подтверждением, флаг c (доза confirm.md, когда cat покажет
#      испорченное). Границ слова \< \> нет: регулярные выражения в курсе ещё впереди.
# Свои клавиши (nnoremap) — отдельное задание vim-map. Править можно только vim (allow); чистые
# копии — /opt/vim-more.

image vim-more:1

# data: vim.txt — список слов исходника (vim/20_s/vim.txt); links.txt — однократным
# python-скриптом (120 строк, 196 ссылок); report.py — руками
copy data/home /home/student
copy data/home /opt/vim-more
run chown -R student:student /home/student

hidden hp

settings
  pager on

say "vim умеет не только печатать. Он умеет работать за тебя."
read brief.md

stage
  say "В vim.txt оберни слова в print(data["слово"]) — с Adorable до Wonderful включительно, остальные не трогай. Одной командой"
  solve sed -i '1,33s/.*/print(data["&"])/' /home/student/vim.txt
  observe /home/student/vim.txt
  allow vim vi
  neutral ls cat less cd pwd cp
  on pass say "Диапазон, шаблон, замена — и три десятка строк правятся одной командой."
  hint tries 5 say "На какой строке Wonderful? Номер — слева от неё."
  hint tries 10 say "В замене & — это всё найденное. А .* находит всю строку."

stage
  say "В links.txt переведи все ссылки с http:// на https://"
  solve sed -i 's|http://|https://|g' /home/student/links.txt
  observe /home/student/links.txt
  allow vim vi
  neutral ls cat less cd pwd cp
  on pass say "196 ссылок за одну команду. Флаг g — самый частый спутник :%s."
  hint output ", зеркало: http://" say "Первые ссылки в строках заменились, а зеркала — нет. Что заменяет :s в строке по умолчанию?"
  hint tries 5 say "Сравни с cat links.txt: остались ли где-нибудь http://?"
  hint tries 10 say "Флаги замены пишут в самом конце команды — что там говорится про все совпадения в строке?"

stage
  say "В report.py переименуй переменную cnt в orders_count. cnt_max и discount_cnt — другие переменные, их не трогай"
  solve sed -i 's/\bcnt\b/orders_count/g' /home/student/report.py
  observe /home/student/report.py
  allow vim vi
  neutral ls cat less cd pwd cp
  on pass say "y, n, y, n… А с регулярными выражениями vim сам отличит слово cnt от cnt_max — до них ещё дойдём."
  hint output "orders_count_max" read confirm.md
  hint output "discount_orders_count" read confirm.md
  hint tries 5 say "Сравни с cat report.py: не задела ли замена соседние имена?"
  hint tries 10 say "Какой флаг замены заставляет vim спрашивать про каждое совпадение?"

exec finale
