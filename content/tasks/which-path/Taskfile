# which-path — команда это исполняемый файл, найденный по PATH (пользователь, 2026-11-05: «сначала
# с более простого»). Шаги: свой скрипт ~/report (1.0, без x) — в /usr/local/bin и запустить по
# имени (доза why.md: PATH, слева направо) → каталог bin вендора (/opt/acme/report-2.1/bin) — в PATH
# навсегда (path.md: export, ~/.bashrc, source), запустить report-export → report всё ещё 1.0:
# поменять каталоги местами и показать все report по порядку (order.md, type -a; hash.md на «No such
# file») → админ надавал по рукам (admin.md): чужой каталог впереди перебивает системные команды —
# report-export под именем whoami. whoami, а не pwd: pwd встроена в bash, PATH её не перебьёт;
# хуки консоли до runtime 52 зовут ls/cat/stat по имени — их подменять нельзя.
# В /opt/acme ещё report-2.0 и соседи — просто окружение вендора.

image which-path:1

# data: python3 data/gen-opt.py data/opt; data/bin/report — руками
copy data/opt /opt
copy data/bin/report /home/student/report
run chown student:student /home/student/report && chmod 644 /home/student/report && find /opt -path '*/bin/*' -type f -exec chmod 755 {} +

hidden hp

settings
  pager on
  similarity 100

# Удалить лишнюю версию — не решение: задание про то, какую найдёт оболочка (пользователь,
# 2026-11-05: «запрети удаление»).
block rm match "." say "Удалять тут ничего не нужно: пусть все версии живут. Вопрос в том, какую из них оболочка найдёт первой."

say "Коллеги просят отчёт. Скрипт report у тебя уже есть — пора сделать из него настоящую команду."
read brief.md

stage
  say "Положи ~/report в /usr/local/bin и запусти — просто по имени, report"
  solve:
    cp /home/student/report /usr/local/bin/report
    chmod +x /usr/local/bin/report
    report
  accept cmd "report"
  accept output "report 1\.0"
  check live test -x /usr/local/bin/report
  neutral ls pwd cd cat
  on pass read why.md
  hint output "Permission denied" say "Permission denied — или каталог не твой, или файлу не разрешено исполняться. ls -l покажет, что из двух."
  hint output "report: command not found" say "Оболочка ищет команды не везде. Где report лежит сейчас?"
  hint tries 5 say "Какие права у файла в /usr/local/bin? Есть там x?"
  hint tries 10 say "Писать в /usr/local/bin может только root. Как ты уже менял системные каталоги?"

stage
  say "Вендор поставил report 2.1 в /opt/acme/report-2.1 — со своим каталогом bin. Добавь этот bin в PATH — и в новом терминале тоже — и запусти report-export"
  solve:
    echo 'export PATH="$PATH:/opt/acme/report-2.1/bin"' >> /home/student/.bashrc
    export PATH="$PATH:/opt/acme/report-2.1/bin"
    report-export
  accept cmd "report-export"
  accept output "report-export 2\.1"
  check live runuser -u student -- bash -lic 'command -v report-export' >/dev/null 2>&1
  on enter read path.md
  neutral ls pwd cd cat
  on pass say "А теперь набери просто report — какая версия ответит?"
  hint output "report-export: command not found" say "Оболочка ищет только по своему PATH. Что в нём сейчас? А в ~/.bashrc?"
  hint tries 5 say "Что сейчас в PATH этой оболочки — и что окажется в нём у новой?"
  hint tries 10 say "export живёт до выхода из оболочки. Что новая оболочка читает при старте?"

stage
  say "report всё ещё отвечает 1.0, а коллегам нужна 2.1. Поменяй каталоги в PATH местами — и в новом терминале тоже — и покажи все report по порядку"
  solve:
    sed -i 's|export PATH="$PATH:/opt/acme/report-2.1/bin"|export PATH="/opt/acme/report-2.1/bin:$PATH"|' /home/student/.bashrc
    export PATH="/opt/acme/report-2.1/bin:$PATH"
    type -a report
  accept output "\A[^\n]*/opt/acme/report-2\.1/bin/report\b[^\n]*\n(?:[^\n]*\n)*?[^\n]*/usr/local/bin/report"
  check live runuser -u student -- bash -lic 'report --version' 2>/dev/null | grep -q '^report 2\.1'
  block mv match "/usr/local/bin" say "Переносить не нужно: пусть обе версии остаются на своих местах. Вопрос в том, какую оболочка найдёт первой."
  on enter read order.md
  neutral ls pwd cd cat
  on pass say "Порядок в PATH и есть порядок поиска. А версия 1.0 никуда не делась: её по-прежнему можно запустить полным путём."
  hint output "No such file or directory" read hash.md
  hint output "report 1.0" say "Отвечает старая. В каком порядке оболочка перебирает каталоги PATH?"
  hint tries 5 say "Что сейчас в PATH? Где в этом списке должен оказаться каталог с 2.1?"
  hint tries 10 say "В ~/.bashrc уже есть твоя строка. Что в ней поменять, чтобы и новая оболочка ставила 2.1 первой?"

stage
  say "Пусть report-export в bin вендора называется whoami. А теперь спроси у системы, кто ты"
  solve:
    mv /opt/acme/report-2.1/bin/report-export /opt/acme/report-2.1/bin/whoami
    whoami
  accept cmd "whoami"
  accept output "report-export 2\.1"
  on enter read admin.md
  neutral ls pwd cd cat
  on pass say "Вместо тебя отвечает чужой скрипт. Поэтому чужие каталоги дописывают в конец PATH, а впереди системных держат только то, чему доверяют. А вот pwd так не подменить: она встроена в оболочку, и PATH до неё не доходит."
  hint cmd whoami read hash.md
  hint output "Permission denied" say "Каталог вендора принадлежит root. Как ты уже менял системные каталоги?"
  hint tries 5 say "Чем переименовывают файл? Ты уже переносил файлы с места на место."
  hint tries 10 say "Где оболочка ищет whoami раньше — в /usr/bin или в bin вендора? Спроси type -a whoami."

exec finale
