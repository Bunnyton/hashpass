#!/usr/bin/perl
# necromancer — служба-некромант для задания про зомби. Порождает 66 детей; каждый тут же
# завершается, а некромант их не «хоронит» — не вызывает wait(). Пока родитель жив, ядро держит
# от каждого ребёнка запись в таблице процессов: состояние Z, <defunct>. Убить такую запись
# нельзя — процесс уже мёртв; исчезнут они, только когда умрёт родитель: сирот усыновит PID 1
# (systemd) и сам их похоронит.
use strict; use warnings;
$0 = "necromancer";
$SIG{CHLD} = "DEFAULT";      # не IGNORE: иначе ядро хоронит детей само, и зомби не будет
for my $i (1 .. 66) {
    my $pid = fork;
    die "necromancer: fork: $!\n" unless defined $pid;
    if ($pid == 0) { $0 = "zombie"; exit 0 }
    select(undef, undef, undef, 0.05);
}
sleep 3600 while 1;
