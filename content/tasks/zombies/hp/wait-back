#!/bin/sh
# Перед последним шагом: systemd перезапускает necromancer через 15 секунд после смерти. Ждём,
# пока зомби вернутся, чтобы студент увидел их сам (не дольше 40 секунд).
i=0
while [ $i -lt 40 ]; do
    [ "$(ps -eo stat= | grep -c '^Z')" -ge 60 ] && exit 0
    sleep 1; i=$((i + 1))
done
exit 0
