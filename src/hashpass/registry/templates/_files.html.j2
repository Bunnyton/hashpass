{% macro crumbs(ref, ref_q, items) -%}
<nav class='fcrumbs mono' aria-label='Путь'>
<a href='/web/images/source?ref={{ ref_q }}'>{{ ref }}</a>
{% for c in items %}<span class='sep'>/</span>{% if loop.last %}<b>{{ c.name }}</b>{% else %}<a href='/web/images/source?ref={{ ref_q }}&path={{ c.path_q }}'>{{ c.name }}</a>{% endif %}{% endfor %}
</nav>
{%- endmacro %}

{% macro filebox(t) -%}
<div class='filebox'>
<div class='fb-head'>
<span class='fb-title'>{{ icon('dir') }} {{ t.folder or 'Исходники' }}</span>
<span class='fb-meta'>файлов: {{ t.files }}</span>
<a class='btn sm ghost' href='/web/images/source-archive?ref={{ t.ref_q }}'>{{ icon('download') }} Скачать архивом</a>
</div>
<table class='fb-rows'>
{% if t.up_q is not none %}<tr><td class='fb-name' colspan='2'><a href='/web/images/source?ref={{ t.ref_q }}{% if t.up_q %}&path={{ t.up_q }}{% endif %}'>{{ icon('up') }} ..</a></td></tr>{% endif %}
{% for r in t.rows %}
<tr><td class='fb-name'><a href='/web/images/source?ref={{ t.ref_q }}&path={{ r.path_q }}'>{{ icon('dir' if r.dir else 'file') }} <span>{{ r.name }}</span></a></td>
<td class='fb-size'>{{ r.size_ru }}</td></tr>
{% else %}<tr><td class='dim' colspan='2'>папка пуста</td></tr>
{% endfor %}
</table>
</div>
{%- endmacro %}
