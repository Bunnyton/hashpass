{# Copyable shell commands. One install link (user 2026-10-23): the script checks and installs
   the dependencies itself, for the host's package manager and CPU. #}
{% macro cmd(text) -%}
<div class='cmd'><span class='prompt' aria-hidden='true'>$</span><code>{{ text }}</code><button class='sm' onclick='hpcopy(this)' type='button'>копировать</button></div>
{%- endmacro %}
{% macro install_cmd(flags, url, course='') -%}
{{ cmd('curl ' ~ flags ~ ' ' ~ url ~ '/install.sh | bash' ~ ((' -s -- ' ~ course) if course else '')) }}
{%- endmacro %}
{% macro install_steps(flags, url) -%}
<div class='install-one'>
{{ install_cmd(flags, url) }}
<p class='sub small'>Скрипт сам проверит систему и поставит, чего не хватает: Python, git, systemd-nspawn, а на ARM — эмулятор x86. Debian, Ubuntu, Arch, Fedora; sudo спросит пароль.</p>
</div>
{%- endmacro %}
