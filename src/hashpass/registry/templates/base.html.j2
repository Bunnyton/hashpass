<!doctype html>
<html lang='ru'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width,initial-scale=1'>
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
<link rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap'>
<link rel='stylesheet' href='/static/style.css'>
<script src='https://unpkg.com/htmx.org@2.0.4' defer></script>
<title>{{ title }}</title>
{% block head %}{% endblock %}
</head>
<body data-tz='{{ viewer_tz() }}'>
{%- if nav %}
<div class='nav'><span class='brand'><span class='logo'></span>hash<b>pass</b></span>
{%- if courses_on() %}
<a href='/c'{% if active == '/c' %} class='on'{% endif %}>Курсы</a>
{%- endif %}
{%- if viewer_is_staff() %}
<a href='/web'{% if active == '/web' %} class='on'{% endif %}>Прогресс</a>
<a href='/web/images'{% if active == '/web/images' %} class='on'{% endif %}>Образы и каталог</a>
{%- endif %}
{%- if viewer_is_admin() %}
<a href='/web/users'{% if active == '/web/users' %} class='on'{% endif %}>Пользователи</a>
{%- endif %}
<span class='sp'></span><a href='/web/settings'{% if active == '/web/settings' %} class='on'{% endif %}>Настройки</a><a href='/web/logout'>Выход</a></div>
{%- endif %}
<main>{% block main %}{% endblock %}</main>
<script src='/static/time.js'></script>
<script src='/static/sort.js'></script>
</body></html>
