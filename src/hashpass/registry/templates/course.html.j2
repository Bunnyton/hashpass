{% extends 'base.html.j2' %}
{% from '_files.html.j2' import icon %}
{% from '_cards.html.j2' import avatar %}
{% from '_install.html.j2' import cmd, install_cmd %}
{% macro act(method, path, label, cls='menu-item', fields={}, confirm='', then='') -%}
<form class='inline' data-api='{{ method }} {{ path }}'{% if confirm %} data-confirm='{{ confirm }}'{% endif %}{% if then %} data-then='{{ then }}'{% endif %}>
{%- for k, v in fields.items() %}<input type='hidden' name='{{ k }}' value='{{ v }}'{% if v is sameas true or v is sameas false %} data-type='bool'{% elif v is number %} data-type='int'{% endif %}>{% endfor -%}
<button class='{{ cls }}' type='submit'>{{ label }}</button></form>
{%- endmacro %}
{% block main %}
<nav class='crumb' aria-label='Путь'><a href='/c'>← Мои курсы</a></nav>
{% set ref_parts = c.ref.split('/', 1) %}
{% set n_tasks = (c.blocks or []) | map(attribute='tasks') | map('length') | sum %}
<div class='card-hero course-hero'>
<div class='row hero-kind'><span class='kind kind-course'>{{ icon('course') }} курс</span>
{% if c.visibility == 'private' %}<span class='pill closed sm'>приватный</span>{% else %}<span class='pill open sm'>публичный</span>{% endif %}
{% if c.role %}<span class='pill author sm'>{{ role_ru[c.role] }}</span>{% endif %}</div>
<h1>{{ c.title }}</h1>
{% if c.description %}<p class='lead'>{{ c.description }}</p>{% endif %}
<div class='row hero-meta'>
<a class='owner' href='/u/{{ ref_parts[0] | q }}'><span class='avatar xs' aria-hidden='true'>{{ ref_parts[0][:1] | upper }}</span><span class='mono'>{{ ref_parts[0] }}</span></a><span class='mono dim'>/ {{ ref_parts[1] }}</span>
{% if c.blocks is defined %}<span class='dim'>·</span><span class='small'>{{ n_tasks | plural('задание', 'задания', 'заданий') }} в {{ (c.blocks | length) | plural('блоке', 'блоках', 'блоках') }}</span>{% endif %}
{% if may.add %}<span class='dim'>·</span><a class='small' href='#students'>{{ students | length }} {{ students | length | taking }}</a>{% endif %}
</div>
</div>

<div class='card'>
{% if not signed_in %}
<p class='sub'>Чтобы пройти курс, <a href='/web/login?next={{ next_url }}'>войдите</a>.</p>
{% elif not may.view %}
  {% if invite %}
  <p class='sub'>Вас пригласили в этот курс.</p>
  {{ act('POST', api ~ '/join', 'Вступить по приглашению', 'btn', {'invite': invite}) }}
  {% elif c.access == 'requested' %}
  <p class='sub'><span class='pill warn'>заявка отправлена</span> — владелец курса её рассмотрит.</p>
  {% else %}
  <p class='sub'>Курс закрытый. Попросите доступ — владелец или сопровождающий рассмотрят заявку.</p>
  <form class='row' data-api='POST {{ api }}/requests'>
  <input name='comment' placeholder='кто вы, зачем курс (необязательно)'>
  <button type='submit'>Запросить доступ</button>
  </form>
  {% endif %}
{% else %}
  {% if not joined and c.visibility == 'public' and not c.role %}
  {{ act('POST', api ~ '/join', 'Пройти курс', 'btn') }}
  {% endif %}
  <p class='sub small'>Пройти в терминале — курс появится в списке hashpass:</p>
  {{ cmd('hashpass add ' ~ link) }}
  <p class='sub small'>hashpass ещё не установлен? Одной командой — установка и курс:</p>
  {{ install_cmd(curl_flags, pool, link) }}
{% endif %}
</div>

{% if may.view %}
<nav class='tabs' aria-label='Разделы курса'>
<a href='#tasks' data-tab>{{ icon('task') }} Задания <span class='count'>{{ n_tasks }}</span></a>
{% if may.add %}<a href='#students' data-tab>{{ icon('user') }} Проходят курс <span class='count'>{{ students | length }}</span></a>{% endif %}
{% if c.proposals or c.updates %}<a href='#proposals-tab' data-tab>Предложения <span class='count'>{{ (c.proposals | selectattr('state', 'equalto', 'open') | list | length) + (c.updates or []) | length }}</span></a>{% endif %}
{% if may.moderate and c.requests %}<a href='#requests-tab' data-tab>Заявки <span class='count'>{{ c.requests | length }}</span></a>{% endif %}
<a href='#people' data-tab>{{ icon('user') }} Участники <span class='count'>{{ 1 + (c.members or {}) | length }}</span></a>
<a href='#history' data-tab>Изменения <span class='count'>{{ (c.history or []) | length }}</span></a>
{% if may.admin %}<a href='#settings-tab' data-tab>Настройки</a>{% endif %}
</nav>
<section id='tasks' class='tab-panel' aria-label='Задания'>
<div class='cat-head'><h2>Задания</h2>
{% if may.propose %}
<details class='add-menu'>
<summary class='btn ghost'>{% if may.add %}+ Добавить задание{% else %}+ Предложить задание{% endif %}</summary>
<div class='add-panel card'>
<form data-api='POST {{ api }}/tasks'>
<label>Образ — владелец/имя<input name='repo' placeholder='alice/regex' required></label>
<label>Тег<input name='tag' value='1' required></label>
{% if c.blocks %}<label>Куда поставить<select name='place'>
{% for b in c.blocks %}{% set outer = loop %}<optgroup label='{{ b.name }}'>
<option value='{{ b.id }}|^'>в начало блока</option>
{% for t in b.tasks %}<option value='{{ b.id }}|{{ t.ref }}'>после {{ t.ref }}</option>{% endfor %}
<option value='{{ b.id }}'{% if outer.last %} selected{% endif %}>в конец блока</option>
</optgroup>{% endfor %}</select></label>{% endif %}
{% if not may.add %}<label>Комментарий<input name='comment' placeholder='почему это задание'></label>{% endif %}
<p class='sub small'>По умолчанию — последняя версия.{% if not may.add %} Это предложение: решит сопровождающий курса.{% endif %}</p>
<button type='submit'>{% if may.add %}Добавить{% else %}Предложить{% endif %}</button>
</form>
{% if may.moderate %}
<hr class='divider'>
<form data-api='POST {{ api }}/blocks'>
<label>Новый блок<input name='name' placeholder='например, Git'></label>
<button class='ghost' type='submit'>Добавить блок</button>
</form>
{% endif %}
</div>
</details>
{% endif %}
</div>
{% if c.blocks %}
<div id='cat'{% if may.moderate %} data-layout-url='{{ api }}/layout' data-rev='{{ c.rev }}'{% endif %}>
{% for b in c.blocks %}
<div class='block card{% if not b.open %} block-hidden{% endif %}' data-block-id='{{ b.id }}'>
<div class='block-head'>
{% if may.moderate %}
<form class='inline block-rename' data-api='PUT {{ api }}/blocks/{{ b.id }}'>
<input name='name' value='{{ b.name }}' class='block-name-input'></form>
{% else %}<b>{{ b.name }}</b>{% endif %}
{% if not b.open %}<span class='pill closed'>скрыт</span>{% endif %}
<span class='sp'></span>
{% if may.moderate %}
<details class='menu block-menu'><summary class='menu-dot' title='действия с блоком'>⋯</summary>
<div class='menu-list card'>
{{ act('PUT', api ~ '/blocks/' ~ b.id, 'Сделать доступным' if not b.open else 'Скрыть от проходящих курс', fields={'open': not b.open}) }}
{{ act('DELETE', api ~ '/blocks/' ~ b.id, 'Удалить блок', 'menu-item danger', confirm='Удалить пустой блок?') }}
</div></details>
{% endif %}
</div>
<ul class='tasklist' data-block-id='{{ b.id }}'>
{% for t in b.tasks %}
<li class='titem{% if t.hidden %} task-hidden{% endif %}' data-ref='{{ t.ref }}'>
{% if may.moderate %}<span class='grip' title='перетащите'>⠿</span>{% endif %}
{% set rp = t.revision.rpartition('_v') %}<span class='tref has-tip'><a class='mono ref' href='/web/image/{{ t.revision | ref_url }}' aria-describedby='tip-{{ loop.index }}-{{ b.id }}'>{{ rp[0] }}</a> <span class='pill sm ver'>версия {{ rp[2] }}</span>{% if t.at %} <span class='small dim'>обновлено {{ ago(t.at) }}</span>{% endif %}
<span class='tip card' role='tooltip' id='tip-{{ loop.index }}-{{ b.id }}'><span class='kind kind-task'>{{ icon('task') }} задание</span><b class='mono'>{{ rp[0] }}</b><span class='sub small'>{{ t.about or 'без описания' }}</span><a class='small' href='/web/image/{{ t.revision | ref_url }}'>открыть задание →</a></span></span>
{% if t.hidden %}<span class='pill closed sm'>скрыто</span>{% endif %}
{% if t.latest and t.latest > t.n %}<span class='pill warn sm'>есть версия {{ t.latest }}</span>{% endif %}
<span class='sp'></span>
{% if may.moderate or (may.add and t.added_by == signed_in) %}
<details class='menu task-menu'><summary class='menu-dot' title='действия'>⋯</summary>
<div class='menu-list card'>
{% if may.moderate %}
{{ act('PUT', api ~ '/tasks/' ~ t.ref, '↑ Выше', fields={'move': -1}) }}
{{ act('PUT', api ~ '/tasks/' ~ t.ref, '↓ Ниже', fields={'move': 1}) }}
{{ act('PUT', api ~ '/tasks/' ~ t.ref, 'Показать' if t.hidden else 'Скрыть', fields={'hidden': not t.hidden}) }}
{% endif %}
{% if t.latest and t.latest > t.n %}{{ act('PUT', api ~ '/tasks/' ~ t.ref, 'Обновить до v' ~ t.latest, fields={'n': t.latest}) }}{% endif %}
{% if may.moderate %}{{ act('DELETE', api ~ '/tasks/' ~ t.ref, 'Убрать из курса', 'menu-item danger', confirm='Убрать задание из курса?') }}{% endif %}
</div></details>
{% endif %}
</li>
{% endfor %}
</ul>
</div>
{% endfor %}
</div>
{% else %}
<div class='empty card'><p class='sub'>Заданий пока нет.</p></div>
{% endif %}

</section>
<section id='proposals-tab' class='tab-panel' aria-label='Предложения'>
{% if c.proposals or c.updates %}
<h2 id='proposals'>Предложения</h2>
<div class='card'>
<table>
<tr><th>Что</th><th>Версия</th><th>Кто</th><th>Комментарий</th><th>Состояние</th><th></th></tr>
{% for p in c.updates or [] %}
<tr><td>обновить</td><td class='mono'>{{ p.repo }}:{{ p.tag }} → версия {{ p.latest }}</td><td>—</td><td class='sub small'>вышла новая версия</td><td><span class='pill warn sm'>ждёт</span></td>
<td>{{ act('PUT', api ~ '/tasks/' ~ p.repo ~ ':' ~ p.tag, 'Обновить', 'sm', {'n': p.latest}) }}</td></tr>
{% endfor %}
{% for p in c.proposals | reverse %}
<tr><td>{{ {'add': 'добавить', 'update': 'обновить', 'restore': 'вернуть'}[p.kind] }}</td>
<td class='mono'><a href='/web/image/{{ (p.repo ~ ":" ~ p.tag ~ "_v" ~ p.n) | ref_url }}'>{{ (p.repo ~ ':' ~ p.tag ~ '_v' ~ p.n) | ver }}</a></td>
<td>{{ p.by }}</td><td class='sub small'>{{ p.comment }}{% if p.reason %}<br>причина: {{ p.reason }}{% endif %}</td>
<td>{% if p.state == 'open' %}<span class='pill warn sm'>открыто</span>{% elif p.state == 'accepted' %}<span class='pill open sm'>принято</span>{% elif p.state == 'rejected' %}<span class='pill no sm'>отклонено</span>{% else %}<span class='pill sm'>отозвано</span>{% endif %}</td>
<td class='row'>{% if p.state == 'open' %}
{% if may.moderate %}{{ act('POST', api ~ '/proposals/' ~ p.id, 'Принять', 'sm', {'action': 'accept'}) }}
<form class='inline row' data-api='POST {{ api }}/proposals/{{ p.id }}'><input type='hidden' name='action' value='reject'>
<input name='reason' placeholder='причина' class='sm'><button class='sm ghost' type='submit'>Отклонить</button></form>{% endif %}
{% if p.by == signed_in %}{{ act('POST', api ~ '/proposals/' ~ p.id, 'Отозвать', 'sm ghost', {'action': 'withdraw'}) }}{% endif %}
{% endif %}</td></tr>
{% endfor %}
</table>
</div>
{% endif %}

</section>
<section id='requests-tab' class='tab-panel' aria-label='Заявки'>
{% if may.moderate and c.requests %}
<h2 id='requests'>Заявки на доступ</h2>
<div class='card'><table>
<tr><th>Кто</th><th>Комментарий</th><th>Когда</th><th></th></tr>
{% for r in c.requests %}
<tr><td><a href='/web/user/{{ r.user | q }}'>{{ r.user }}</a></td><td class='sub small'>{{ r.comment }}</td><td>{{ ts(r.at) }}</td>
<td class='row'>{{ act('POST', api ~ '/requests/' ~ r.user, 'Принять', 'sm', {'accept': true}) }}{{ act('POST', api ~ '/requests/' ~ r.user, 'Отклонить', 'sm ghost', {'accept': false}) }}</td></tr>
{% endfor %}
</table></div>
{% endif %}

</section>
<section id='people' class='tab-panel' aria-label='Участники'>
<h2>Участники</h2>
<div class='card'>
<ul class='people'>
<li><a class='person' href='/u/{{ ref_parts[0] | q }}'>{{ avatar(ref_parts[0], 'sm') }}<span class='mono'>{{ ref_parts[0] }}</span></a><span class='pill sm author'>владелец</span></li>
{% for user, role in (c.members or {}).items() %}
<li><a class='person' href='/u/{{ user | q }}'>{{ avatar(user, 'sm') }}<span class='mono'>{{ user }}</span></a>
{% if may.admin %}
<form class='inline row' data-api='PUT {{ api }}/members/{{ user | q }}'>
<label class='visually-hidden' for='crole-{{ loop.index }}'>Роль {{ user }}</label>
<select id='crole-{{ loop.index }}' name='role'>{% for r in ['member', 'author', 'maintainer'] %}<option value='{{ r }}'{% if r == role %} selected{% endif %}>{{ role_ru[r] }}</option>{% endfor %}</select>
<button class='sm ghost' type='submit'>Сохранить</button></form>
{{ act('DELETE', api ~ '/members/' ~ (user | q), 'Убрать', 'sm danger', confirm='Убрать ' ~ user ~ ' из участников?') }}
{% else %}<span class='pill sm'>{{ role_ru[role] }}</span>{% endif %}
</li>
{% endfor %}
</ul>
{% if may.admin %}
<hr class='divider'>
<form class='row' data-api='PUT {{ api }}/members/__LOGIN__'>
<label class='visually-hidden' for='new-cmember'>Логин</label>
<input id='new-cmember' name='__login' placeholder='логин пользователя' required>
<label class='visually-hidden' for='new-crole'>Роль</label>
<select id='new-crole' name='role'><option value='member'>участник — проходит приватный курс</option><option value='author' selected>автор — добавляет задания</option><option value='maintainer'>сопровождающий — решает предложения и заявки</option></select>
<button class='sm' type='submit'>Добавить</button>
</form>
<p class='sub small'>Ссылка-приглашение — кто откроет её и войдёт, станет участником: <code class='copy'>{{ invite_link }}</code></p>
{{ act('PUT', api, 'Сменить ссылку (старая перестанет работать)', 'sm ghost', {'rotate_invite': true}) }}
{% endif %}
<p class='sub small'>Автор добавляет задания сам и обновляет свои; сопровождающий ещё решает предложения и заявки, правит блоки и порядок; владелец — настройки и участники.</p>
</div>
</section>
<section id='history' class='tab-panel' aria-label='Изменения в курсе'>
<h2>Изменения в курсе</h2>
{% if c.history %}
<ol class='commits card'>
{% for h in c.history %}
<li class='commit'>
<div class='commit-main'>
<span class='msg'>{{ h.what }}</span>{% if h.comment %} <span class='why'>«{{ h.comment }}»</span>{% endif %}
<div class='sub small'><a class='who' href='/u/{{ h.by | q }}'>{{ avatar(h.by, 'xs') }}<span class='mono'>{{ h.by }}</span></a> · {{ ts(h.at) }}</div>
</div>
</li>
{% endfor %}
</ol>
{% else %}<div class='empty card'><p class='sub'>Изменений пока не было.</p></div>{% endif %}
</section>
{% if may.add %}
<section id='students' class='tab-panel' aria-label='Проходят курс'>
<div class='cat-head'><h2>Проходят курс <span class='count-pill'>{{ students | length }}</span></h2></div>
{% if students %}
<div class='card'>
<div class='row students-tools'>
<label class='visually-hidden' for='student-q'>Найти среди проходящих курс</label>
<input id='student-q' type='search' placeholder='найти по логину или приватному комментарию' data-filter='#student-rows tr'>
<span class='sub small legend'><span class='cell passed'>✓</span> решено <span class='cell started'>◐</span> начато <span class='cell none'>·</span> не начато</span>
</div>
<div class='table-wrap'>
<table class='sortable students'>
<thead><tr><th scope='col'>Кто</th><th scope='col'>Прогресс</th><th scope='col' data-nosort>По заданиям</th></tr></thead>
<tbody id='student-rows'>
{% for s in students %}
<tr data-text='{{ s.user }} {{ s.comment }}'>
<td><a class='mono' href='/c/{{ c.ref }}/u/{{ s.user | q }}'>{{ s.user }}</a>{% if s.comment %}<div class='sub small'>{{ s.comment }}</div>{% endif %}</td>
<td data-sort='{{ s.done }}'><div class='progress' role='progressbar' aria-valuemin='0' aria-valuemax='{{ s.total }}' aria-valuenow='{{ s.done }}' aria-label='решено {{ s.done }} из {{ s.total }}'><span style='width:{{ s.pct }}%'></span></div><span class='small num'>{{ s.done }} / {{ s.total }}</span></td>
<td><div class='cells'>{% for x in s.cells %}<a class='cell {{ x.cls }}' href='/c/{{ c.ref }}/u/{{ s.user | q }}#t{{ x.n }}' title='№{{ x.n }} {{ x.ref }} — {{ x.word }}{% if x.about %}. {{ x.about }}{% endif %}' aria-label='задание {{ x.n }}, {{ x.ref }}: {{ x.word }}'>{{ x.mark }}</a>{% endfor %}</div></td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
<p class='sub small'>Логин — его задания в этом курсе: попытки, время, история команд.</p>
</div>
{% else %}<div class='empty card'><p class='sub'>Курс пока никто не проходит. Поделитесь ссылкой: <code class='copy'>{{ link }}</code></p></div>{% endif %}
</section>
{% endif %}

{% if may.admin %}
<section id='settings-tab' class='tab-panel' aria-label='Настройки'>
<h2 id='settings'>Настройки</h2>
<div class='card'>
<form data-api='PUT {{ api }}' data-rev='{{ c.rev }}'>
<label>Название<input name='title' value='{{ c.title }}'></label>
<label>Описание<textarea name='description' rows='3'>{{ c.description }}</textarea></label>
<label>Видимость<select name='visibility'>
<option value='public'{% if c.visibility == 'public' %} selected{% endif %}>публичный</option>
<option value='private'{% if c.visibility == 'private' %} selected{% endif %}>приватный</option></select></label>
<label class='check'><input type='checkbox' name='auto_update' data-type='bool'{% if c.settings.auto_update %} checked{% endif %}> Автообновление: задания сами переходят на новые версии</label>
<label class='check'><input type='checkbox' name='auto_accept' data-type='bool'{% if c.settings.auto_accept %} checked{% endif %}> Принимать предложения сразу</label>
<button type='submit'>Сохранить</button>
</form>
<hr class='divider'>
{{ act('DELETE', api, 'Удалить курс', 'sm danger', confirm='Удалить курс насовсем? Задания и образы останутся — удалится только курс.', then='go:/c') }}
</div>
</section>
{% endif %}
{% endif %}
<script src='/static/api.js'></script>
<script src='/static/filter.js'></script>
{% if may.moderate %}<script src='/static/catalog.js'></script>{% endif %}
{% endblock %}
