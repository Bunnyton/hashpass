{% extends 'base.html.j2' %}
{% from '_files.html.j2' import icon %}
{% from '_cards.html.j2' import avatar %}
{% from '_install.html.j2' import cmd, install_cmd %}
{% macro eye(url, field, shown, what) -%}
{#- one click: visible <-> hidden, in place (user 2026-11-06: «сделай удобнее … сокрытием тасков») -#}
<button type='button' class='icon-btn eye' data-toggle-url='{{ url }}' data-field='{{ field }}' aria-pressed='{{ 'false' if shown else 'true' }}' aria-label='{{ ('Скрыть ' if shown else 'Показать ') ~ what }}' title='{{ 'Скрыть от проходящих курс' if shown else 'Скрыто — показать проходящим курс' }}'><svg class='i-eye' viewBox='0 0 24 24' width='18' height='18' aria-hidden='true'><path d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z'/><circle cx='12' cy='12' r='3'/></svg> <svg class='i-eyeoff' viewBox='0 0 24 24' width='18' height='18' aria-hidden='true'><path d='M17.94 17.94A10.07 10.07 0 0 1 12 19c-6.5 0-10-7-10-7a18.5 18.5 0 0 1 5.06-5.94'/><path d='M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19'/><path d='M14.12 14.12a3 3 0 1 1-4.24-4.24'/><path d='M2 2l20 20'/></svg></button>
{%- endmacro %}
{% macro act(method, path, label, cls='menu-item', fields={}, confirm='', then='') -%}
<form class='inline' data-api='{{ method }} {{ path }}'{% if confirm %} data-confirm='{{ confirm }}'{% endif %}{% if then %} data-then='{{ then }}'{% endif %}>
{%- for k, v in fields.items() %}<input type='hidden' name='{{ k }}' value='{{ v }}'{% if v is sameas true or v is sameas false %} data-type='bool'{% elif v is number %} data-type='int'{% endif %}>{% endfor -%}
<button class='{{ cls }}' type='submit'>{{ label }}</button></form>
{%- endmacro %}
{% macro needs_picker(current, task_refs, skip_block='', skip_ref='') -%}
{# user 2026-11-05: a block or a task opens once particular blocks AND tasks are solved #}
<span class='small dim'>Блоки:</span>
{% for x in c.blocks if x.id != skip_block %}<label class='chip'><input type='checkbox' name='needs' value='{{ x.id }}' data-type='list'{% if x.id in (current or []) %} checked{% endif %}>{{ x.name }}</label>{% endfor %}
<details class='needs-tasks'><summary class='small'>Задания{% set picked = (current or []) | select('in', task_refs) | list %}{% if picked %} — выбрано {{ picked | length }}{% endif %}</summary>
{% for x in c.blocks if x.id != skip_block %}{% if x.tasks %}<div class='needs-group'><span class='small dim'>{{ x.name }}:</span>
{% for t2 in x.tasks if t2.ref != skip_ref %}<label class='chip'><input type='checkbox' name='needs' value='{{ t2.ref }}' data-type='list'{% if t2.ref in (current or []) %} checked{% endif %}>{{ t2.repo.rpartition('/')[2] }}</label>{% endfor %}</div>{% endif %}{% endfor %}
</details>
{%- endmacro %}
{% macro need_names(needs, block_names) -%}
{% for i in needs %}«{{ block_names.get(i) or i.partition(':')[0].rpartition('/')[2] }}»{% if not loop.last %}, {% endif %}{% endfor %}
{%- endmacro %}
{% macro order_switch(label, on, fields, hint) -%}
{# user 2026-11-05: one switch opens blocks (or a block's tasks) one after another #}
<form class='inline order-switch' data-api='PUT {{ api }}/order'>
{%- for k, v in fields.items() %}<input type='hidden' name='{{ k }}' value='{{ v }}'{% if v is sameas true or v is sameas false %} data-type='bool'{% endif %}>{% endfor -%}
<button class='switch{% if on %} on{% endif %}' type='submit' role='switch' aria-checked='{{ 'true' if on else 'false' }}' title='{{ hint }}'><span class='knob' aria-hidden='true'></span>{{ label }}</button></form>
{%- endmacro %}
{% macro join_form(label, fields={}) -%}
<form class='join-form' data-api='POST {{ api }}/join'>
{%- for k, v in fields.items() %}<input type='hidden' name='{{ k }}' value='{{ v }}'>{% endfor %}
<label for='join-comment'>Хотите добавить комментарий, который увидят авторы и админы курса? <span class='dim'>Необязательно.</span></label>
<textarea id='join-comment' name='comment' rows='2' maxlength='500' placeholder='например: Иванов И., группа ИУ7-31'></textarea>
<button class='btn' type='submit'>{{ label }}</button>
</form>
{%- endmacro %}
{% macro invited_box() -%}
<p class='sub'><span class='pill open'>приглашение</span> <a class='mono' href='/u/{{ c.invited.by | q }}'>{{ c.invited.by }}</a> приглашает вас в этот курс.</p>
{{ join_form('Принять приглашение') }}
{{ act('DELETE', api ~ '/invites/' ~ (signed_in | q), 'Отклонить', 'sm ghost', confirm='Отклонить приглашение?') }}
{%- endmacro %}
{% macro invite_card() -%}
<div class='card invite-card'>
<h3>Пригласить в курс</h3>
<p class='sub small'>Ссылка-приглашение: кто откроет её и войдёт, станет участником курса{% if c.visibility == 'private' %} — даже приватного{% endif %}.</p>
<div class='row'><code class='copy'>{{ invite_link }}</code>
{{ act('PUT', api, 'Сменить ссылку', 'sm ghost', {'rotate_invite': true}, confirm='Старая ссылка перестанет работать. Сменить?') }}</div>
<form class='invite-add' data-api='POST {{ api }}/invites' data-user-search>
<label for='invite-q'>Или пригласите сами — начните вводить логин:</label>
<div class='user-search'><input id='invite-q' type='search' autocomplete='off' placeholder='логин пользователя' aria-autocomplete='list' aria-controls='invite-hits'>
<ul id='invite-hits' class='user-hits' role='listbox' hidden></ul></div>
<div class='user-picked' aria-live='polite'></div>
<input type='hidden' name='users' value=''>
<button class='sm' type='submit'>Пригласить</button>
</form>
<p class='sub small'>Приглашённый станет участником, когда примет приглашение — на странице курса, в «Моих курсах» или в hashpass.</p>
{% if waiting %}
<h4 class='team-sub'>Ждут ответа <span class='count-pill'>{{ waiting | length }}</span></h4>
<ul class='people waiting'>{% for w in waiting %}<li class='member'><div class='member-head'><a class='person' href='/u/{{ w.user | q }}'><span class='mono'>{{ w.user }}</span></a>
<span class='small dim'>пригласил {{ w.by }}{% if w.at %}, {{ ago(w.at) }}{% endif %}</span>
{{ act('DELETE', api ~ '/invites/' ~ (w.user | q), 'Отозвать', 'sm ghost', confirm='Отозвать приглашение ' ~ w.user ~ '?') }}</div></li>{% endfor %}</ul>
{% endif %}
</div>
{%- endmacro %}
{% block main %}
{% set block_names = {} %}{% set task_refs = [] %}{% for x in (c.blocks or []) %}{% set _ = block_names.update({x.id: x.name}) %}{% for t2 in x.tasks %}{% set _ = task_refs.append(t2.ref) %}{% endfor %}{% endfor %}
<nav class='crumb' aria-label='Путь'><a href='/c'>← Мои курсы</a></nav>
{% set ref_parts = c.ref.split('/', 1) %}
{% set n_tasks = (c.blocks or []) | map(attribute='tasks') | map('length') | sum %}
<div class='card-hero course-hero'>
<div class='row hero-kind'><span class='kind kind-course'>{{ icon('course') }} курс</span>
{% if c.visibility == 'private' %}<span class='pill closed sm'>приватный</span>{% else %}<span class='pill open sm'>публичный</span>{% endif %}
{% if c.role %}<span class='pill author sm'>{{ role_ru[c.role] }}</span>{% endif %}</div>
<h1>{{ c.title }}</h1>
{% if c.origin %}{% set o = c.origin %}<p class='origin sub'>{% if o.gone %}На основе курса{% elif o.kind == 'mirror' %}Зеркало курса{% else %}Форк курса{% endif %} {% if o.linked %}<a href='/c/{{ o.ref }}'>{{ o.title }}</a>{% else %}<b>{{ o.title }}</b>{% endif %} от <a href='/u/{{ o.owner | q }}'>{{ o.owner }}</a>{% if o.gone %} (удалён){% endif %}</p>{% endif %}
{% if c.description %}<p class='lead'>{{ c.description }}</p>{% endif %}
<div class='row hero-meta'>
<a class='owner' href='/u/{{ ref_parts[0] | q }}'><span class='avatar xs' aria-hidden='true'>{{ ref_parts[0][:1] | upper }}</span><span class='mono'>{{ ref_parts[0] }}</span></a><span class='mono dim'>/ {{ ref_parts[1] }}</span>
{% if c.blocks is defined %}<span class='dim'>·</span><span class='small'>{{ n_tasks | plural('задание', 'задания', 'заданий') }} в {{ (c.blocks | length) | plural('блоке', 'блоках', 'блоках') }}</span>{% endif %}
{% if c.copies and (c.copies.mirrors or c.copies.forks) %}<span class='dim'>·</span><a class='small' href='#copies-tab'>Зеркала: {{ c.copies.mirrors }} · Форки: {{ c.copies.forks }}</a>{% endif %}
{% if c.blocks is defined %}<span class='dim'>·</span><a class='small' href='/c/{{ c.ref }}/wiki'>Wiki курса</a>{% endif %}
{% if may.students %}<span class='dim'>·</span><a class='small' href='#students'>{{ students | length | plural('участник', 'участника', 'участников') }}</a>{% endif %}
</div>
</div>

<div class='card'>
{% if not signed_in %}
<p class='sub'>Чтобы пройти курс, <a href='/web/login?next={{ next_url }}'>войдите</a>.</p>
{% elif not may.view %}
  {% if c.invited %}
  {{ invited_box() }}
  {% elif invite %}
  <p class='sub'>Вас пригласили в этот курс по ссылке.</p>
  {{ join_form('Вступить по приглашению', {'invite': invite}) }}
  {% elif c.access == 'requested' %}
  <p class='sub'><span class='pill warn'>заявка отправлена</span> — владелец курса её рассмотрит.</p>
  {% else %}
  <p class='sub'>Курс закрытый. Попросите доступ — владелец или админ курса рассмотрят заявку.</p>
  <form class='row' data-api='POST {{ api }}/requests'>
  <input name='comment' placeholder='кто вы, зачем курс (необязательно)'>
  <button type='submit'>Запросить доступ</button>
  </form>
  {% endif %}
{% else %}
  {% if c.invited %}
  {{ invited_box() }}
  {% elif not joined and c.visibility == 'public' and not c.role %}
  {{ join_form('Пройти курс') }}
  {% endif %}
  <p class='sub small'>Пройти в терминале — курс появится в списке hashpass:</p>
  {{ cmd('hashpass add ' ~ link) }}
  <p class='sub small'>hashpass ещё не установлен? Одной командой — установка и курс:</p>
  {{ install_cmd(curl_flags, pool, link) }}
  {% if copy.may_mirror or copy.may_fork %}
  {% macro copy_form(kind, label, hint) %}
  <details class='add-menu copy-menu'><summary class='btn ghost'>{{ label }}</summary>
  <div class='add-panel card'>
  <form data-api='POST {{ api }}/{{ kind }}' data-then='go:/c/{ref}'>
  <p class='sub small'>{{ hint }}</p>
  <label>Адрес <span class='sub small'>/c/{{ signed_in }}/…, латиница, цифры, дефис</span><input name='name' required pattern='[a-z0-9][a-z0-9\-]{0,63}' value='{{ c.name }}'></label>
  <label>Название<input name='title' value='{{ c.title }}'></label>
  {% if copy.source_private %}<input type='hidden' name='visibility' value='private'><p class='sub small'>Копия приватного курса — тоже приватная.</p>
  {% else %}<label>Видимость<select name='visibility'><option value='public'>публичный</option><option value='private'>приватный</option></select></label>{% endif %}
  <button type='submit'>{{ label }}</button>
  </form></div></details>
  {% endmacro %}
  <div class='row copy-actions'>
  {% if copy.may_mirror %}{{ copy_form('mirror', 'Сделать зеркало', 'Зеркало: задания и порядок всегда как в этом курсе и сами обновляются, а ученики, приглашения и прогресс — ваши.') }}{% endif %}
  {% if copy.may_fork %}{{ copy_form('fork', 'Форкнуть курс', 'Форк: ваша копия — меняйте задания как хотите. Изменения этого курса подтягиваются по кнопке, свои можно предложить сюда.') }}{% endif %}
  </div>
  {% endif %}
{% endif %}
</div>

{% if may.view %}
<nav class='tabs' aria-label='Разделы курса'>
<a href='#tasks' data-tab>{{ icon('task') }} Задания <span class='count'>{{ n_tasks }}</span></a>
{% if may.people and not may.students %}<a href='#invite-tab' data-tab>{{ icon('user') }} Пригласить</a>{% endif %}
{% if may.students %}<a href='#students' data-tab>{{ icon('user') }} Участники курса <span class='count'>{{ students | length }}</span></a>{% endif %}
{% if c.proposals or c.updates %}<a href='#proposals-tab' data-tab>Предложения <span class='count'>{{ (c.proposals | selectattr('state', 'equalto', 'open') | list | length) + (c.updates or []) | length }}</span></a>{% endif %}
{% if may.people and c.requests %}<a href='#requests-tab' data-tab>Заявки <span class='count'>{{ c.requests | length }}</span></a>{% endif %}
<a href='#people' data-tab>{{ icon('user') }} Команда курса <span class='count'>{{ 1 + (c.members or {}) | length }}</span></a>
{% if copy.merges %}<a href='#merges-tab' data-tab>Запросы слияния <span class='count'>{{ copy.merges | selectattr('state', 'equalto', 'open') | list | length }}</span></a>{% endif %}
{% if c.copies and c.copies.list %}<a href='#copies-tab' data-tab>Копии <span class='count'>{{ c.copies.list | length }}</span></a>{% endif %}
<a href='#history' data-tab>Изменения <span class='count'>{{ (c.history or []) | length }}</span></a>
{% if may.content %}<a href='#settings-tab' data-tab>Настройки</a>{% endif %}
</nav>
<section id='tasks' class='tab-panel' aria-label='Задания'>
{% if c.origin and c.origin.revoked and copy.mirror %}
<div class='card notice bad'><b>Доступ к исходному курсу закрыт</b><p class='sub small'>У владельца зеркала больше нет доступа к курсу {{ c.origin.title }} — задания этого зеркала недоступны, пока доступ не вернут.</p></div>
{% elif copy.mirror and may.content %}
<p class='sub small'>Задания и их порядок — как в исходном курсе, они обновляются сами. Здесь можно открывать и закрывать блоки для своей группы.</p>
{% endif %}
{% if copy.sync %}
<div class='card notice'>
{% if copy.sync.changes %}
<b>В исходном курсе есть изменения: {{ copy.sync.changes | length }}</b>
<ul class='small'>{% for t in copy.sync.changes %}<li>{{ t }}</li>{% endfor %}</ul>
{% if copy.sync.conflicts %}<p class='sub small'>Не подтянется — у вас здесь своё:</p><ul class='small'>{% for t in copy.sync.conflicts %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
{{ act('POST', api ~ '/sync', 'Подтянуть изменения', 'btn') }}
{% else %}
{% set r = copy.my_request %}
{% if r and r.state == 'open' %}<p class='sub'><span class='pill warn sm'>Запрос в исходный курс открыт</span>{% if r.stale %} — исходный курс изменился: подтяните изменения и обновите запрос{% endif %}</p>
{% elif r and r.state == 'merged' %}<p class='sub'><span class='pill open sm'>Исходный курс принял ваши изменения</span></p>
{% elif r and r.state == 'rejected' %}<p class='sub'><span class='pill no sm'>Запрос отклонён</span>{% if r.reason %} — {{ r.reason }}{% endif %}</p>{% endif %}
<form class='row' data-api='POST {{ api }}/merge'>
<input name='comment' placeholder='что изменили и зачем'>
<button class='ghost' type='submit'>{% if r and r.state == 'open' %}Обновить запрос{% else %}Предложить в исходный курс{% endif %}</button>
</form>
{% endif %}
</div>
{% endif %}
<div class='cat-head'><h2>Задания</h2>
{% if may.propose %}
<details class='add-menu'>
<summary class='btn ghost'>{% if may.add %}+ Добавить задание{% else %}+ Предложить задание{% endif %}</summary>
<div class='add-panel card'>
<form data-api='POST {{ api }}/tasks'>
<label>Образ — владелец/имя<input name='repo' placeholder='alice/regex' required></label>
<label>Тег<input name='tag' value='1' required></label>
{% if c.blocks %}<label>Куда поставить<select name='place'>
{% for b in c.blocks %}{% set outer = loop %}<optgroup label='{{ b.name }}'>
<option value='{{ b.id }}|^'>в начало блока</option>
{% for t in b.tasks %}<option value='{{ b.id }}|{{ t.ref }}'>после {{ t.ref }}</option>{% endfor %}
<option value='{{ b.id }}'{% if outer.last %} selected{% endif %}>в конец блока</option>
</optgroup>{% endfor %}</select></label>{% endif %}
{% if not may.add %}<label>Комментарий<input name='comment' placeholder='почему это задание'></label>{% endif %}
<p class='sub small'>По умолчанию — последняя версия.{% if not may.add %} Это предложение: решит админ курса.{% endif %}</p>
<button type='submit'>{% if may.add %}Добавить{% else %}Предложить{% endif %}</button>
</form>
{% if may.content %}
<hr class='divider'>
<form data-api='POST {{ api }}/blocks'>
<label>Новый блок<input name='name' placeholder='например, Git'></label>
<button class='ghost' type='submit'>Добавить блок</button>
</form>
{% endif %}
</div>
</details>
{% endif %}
</div>
{% if c.blocks %}
{% if may.edit and c.blocks | length > 1 %}
<div class='card order-card'>
<div class='order-head'><div><b>Порядок открытия</b>
<p class='sub small'>{% if c.blocks_in_order %}Каждый блок откроется, когда решён предыдущий (скрытые и пустые цепочка пропускает). Новые и переставленные блоки встают в цепочку сами.{% else %}Блоки открыты сразу — кроме тех, где задано своё условие. Задания внутри блока — переключатель в самом блоке.{% endif %}</p></div>
<span class='sp'></span>
{{ order_switch('Блоки по порядку', c.blocks_in_order, {'blocks': not c.blocks_in_order}, 'Снять порядок: блоки откроются сразу' if c.blocks_in_order else 'Каждый блок откроется, когда решён предыдущий') }}</div>
<ol class='order-flow{% if c.blocks_in_order %} chained{% endif %}' aria-label='что после чего открывается'>
{% for b in c.blocks %}{% set own = (b.needs or []) | reject('equalto', b.after) | list %}<li class='flow-step{% if not b.open %} off{% endif %}'><a class='flow-chip' href='#blk-{{ b.id }}'{% if not b.open %} title='скрыт от проходящих курс'{% endif %}>{{ b.name }} <span class='dim'>{{ b.tasks | length }}</span>{% if b.tasks_in_order %} <span title='задания по порядку'>⇣</span>{% endif %}{% if own %} <span title='своё условие: {{ need_names(own, block_names) }}'>🔒</span>{% endif %}</a></li>{% endfor %}
</ol>
</div>
{% endif %}
<div id='cat'{% if may.edit %} data-layout-url='{{ api }}/layout' data-rev='{{ c.rev }}'{% if c.blocks_in_order or c.blocks | selectattr('tasks_in_order') | list %} data-chained='1'{% endif %}{% endif %}>
{% for b in c.blocks %}
<div class='block card{% if not b.open %} block-hidden{% endif %}' id='blk-{{ b.id }}' data-block-id='{{ b.id }}'>
<div class='block-head'>
{% if may.edit %}
<form class='inline block-rename' data-api='PUT {{ api }}/blocks/{{ b.id }}'>
<input name='name' value='{{ b.name }}' class='block-name-input'></form>
{% else %}<b>{{ b.name }}</b>{% endif %}
{% if not b.open %}<span class='pill closed'>скрыт</span>{% endif %}
{% if b.tasks | selectattr('has_wiki') | list %}<a class='small' href='/c/{{ c.ref }}/wiki?block={{ b.id }}'>wiki</a>{% endif %}
{% if b.needs and may.content %}{% set own = b.needs | reject('equalto', b.after) | list %}
{% if b.after %}<span class='pill chain sm' title='блоки по порядку'>⤷ после «{{ block_names.get(b.after, b.after) }}»</span>{% endif %}
{% if own %}<span class='pill warn sm'>🔒 откроется после: {{ need_names(own, block_names) }}</span>{% endif %}
{% elif b.waiting_for %}<span class='pill warn sm'>🔒 откроется, когда решите: {% for n in b.waiting_for %}«{{ n }}»{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
<span class='sp'></span>
{% if may.content %}{{ eye(api ~ '/blocks/' ~ b.id, 'open', b.open, 'блок «' ~ b.name ~ '»') }}{% endif %}
{% if may.edit and b.tasks | length > 1 %}{{ order_switch('Задания по порядку', b.tasks_in_order, {'block': b.id, 'tasks': not b.tasks_in_order}, 'Снять порядок: задания блока откроются сразу' if b.tasks_in_order else 'Каждое задание блока откроется, когда решено предыдущее') }}{% endif %}
{% if may.content %}
<details class='menu block-menu'><summary class='menu-dot' title='действия с блоком'>⋯</summary>
<div class='menu-list card'>
{% if may.edit and c.blocks | length > 1 %}<form class='block-needs' data-api='PUT {{ api }}/blocks/{{ b.id }}'>
<span class='small dim'>Откроется, когда решено:</span>
{% if c.blocks_in_order %}<span class='small dim'>Блоки идут по порядку — предыдущий блок ставится сам; другие блоки здесь не нужны.</span>{% endif %}
{{ needs_picker(b.needs, task_refs, skip_block=b.id) }}
<button class='menu-item' type='submit'>Сохранить условие</button></form>{% endif %}
{% if may.edit %}{{ act('DELETE', api ~ '/blocks/' ~ b.id, 'Удалить блок', 'menu-item danger', confirm='Удалить пустой блок?') }}{% endif %}
</div></details>
{% endif %}
</div>
<ul class='tasklist' data-block-id='{{ b.id }}'>
{% for t in b.tasks %}
<li class='titem{% if t.hidden %} task-hidden{% endif %}' data-ref='{{ t.ref }}'>
{% if may.edit %}<input type='checkbox' class='tsel' aria-label='выбрать {{ t.ref }}' title='выбрать (Shift — диапазон)'><span class='grip' tabindex='0' role='button' aria-label='переместить {{ t.ref }}: перетащите или Alt+↑/↓' title='перетащите · Alt+↑/↓'>⠿</span>{% endif %}
{% set rp = t.revision.rpartition('_v') %}<span class='tref has-tip'><a class='mono ref' href='/web/image/{{ t.revision | ref_url }}' aria-describedby='tip-{{ loop.index }}-{{ b.id }}'>{{ rp[0] }}</a> <span class='pill sm ver'>версия {{ rp[2] }}</span>{% if t.at %} <span class='small dim'>обновлено {{ ago(t.at) }}</span>{% endif %}
<span class='tip card' role='tooltip' id='tip-{{ loop.index }}-{{ b.id }}'><span class='kind kind-task'>{{ icon('task') }} задание</span><b class='mono'>{{ rp[0] }}</b><span class='sub small'>{{ t.about or 'без описания' }}</span><a class='small' href='/web/image/{{ t.revision | ref_url }}'>открыть задание →</a></span></span>
{% if t.has_wiki %}<a class='small' href='/web/wiki/{{ t.repo }}' title='теория задания'>wiki</a>{% endif %}
{% if t.hidden %}<span class='pill closed sm'>скрыто</span>{% endif %}
{% if t.needs and may.content %}{% set own = t.needs | reject('equalto', t.after) | list %}
{% if t.after %}<span class='pill chain sm' title='задания по порядку'>⤷ после «{{ t.after.partition(':')[0].rpartition('/')[2] }}»</span>{% endif %}
{% if own %}<span class='pill warn sm'>🔒 откроется после: {{ need_names(own, block_names) }}</span>{% endif %}
{% elif t.waiting_for %}<span class='pill warn sm'>🔒 откроется, когда решите: {% for n in t.waiting_for %}«{{ n }}»{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
{% if t.latest and t.latest > t.n %}<span class='pill warn sm'>есть версия {{ t.latest }}</span>{% endif %}
<span class='sp'></span>
{% if may.edit %}<span class='row-tools'>
<button type='button' class='icon-btn' data-move='up' aria-label='Выше' title='Выше (Alt+↑)'><svg viewBox='0 0 24 24' width='18' height='18' aria-hidden='true'><path d='M18 15l-6-6-6 6'/></svg></button>
<button type='button' class='icon-btn' data-move='down' aria-label='Ниже' title='Ниже (Alt+↓)'><svg viewBox='0 0 24 24' width='18' height='18' aria-hidden='true'><path d='M6 9l6 6 6-6'/></svg></button>
{{ eye(api ~ '/tasks/' ~ t.ref, 'hidden', not t.hidden, t.ref) }}</span>{% endif %}
{% if may.edit or (may.add and t.added_by == signed_in) %}
<details class='menu task-menu'><summary class='menu-dot' title='действия'>⋯</summary>
<div class='menu-list card'>
{% if may.edit %}
<form class='block-needs' data-api='PUT {{ api }}/tasks/{{ t.ref }}'>
<span class='small dim'>Откроется, когда решено:</span>
{% if b.tasks_in_order %}<span class='small dim'>Задания блока идут по порядку — предыдущее ставится само.</span>{% endif %}
{{ needs_picker(t.needs, task_refs, skip_block=b.id, skip_ref=t.ref) }}
<button class='menu-item' type='submit'>Сохранить условие</button></form>
{% endif %}
{% if t.latest and t.latest > t.n %}{{ act('PUT', api ~ '/tasks/' ~ t.ref, 'Обновить до v' ~ t.latest, fields={'n': t.latest}) }}{% endif %}
{% if may.edit %}{{ act('DELETE', api ~ '/tasks/' ~ t.ref, 'Убрать из курса', 'menu-item danger', confirm='Убрать задание из курса?') }}{% endif %}
</div></details>
{% endif %}
</li>
{% endfor %}
</ul>
</div>
{% endfor %}
{% if may.edit %}<div class='bulkbar card' role='region' aria-label='Выбранные задания' hidden>
<span><b class='bulk-n'>0</b> <span class='bulk-word'>выбрано</span></span>
<button type='button' class='btn sm ghost' data-bulk='hide'>Скрыть</button>
<button type='button' class='btn sm ghost' data-bulk='show'>Показать</button>
<label class='bulk-move'><span class='visually-hidden'>Перенести в блок</span><select data-bulk-move>
<option value=''>Перенести в блок…</option>{% for bb in c.blocks %}<option value='{{ bb.id }}'>{{ bb.name }}</option>{% endfor %}</select></label>
<span class='sp'></span>
<button type='button' class='btn sm ghost' data-bulk='clear'>Снять выбор</button>
</div>{% endif %}
</div>
{% else %}
<div class='empty card'><p class='sub'>Заданий пока нет.</p></div>
{% endif %}

</section>
<section id='proposals-tab' class='tab-panel' aria-label='Предложения'>
{% if c.proposals or c.updates %}
<h2 id='proposals'>Предложения</h2>
<div class='card'>
<table>
<tr><th>Что</th><th>Версия</th><th>Кто</th><th>Комментарий</th><th>Состояние</th><th></th></tr>
{% for p in c.updates or [] %}
<tr><td>обновить</td><td class='mono'>{{ p.repo }}:{{ p.tag }} → версия {{ p.latest }}</td><td>—</td><td class='sub small'>вышла новая версия</td><td><span class='pill warn sm'>ждёт</span></td>
<td>{{ act('PUT', api ~ '/tasks/' ~ p.repo ~ ':' ~ p.tag, 'Обновить', 'sm', {'n': p.latest}) }}</td></tr>
{% endfor %}
{% for p in c.proposals | reverse %}
<tr><td>{{ {'add': 'добавить', 'update': 'обновить', 'restore': 'вернуть'}[p.kind] }}</td>
<td class='mono'><a href='/web/image/{{ (p.repo ~ ":" ~ p.tag ~ "_v" ~ p.n) | ref_url }}'>{{ (p.repo ~ ':' ~ p.tag ~ '_v' ~ p.n) | ver }}</a></td>
<td>{{ p.by }}</td><td class='sub small'>{{ p.comment }}{% if p.reason %}<br>причина: {{ p.reason }}{% endif %}</td>
<td>{% if p.state == 'open' %}<span class='pill warn sm'>открыто</span>{% elif p.state == 'accepted' %}<span class='pill open sm'>принято</span>{% elif p.state == 'rejected' %}<span class='pill no sm'>отклонено</span>{% else %}<span class='pill sm'>отозвано</span>{% endif %}</td>
<td class='row'>{% if p.state == 'open' %}
{% if may.content %}{{ act('POST', api ~ '/proposals/' ~ p.id, 'Принять', 'sm', {'action': 'accept'}) }}
<form class='inline row' data-api='POST {{ api }}/proposals/{{ p.id }}'><input type='hidden' name='action' value='reject'>
<input name='reason' placeholder='причина' class='sm'><button class='sm ghost' type='submit'>Отклонить</button></form>{% endif %}
{% if p.by == signed_in %}{{ act('POST', api ~ '/proposals/' ~ p.id, 'Отозвать', 'sm ghost', {'action': 'withdraw'}) }}{% endif %}
{% endif %}</td></tr>
{% endfor %}
</table>
</div>
{% endif %}

</section>
<section id='requests-tab' class='tab-panel' aria-label='Заявки'>
{% if may.people and c.requests %}
<h2 id='requests'>Заявки на доступ</h2>
<div class='card'><table>
<tr><th>Кто</th><th>Комментарий</th><th>Когда</th><th></th></tr>
{% for r in c.requests %}
<tr><td><a href='/web/user/{{ r.user | q }}'>{{ r.user }}</a></td><td class='sub small'>{{ r.comment }}</td><td>{{ ts(r.at) }}</td>
<td class='row'>{{ act('POST', api ~ '/requests/' ~ r.user, 'Принять', 'sm', {'accept': true}) }}{{ act('POST', api ~ '/requests/' ~ r.user, 'Отклонить', 'sm ghost', {'accept': false}) }}</td></tr>
{% endfor %}
</table></div>
{% endif %}

</section>
<section id='people' class='tab-panel' aria-label='Команда курса'>
<h2>Команда курса</h2>
{% macro rights_view(user, role) %}{% set boxes = (c.perms or {}).get(user, []) %}{% set extras = (c.extras or {}).get(user, []) %}
{% if role == 'admin' and boxes %}<span class='rights'>{% for k in boxes %}<span class='chip on static'>{{ perm_labels[k] }}</span>{% endfor %}</span>
{% elif role == 'author' and extras %}<span class='rights'>{% for k in extras %}<span class='chip on static' title='{{ extra_hints[k] }}'>+ {{ extra_labels[k] }}</span>{% endfor %}</span>{% endif %}
{% endmacro %}
{% macro rights_edit(user, role, idx) %}{% set boxes = (c.perms or {}).get(user, []) %}{% set extras = (c.extras or {}).get(user, []) %}
{% if may.admins %}<fieldset class='rights' data-for-role='admin'{% if role != 'admin' %} hidden{% endif %}><legend class='visually-hidden'>Права админа {{ user }}</legend>
{% for k, label in perm_labels.items() %}<label class='chip'><input type='checkbox' name='perms' value='{{ k }}' data-type='list'{% if k in boxes or (role != 'admin' and k in default_boxes) %} checked{% endif %}{% if role != 'admin' %} disabled{% endif %}>{{ label }}</label>{% endfor %}</fieldset>{% endif %}
<fieldset class='rights' data-for-role='author'{% if role != 'author' %} hidden{% endif %}><legend class='visually-hidden'>Дополнительные права автора {{ user }}</legend>
{% for k, label in extra_labels.items() %}<label class='chip' title='{{ extra_hints[k] }}{% if k not in givable %} — выдать может тот, у кого есть «{{ perm_labels[extra_needs[k]] }}»{% endif %}'><input type='checkbox' name='extras' value='{{ k }}' data-type='list' data-givable='{{ 1 if k in givable else 0 }}'{% if k in extras %} checked{% endif %}{% if role != 'author' or k not in givable %} disabled{% endif %}>+ {{ label }}</label>{% endfor %}</fieldset>
{% endmacro %}
{% macro person(user, role, idx) %}
<li class='member'><div class='member-head'><a class='person' href='/u/{{ user | q }}'>{{ avatar(user, 'sm') }}<span class='mono'>{{ user }}</span></a>
{% set boxes = (c.perms or {}).get(user, []) %}
{% if user != signed_in and ((role != 'admin' and may.people) or may.admins) %}
<form class='member-form' data-api='PUT {{ api }}/members/{{ user | q }}'>
<label class='visually-hidden' for='crole-{{ idx }}'>Роль {{ user }}</label>
<select id='crole-{{ idx }}' name='role' data-rights-role>{% for r in ['member', 'author', 'admin'] %}{% if r != 'admin' or may.admins %}<option value='{{ r }}'{% if r == role %} selected{% endif %}>{{ role_ru[r] }}</option>{% endif %}{% endfor %}</select>
{{ rights_edit(user, role, idx) }}
<button class='sm ghost' type='submit'>Сохранить</button></form>
{{ act('DELETE', api ~ '/members/' ~ (user | q), 'Убрать', 'sm danger', confirm='Убрать ' ~ user ~ ' из курса?') }}
{% else %}<span class='pill sm'>{{ role_ru[role] }}</span>{{ rights_view(user, role) }}{% endif %}
</div></li>
{% endmacro %}
{% set team = (c.members or {}).items() | rejectattr(1, 'equalto', 'member') | list %}
{% set admitted = (c.members or {}).items() | selectattr(1, 'equalto', 'member') | list %}
<div class='card'>
<ul class='people team'>
<li class='member'><div class='member-head'><a class='person' href='/u/{{ ref_parts[0] | q }}'>{{ avatar(ref_parts[0], 'sm') }}<span class='mono'>{{ ref_parts[0] }}</span></a><span class='pill sm author'>владелец</span></div></li>
{% for user, role in team | sort(attribute='1') %}{{ person(user, role, 't' ~ loop.index) }}{% endfor %}
</ul>
{% if admitted %}
<h3 class='team-sub'>Допущены к курсу <span class='count-pill'>{{ admitted | length }}</span></h3>
<ul class='people'>{% for user, role in admitted %}{{ person(user, role, 'm' ~ loop.index) }}{% endfor %}</ul>
{% endif %}
{% if may.people %}
<hr class='divider'>
<form class='member-form add' data-api='PUT {{ api }}/members/__LOGIN__'>
<label class='visually-hidden' for='new-cmember'>Логин</label>
<input id='new-cmember' name='__login' placeholder='логин пользователя' required>
<label class='visually-hidden' for='new-crole'>Роль</label>
<select id='new-crole' name='role' data-rights-role><option value='member'>участник — проходит приватный курс</option><option value='author' selected>автор — добавляет задания</option>{% if may.admins %}<option value='admin'>админ — управляет курсом</option>{% endif %}</select>
{{ rights_edit('', 'author', 'new') }}
<button class='sm' type='submit'>Добавить</button>
</form>
<p class='sub small'>Ссылка-приглашение — кто откроет её и войдёт, станет участником курса: <code class='copy'>{{ invite_link }}</code></p>
{{ act('PUT', api, 'Сменить ссылку (старая перестанет работать)', 'sm ghost', {'rotate_invite': true}) }}
{% endif %}
<p class='sub small'>Автор добавляет задания сам и обновляет свои; ему можно дать дополнительные права — {% for k, label in extra_labels.items() %}«{{ label }}» ({{ extra_hints[k] }}){% if not loop.last %} и {% endif %}{% endfor %}. Админ управляет курсом в пределах отмеченных прав; владелец может всё. Участник проходит приватный курс и предлагает задания.</p>
</div>
</section>
{% if copy.merges %}
<section id='merges-tab' class='tab-panel' aria-label='Запросы слияния'>
<h2>Запросы слияния</h2>
<p class='sub small'>Форк предлагает свой курс целиком: принять — значит сделать задания и порядок как в нём (открытые блоки и скрытые задания останутся вашими).</p>
<div class='card'><table>
<tr><th>Откуда</th><th>Кто</th><th>Что изменится</th><th>Состояние</th><th></th></tr>
{% for m in copy.merges %}
<tr><td class='mono'><a href='/c/{{ m.from_ref }}'>{{ m.from_ref }}</a></td><td><a href='/u/{{ m.by | q }}'>{{ m.by }}</a>{% if m.comment %}<div class='sub small'>«{{ m.comment }}»</div>{% endif %}</td>
<td><ul class='small'>{% for x in m.changes %}<li>{{ x.text }}</li>{% else %}<li class='dim'>ничего</li>{% endfor %}</ul></td>
<td>{% if m.state == 'open' %}<span class='pill warn sm'>открыт</span>{% if m.stale %} <span class='pill sm'>устарел</span>{% endif %}{% elif m.state == 'merged' %}<span class='pill open sm'>принят</span>{% elif m.state == 'rejected' %}<span class='pill no sm'>отклонён</span>{% if m.reason %}<div class='sub small'>{{ m.reason }}</div>{% endif %}{% else %}<span class='pill sm'>отозван</span>{% endif %}</td>
<td class='row'>{% if m.state == 'open' %}
{% if may.content %}{% if not m.stale %}{{ act('POST', api ~ '/merges/' ~ m.id, 'Принять', 'sm', {'action': 'merge'}, confirm='Сделать курс как в ' ~ m.from_ref ~ '?') }}{% endif %}
<form class='inline row' data-api='POST {{ api }}/merges/{{ m.id }}'><input type='hidden' name='action' value='reject'>
<input name='reason' placeholder='причина' class='sm'><button class='sm ghost' type='submit'>Отклонить</button></form>{% endif %}
{% if m.by == signed_in %}{{ act('POST', api ~ '/merges/' ~ m.id, 'Отозвать', 'sm ghost', {'action': 'withdraw'}) }}{% endif %}
{% endif %}</td></tr>
{% endfor %}
</table></div>
</section>
{% endif %}
{% if c.copies and c.copies.list %}
<section id='copies-tab' class='tab-panel' aria-label='Копии курса'>
<h2>Зеркала и форки</h2>
<div class='card'><ul class='people'>
{% for x in c.copies.list %}<li class='member'><div class='member-head'><a class='mono' href='/c/{{ x.ref }}'>{{ x.ref }}</a><span class='pill sm'>{{ 'зеркало' if x.kind == 'mirror' else 'форк' }}</span><span class='sub small'>{{ x.title }}</span></div></li>{% endfor %}
</ul>
{% if c.copies.list | length < c.copies.mirrors + c.copies.forks %}<p class='sub small'>И приватные копии, которых вам не видно.</p>{% endif %}
</div>
</section>
{% endif %}
<section id='history' class='tab-panel' aria-label='Изменения в курсе'>
<h2>Изменения в курсе</h2>
{% if c.history %}
<ol class='commits card'>
{% for h in c.history %}
<li class='commit'>
<div class='commit-main'>
<span class='msg'>{{ h.what }}</span>{% if h.comment %} <span class='why'>«{{ h.comment }}»</span>{% endif %}
<div class='sub small'><a class='who' href='/u/{{ h.by | q }}'>{{ avatar(h.by, 'xs') }}<span class='mono'>{{ h.by }}</span></a> · {{ ts(h.at) }}</div>
</div>
</li>
{% endfor %}
</ol>
{% else %}<div class='empty card'><p class='sub'>Изменений пока не было.</p></div>{% endif %}
</section>
{% if not may.students and may.people %}
<section id='invite-tab' class='tab-panel' aria-label='Пригласить'>
{{ invite_card() }}
</section>
{% endif %}
{% if may.students %}
<section id='students' class='tab-panel' aria-label='Участники курса'>
<div class='cat-head'><h2>Участники курса <span class='count-pill'>{{ students | length }}</span></h2></div>
{% if may.people %}{{ invite_card() }}{% endif %}
{% if students %}
<div class='card'>
<div class='row students-tools'>
<label class='visually-hidden' for='student-q'>Найти среди участников курса</label>
<input id='student-q' type='search' placeholder='найти по логину или комментарию' data-filter='#student-rows tr'>
<span class='sub small legend'><span class='cell passed'>✓</span> решено <span class='cell passed pasted'>⚠</span> решено со вставками <span class='cell started'>◐</span> начато <span class='cell none'>·</span> не начато</span>
</div>
<div class='table-wrap'>
<table class='sortable students'>
<thead><tr><th scope='col'>Кто</th><th scope='col'>Прогресс</th><th scope='col' data-nosort>По заданиям</th></tr></thead>
<tbody id='student-rows'>
{% for s in students %}
<tr data-text='{{ s.user }} {{ s.comment }}'>
<td><a class='mono' href='/c/{{ c.ref }}/u/{{ s.user | q }}'>{{ s.user }}</a>{% if s.comment %}<div class='sub small'>{{ s.comment }}</div>{% endif %}{% if may.people %} {{ act('DELETE', api ~ '/students/' ~ (s.user | q), 'Убрать', 'sm ghost', confirm='Убрать ' ~ s.user ~ ' из курса? Прогресс сохранится.') }}{% endif %}</td>
<td data-sort='{{ s.done }}'><div class='progress' role='progressbar' aria-valuemin='0' aria-valuemax='{{ s.total }}' aria-valuenow='{{ s.done }}' aria-label='решено {{ s.done }} из {{ s.total }}'><span style='width:{{ s.pct }}%'></span></div><span class='small num'>{{ s.done }} / {{ s.total }}</span></td>
<td><div class='cells'>{% for x in s.cells %}<a class='cell {{ x.cls }}' href='{{ x.href }}' title='№{{ x.n }} {{ x.ref }} — {{ x.word }}{% if x.about %}. {{ x.about }}{% endif %}' aria-label='задание {{ x.n }}, {{ x.ref }}: {{ x.word }}'>{{ x.mark }}</a>{% endfor %}</div></td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
<p class='sub small'>Логин — его задания в этом курсе: попытки, время, история команд.</p>
</div>
{% else %}<div class='empty card'><p class='sub'>Курс пока никто не проходит.{% if not may.people %} Поделитесь ссылкой: <code class='copy'>{{ link }}</code>{% endif %}</p></div>{% endif %}
</section>
{% endif %}

{% if may.content %}
<section id='settings-tab' class='tab-panel' aria-label='Настройки'>
<h2 id='settings'>Настройки</h2>
<div class='card'>
<form data-api='PUT {{ api }}' data-rev='{{ c.rev }}' data-then='go:/c/{ref}'>
<label>Название<input name='title' value='{{ c.title }}'></label>
{% if may.delete %}<label>Адрес <span class='sub small'>/c/{{ c.owner }}/…, латиница, цифры, дефис; старая ссылка перестанет работать</span><input name='name' value='{{ c.name }}' pattern='[a-z0-9][a-z0-9\-]{0,63}'></label>{% endif %}
<label>Описание<textarea name='description' rows='3'>{{ c.description }}</textarea></label>
<label>Видимость<select name='visibility'>
<option value='public'{% if c.visibility == 'public' %} selected{% endif %}>публичный</option>
<option value='private'{% if c.visibility == 'private' %} selected{% endif %}>приватный</option></select></label>
{% if may.edit %}<label class='check'><input type='checkbox' name='auto_update' data-type='bool'{% if c.settings.auto_update %} checked{% endif %}> Автообновление: задания сами переходят на новые версии</label>{% endif %}
<label class='check'><input type='checkbox' name='auto_accept' data-type='bool'{% if c.settings.auto_accept %} checked{% endif %}> Принимать предложения сразу</label>
<label class='check'><input type='checkbox' name='allow_mirrors' data-type='bool'{% if c.settings.allow_mirrors %} checked{% endif %}> Разрешить зеркала — копии с теми же заданиями, их учениками управляет сделавший</label>
<label class='check'><input type='checkbox' name='allow_forks' data-type='bool'{% if c.settings.allow_forks %} checked{% endif %}> Разрешить форки — копии, которые правят и предлагают сюда целиком</label>
<button type='submit'>Сохранить</button>
</form>
{% for kind, word, flag in [('mirror', 'зеркала', 'allow_mirrors'), ('fork', 'форки', 'allow_forks')] %}{% set d = copy[kind ~ 's'] %}
{% if d and d.n %}
<form class='inline' data-api='PUT {{ api }}' data-confirm='Удалить {{ d.n | plural("курс", "курса", "курсов") }}? Их ученики потеряют эти курсы (решённое у них останется).'>
<input type='hidden' name='{{ flag }}' value='false' data-type='bool'><input type='checkbox' name='delete_existing' value='{{ kind }}s' data-type='list' checked hidden>
<button class='sm danger' type='submit'>Запретить {{ word }} и удалить существующие: {{ d.n | plural('курс', 'курса', 'курсов') }}, {{ d.students | plural('участник', 'участника', 'участников') }}</button></form>
{% endif %}{% endfor %}
{% if may.delete %}<hr class='divider'>
{{ act('DELETE', api, 'Удалить курс', 'sm danger', confirm='Удалить курс насовсем? Задания и образы останутся — удалится только курс.', then='go:/c') }}{% endif %}
</div>
</section>
{% endif %}
{% endif %}
<script src='/static/api.js'></script>
<script src='/static/team.js'></script>
{% if may.people %}<script src='/static/usersearch.js'></script>{% endif %}
