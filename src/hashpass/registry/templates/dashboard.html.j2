{% extends 'base.html.j2' %}
{% block main %}
<h1>Прогресс студентов</h1>
{% if groups %}
<p>Группы: <a class='pill' href='/web'>все</a>
{% for g in groups %} <a class='pill' href='/web?group={{ g }}'>{{ g }}</a>{% endfor %}</p>
{% endif %}
<table><tr><th>Логин</th><th>Группа</th><th>Комментарий</th><th>Σ</th>
{% for e in entries %}<th title='{{ e.ref }}'>{{ e.number }}</th>{% endfor %}
</tr>
{% if rows %}{% for r in rows %}
<tr><td class='mono'>{{ r.user }}</td><td>{{ r.group }}</td><td>{{ r.comment }}</td><td class='c'>{{ r.passed }}/{{ r.total }}</td>
{% for c in r.cells %}
{% if c.mark %}<td class='{{ c.cls }}'><a href='{{ c.href }}' title='история'>{{ c.mark }}</a></td>{% else %}<td class='c'>·</td>{% endif %}
{% endfor %}
</tr>
{% endfor %}{% else %}
<tr><td colspan=99>нет студентов</td></tr>
{% endif %}
</table>
{% endblock %}
