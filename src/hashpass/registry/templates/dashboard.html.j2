{% extends 'base.html.j2' %}
{% block main %}
<h1>Прогресс студентов</h1>
<p class='sub small legend'><span class='dim'>·</span> не выполнялось &nbsp; <span class='run'>◐</span> выполняется &nbsp; <span class='ok'>✓</span> зачтено</p>
{% if groups %}
<p>Группы: <a class='pill' href='/web'>все</a>
{% for g in groups %} <a class='pill' href='/web?group={{ g }}'>{{ g }}</a>{% endfor %}</p>
{% endif %}
<table class='sortable'><thead><tr><th>Логин</th><th>Группа</th><th>Комментарий</th><th>Σ</th>
{% for e in entries %}<th title='{{ e.ref }}'><a href='/web/image/{{ e.ref|ref_url }}'>{{ e.ref.split(':')[0].split('/')[-1] }}</a></th>{% endfor %}
</tr></thead>
<tbody>
{% if rows %}{% for r in rows %}
<tr><td class='mono'><a href='/web/user/{{ r.user_q }}'>{{ r.user }}</a></td><td>{{ r.group }}</td><td>{{ r.comment }}</td><td class='c' data-sort='{{ r.passed }}'>{{ r.passed }}/{{ r.total }}</td>
{% for c in r.cells %}
{% if c.mark %}<td class='{{ c.cls }}' data-sort='{{ c.rank }}'><a href='{{ c.href }}' title='{{ c.title }}'>{{ c.mark }}</a></td>{% else %}<td class='c dim' data-sort='0' title='{{ c.title }}'>·</td>{% endif %}
{% endfor %}
</tr>
{% endfor %}{% else %}
<tr><td colspan=99>нет студентов</td></tr>
{% endif %}
</tbody>
</table>
{% endblock %}
