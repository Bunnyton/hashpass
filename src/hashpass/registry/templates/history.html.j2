{% extends 'base.html.j2' %}
{% block main %}
<h1>История: {{ user }}</h1>
<p class='sub'><span class='mono'>{{ ref }}</span> — {{ status }}; антибот: <b>{{ verdict }}</b> (вручную {{ typed }}, вставлено {{ pasted }})</p>
{% if rows %}
<table><tr><th>Команда</th><th class='c'>Скорость</th><th></th></tr>
{% for h in rows %}
<tr><td class='mono'>{{ h.command }}</td><td class='c'>{{ h.speed }}</td><td>{% if h.pasted %}<span class='pill no'>вставка</span>{% endif %}</td></tr>
{% endfor %}
</table>
{% else %}
<p class='sub'>История команд не записана (старый рантайм или нет данных).</p>
{% endif %}
<p style='margin-top:16px'><a class='btn ghost' href='/web'>← к прогрессу</a></p>
{% endblock %}
