{% extends 'base.html.j2' %}
{% block main %}
<p class='crumb'><a href='/web'>← Прогресс</a> · <a href='/web/user/{{ user_q }}'>← профиль {{ user }}</a></p>
<h1>История: <a href='/web/user/{{ user_q }}'>{{ user }}</a> <span class='live-state sub small' aria-live='polite'></span></h1>
<div id='history-live' data-live-src='/web/history/live?user={{ user_q }}&ref={{ ref_q }}' data-sig='{{ sig }}'>
{% include '_history_live.html.j2' %}
</div>
<script src='/static/history.js'></script>
{% endblock %}
