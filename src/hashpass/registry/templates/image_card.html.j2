{% extends 'base.html.j2' %}
{% from '_files.html.j2' import filebox, icon %}
{% from '_cards.html.j2' import avatar %}
{% block main %}
<nav class='crumb' aria-label='Путь'>{% if courses_era %}<a href='/'>← Главная</a> · <a href='/u/{{ repo.split('/')[0] | q }}'>{{ repo.split('/')[0] }}</a>{% else %}<a href='/web/images'>← Каталог</a>{% endif %}</nav>
<div class='card-hero'>
<div class='row hero-kind'>
{% if image.kind == 'task' %}<span class='kind kind-task'>{{ icon('task') }} задание</span>{% else %}<span class='kind kind-image'>{{ icon('image') }} образ</span>{% endif %}
{% if repo_info and repo_info.visibility == 'private' %}<span class='pill closed sm'>приватный</span>{% endif %}
</div>
<h1 class='mono ref-title'>{{ image.ref | ver }}</h1>
{% if image.about[0] or image.about[1] %}<p class='lead'>{{ image.about[0] or image.about[1][0] }}</p>{% endif %}
<div class='row'>
<span class='sub small'>владелец <a href='/u/{{ repo.split('/')[0] | q }}'>{{ repo.split('/')[0] }}</a></span>
{% if not courses_era %}
{% if image.block_name %}<span class='pill'>блок «{{ image.block_name }}»</span>{% endif %}
{% if image.hidden %}<span class='pill closed'>скрыт</span>{% endif %}
{% endif %}
{% if courses_era %}{% elif image.moderation == 'rejected' %}<span class='pill no'>отклонено{% if image.reason %}: {{ image.reason }}{% endif %}</span>
{% elif image.pending_update %}<span class='pill warn'>обновление на проверке</span>
{% elif image.moderation == 'pending' %}<span class='pill warn'>на проверке</span>
{% elif image.moderation == 'approved' %}<span class='pill'>одобрено</span>{% endif %}
</div>
</div>
<nav class='tabs' aria-label='Разделы'>
<a href='#about-tab' data-tab>Описание</a>
<a href='#sources-tab' data-tab>{{ icon('dir') }} Исходники</a>
{% if repo_info %}<a href='#revisions' data-tab>Версии <span class='count'>{{ repo_info.tags.values() | map('length') | sum }}</span></a>{% endif %}
{% if courses_era %}<a href='#courses' data-tab>{{ icon('course') }} Используется в курсах <span class='count'>{{ used_in | length }}</span></a>{% endif %}
{% if people %}<a href='#people' data-tab>{{ icon('user') }} Участники <span class='count'>{{ people | length }}</span></a>{% endif %}
{% if merges or may_fork or (fork_origin and n) %}<a href='#changes-tab' data-tab>Предложения{% if merges %} <span class='count'>{{ merges | selectattr('state', 'equalto', 'open') | list | length }}</span>{% endif %}</a>{% endif %}
</nav>
<section id='about-tab' class='tab-panel' aria-label='Описание'>
<div class='card'>
<h2>Описание</h2>
{% if image.description %}<div class='about'>{% if image.about[0] %}<h3>{{ image.about[0] }}</h3>{% endif %}{% for p in image.about[1] %}<p>{{ p }}</p>{% endfor %}</div>{% else %}<p class='sub'>Описания нет.</p>{% endif %}
{% if owner %}<p class='sub small'>Описание — это файл <code>README.md</code> рядом с Taskfile: правится в задании и публикуется с <code>hashpass push</code>.</p>{% endif %}
</div>
</section>
<section id='sources-tab' class='tab-panel' aria-label='Исходники'>
<h2>Исходники</h2>
{% if image.sources %}
{{ filebox(image.sources) }}
{% elif image.files %}
<div class='filebox'>
<div class='fb-head'><span class='fb-title'>{{ icon('dir') }} Исходники</span><span class='fb-meta'>файлов: {{ image.files | length }}</span></div>
<table class='fb-rows'>
{% for f in image.files %}<tr><td class='fb-name'><a href='/web/images/file?ref={{ image.ref_q }}&name={{ f.name_q }}'>{{ icon('file') }} <span>{{ f.name }}</span></a></td>
<td class='fb-size'>{{ f.size_ru }}</td></tr>{% endfor %}
</table>
</div>
{% else %}
<div class='card'><p class='sub'>Исходников нет — они публикуются вместе с заданием (<code>hashpass push</code>).</p></div>
{% endif %}
</section>

{% if repo_info %}
<section id='revisions' class='tab-panel' aria-label='Версии'>
<h2>Версии</h2>
<div class='card'>
<div class='row'>
{% if repo_info.visibility == 'private' %}<span class='pill closed'>приватный</span>{% else %}<span class='pill open'>публичный</span>{% endif %}
{% if repo_info.hide_sources %}<span class='pill sm'>служебные файлы скрыты</span>{% endif %}
{% if repo_info.fork_of %}<span class='pill sm'>форк <a href='/web/image/{{ repo_info.fork_of | ref_url }}'>{{ repo_info.fork_of }}</a></span>{% endif %}
</div>
<table>
<tr><th>Тег</th><th>Версия</th><th>Что поменялось</th><th>Когда</th><th>Автор</th><th></th></tr>
{% for t, revs in repo_info.tags.items() %}{% set ordered = revs | sort(attribute='n') %}{% for r in ordered | reverse %}
<tr{% if t == tag and r.n == n %} class='on'{% endif %}><td class='mono'>{{ t }}</td>
<td class='mono'><a href='/web/image/{{ (repo ~ ":" ~ t ~ "_v" ~ r.n) | ref_url }}'>версия {{ r.n }}</a>{% if loop.first %} <span class='pill sm'>последняя</span>{% endif %}</td>
<td class='small'>{{ r.message or '—' }}{% if r.merged_from %}<div class='dim'>предложение из {{ r.merged_from | ver }}</div>{% endif %}
{% if not loop.last %}<div><a href='/web/compare/{{ repo }}?from={{ t }}_v{{ (ordered | reverse | list)[loop.index].n }}&to={{ t }}_v{{ r.n }}'>сравнить с предыдущей</a></div>{% endif %}</td>
<td>{{ ts(r.at) }}</td><td><a href='/u/{{ r.by | q }}'>{{ r.by }}</a>{% if r.accepted_by %}<div class='sub small'>принял <a href='/u/{{ r.accepted_by | q }}'>{{ r.accepted_by }}</a></div>{% endif %}</td>
<td>{% if owner %}<form class='inline' data-api='DELETE /revisions/{{ repo }}/{{ t }}/{{ r.n }}' data-confirm='Удалить версию {{ r.n }} тега {{ t }}? Если она стоит в чужих курсах, удаление подождёт решения администратора.'><button class='sm ghost' type='submit'>удалить</button></form>{% endif %}</td></tr>
{% endfor %}{% endfor %}
</table>
{% if owner %}
<hr class='divider'>
<form class='row' data-api='PUT /revisions/{{ repo }}'>
<label>Видимость <select name='visibility'>
<option value='public'{% if repo_info.visibility == 'public' %} selected{% endif %}>публичный</option>
<option value='private'{% if repo_info.visibility == 'private' %} selected{% endif %}>приватный</option></select></label>
<label class='check'><input type='checkbox' name='hide_sources' data-type='bool'{% if repo_info.hide_sources %} checked{% endif %}> скрыть служебные файлы (README виден всегда)</label>
<button class='sm' type='submit'>Сохранить</button>
</form>
{% if n %}<form class='row' data-api='POST /revisions/{{ repo }}/{{ tag }}_v{{ n }}/tag'>
<input type='hidden' name='from' value='{{ repo }}:{{ tag }}_v{{ n }}'>
<input name='to' placeholder='новый тег, например stable' required><button class='sm ghost' type='submit'>Навесить тег</button></form>{% endif %}
{% endif %}
</div>
</section>
{% endif %}

{% if courses_era %}
<section id='courses' class='tab-panel' aria-label='Используется в курсах'>
<h2>Используется в курсах</h2>
<div class='card'>
{% if used_in %}
<table class='places'>
<thead><tr><th scope='col'>Курс</th><th scope='col'>Блок</th><th scope='col'>Версия у студентов</th></tr></thead>
<tbody>
{% for u in used_in %}<tr><td><a href='/c/{{ u.course }}'>{{ u.title or u.course }}</a> <span class='mono small dim'>{{ u.course }}</span>{% if u.visibility == 'private' %} <span class='pill closed sm'>приватный</span>{% endif %}</td>
<td>{{ u.block or '—' }}{% if u.hidden %} <span class='pill closed sm'>скрыто</span>{% endif %}</td>
<td><a class='mono' href='/web/image/{{ (u.repo ~ ":" ~ u.tag ~ "_v" ~ u.n) | ref_url }}'>{{ u.tag }}</a> <span class='pill sm ver'>версия {{ u.n }}</span>{% if u.pinned %} <span class='pill sm'>закреплена</span>{% endif %}</td></tr>{% endfor %}
</tbody></table>
{% else %}<p class='sub'>Пока ни в одном курсе.</p>{% endif %}
{% if propose_to and n %}
<form class='row' data-api='POST /courses/__COURSE__/tasks' data-course-select>
<select name='__course'>{% for c in propose_to %}<option value='{{ c }}'>{{ c }}</option>{% endfor %}</select>
<input type='hidden' name='repo' value='{{ repo }}'><input type='hidden' name='tag' value='{{ tag }}'>
<input type='hidden' name='n' value='{{ n }}' data-type='int'>
<input name='comment' placeholder='комментарий (для предложения)'>
<button class='sm' type='submit'>Предложить в курс</button>
</form>
{% endif %}
</div>
</section>
{% endif %}
{% if people %}
<section id='people' class='tab-panel' aria-label='Участники'>
<h2>Участники</h2>
<div class='card'>
<ul class='people'>
{% for p in people %}
<li><a class='person' href='/u/{{ p.user | q }}'>{{ avatar(p.user, 'sm') }}<span class='mono'>{{ p.user }}</span></a>
{% if may_people and p.role != 'owner' %}
<form class='inline row' data-api='PUT /repo-members/{{ repo }}/{{ p.user | q }}'>
<label class='visually-hidden' for='role-{{ loop.index }}'>Роль {{ p.user }}</label>
<select id='role-{{ loop.index }}' name='role'>{% for r in ['member', 'author', 'maintainer'] %}<option value='{{ r }}'{% if r == p.role %} selected{% endif %}>{{ role_ru[r] }}</option>{% endfor %}</select>
<button class='sm ghost' type='submit'>Сохранить</button></form>
<form class='inline' data-api='DELETE /repo-members/{{ repo }}/{{ p.user | q }}' data-confirm='Убрать {{ p.user }} из участников?'><button class='sm danger' type='submit'>Убрать</button></form>
{% else %}<span class='pill sm{% if p.role == "owner" %} author{% endif %}'>{{ role_ru[p.role] }}</span>{% endif %}
</li>
{% endfor %}
</ul>
{% if may_people %}
<hr class='divider'>
<form class='row' data-api='PUT /repo-members/{{ repo }}/__LOGIN__'>
<label class='visually-hidden' for='new-member'>Логин</label>
<input id='new-member' name='__login' placeholder='логин пользователя' required>
<label class='visually-hidden' for='new-role'>Роль</label>
<select id='new-role' name='role'><option value='member'>участник — видит приватный образ</option><option value='author' selected>автор — публикует версии</option><option value='maintainer'>сопровождающий — принимает предложения, теги</option></select>
<button class='sm' type='submit'>Добавить</button>
</form>
{% endif %}
<p class='sub small'>Участник видит приватный образ; автор публикует новые версии; сопровождающий ещё принимает предложения, ставит теги и удаляет версии; владелец — настройки и роли.</p>
</div>
</section>
{% endif %}
<section id='changes-tab' class='tab-panel' aria-label='Предложения'>

{% if may_fork %}
<h2 id='fork'>Форк</h2>
<div class='card'>
<p class='sub'>Форк — копия задания в вашем пространстве имён: доработайте её (<code>hashpass clone</code> → правка → <code>build</code> → <code>push</code>) и предложите автору.</p>
<form class='row' data-api='POST /revisions/{{ viewer }}/__FORKNAME__/fork' data-fork-name data-then='go:/web/image/{ref}'>
<input type='hidden' name='from' value='{{ image.ref }}'>
<input name='__forkname' value='{{ repo.rpartition("/")[2] }}' required>
<button class='sm' type='submit'>Форкнуть</button>
</form>
</div>
{% endif %}

{% if fork_origin and n %}
<h2>Предложить автору</h2>
<div class='card'>
<form class='row' data-api='POST /revisions/{{ fork_origin }}/merges'>
<input type='hidden' name='from' value='{{ image.ref }}'>
<input name='comment' placeholder='что изменено'>
<button class='sm' type='submit'>Предложить {{ fork_origin }}</button>
</form>
</div>
{% endif %}

{% if merges %}
<h2 id='merges'>Запросы на слияние</h2>
{% for m in merges | reverse %}
<div class='card'>
<div class='row'><span class='mono'>{{ m['from'] | ver }} → {{ repo }}:{{ m.to_tag }}</span>
<a class='small' href='/web/compare/{{ repo }}?from={{ m.to_tag }}&to={{ m["from"] | q }}'>сравнить с текущей</a><span class='sp'></span>
{% if m.state == 'open' %}<span class='pill warn sm'>открыт</span>{% elif m.state == 'merged' %}<span class='pill open sm'>принят → {{ m.result }}</span>{% elif m.state == 'rejected' %}<span class='pill no sm'>отклонён{% if m.reason %}: {{ m.reason }}{% endif %}</span>{% else %}<span class='pill sm'>отозван</span>{% endif %}</div>
<p class='sub small'>{{ m.by }}{% if m.comment %}: {{ m.comment }}{% endif %}</p>
{% if m.files %}<details><summary>Изменения ({{ m.files | length }})</summary>
{% for f in m.files %}<p class='mono small'>{{ {'added': '+', 'removed': '−', 'changed': '±'}[f.change] }} {{ f.path }}</p>
{% if f.diff %}<pre class='diff'>{{ f.diff }}</pre>{% endif %}{% endfor %}</details>{% endif %}
{% if m.state == 'open' %}<div class='row'>
{% if owner %}<form class='inline' data-api='POST /revisions/{{ repo }}/merges/{{ m.id }}'><input type='hidden' name='action' value='merge'><button class='sm' type='submit'>Принять</button></form>
<form class='inline row' data-api='POST /revisions/{{ repo }}/merges/{{ m.id }}'><input type='hidden' name='action' value='reject'><input name='reason' placeholder='причина'><button class='sm ghost' type='submit'>Отклонить</button></form>{% endif %}
{% if m.by == viewer %}<form class='inline' data-api='POST /revisions/{{ repo }}/merges/{{ m.id }}'><input type='hidden' name='action' value='withdraw'><button class='sm ghost' type='submit'>Отозвать</button></form>{% endif %}
</div>{% endif %}
</div>
{% endfor %}
{% endif %}
</section>
<script src='/static/api.js'></script>
{% endblock %}
