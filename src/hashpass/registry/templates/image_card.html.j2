{% extends 'base.html.j2' %}
{% block main %}
<p class='crumb'><a href='/web/images'>← Каталог</a></p>
<div class='card-hero'>
<h1 class='mono ref-title'>{{ image.ref }}</h1>
<div class='row'>
{% if image.kind == 'task' %}<span class='pill author'>задание</span>{% else %}<span class='pill'>образ</span>{% endif %}
{% if image.block_name %}<span class='pill'>блок «{{ image.block_name }}»</span>{% endif %}
{% if image.hidden %}<span class='pill closed'>скрыт</span>{% endif %}
</div>
</div>
<div class='card'>
<h2>Описание</h2>
{% if image.description %}<div class='about'>{% if image.about[0] %}<h3>{{ image.about[0] }}</h3>{% endif %}{% for p in image.about[1] %}<p>{{ p }}</p>{% endfor %}</div>{% else %}<p class='sub'>Описания нет.</p>{% endif %}
<p class='sub'>Описание — это файл <code>about.md</code> рядом с Taskfile: правится в задании и приходит на пул с <code>hashengine push</code>.</p>
</div>
<div class='card'>
<h2>Исходники</h2>
{% if image.sources %}
<ul class='tree mono'>
{% for f in image.sources %}<li style='padding-left:{{ f.depth * 1.4 }}em'>{% if f.dir %}{{ f.name }}/{% else %}<a href='/web/images/source?ref={{ image.ref_q }}&path={{ f.path_q }}'>{{ f.name }}</a>{% endif %}</li>
{% endfor %}</ul>
<p><a class='btn sm ghost' href='/web/images/source-archive?ref={{ image.ref_q }}'>скачать архивом</a></p>
{% else %}
<p class='sub'>Исходников нет — они приходят на пул с <code>hashengine push</code>.</p>
{% endif %}
</div>
<div class='card'>
<h2>Файлы</h2>
{% if image.files %}
<table>
<tr><th>Файл</th><th class='c'>Размер</th><th></th><th></th></tr>
{% for f in image.files %}
<tr><td class='mono'>{{ f.name }}{% if f.taskfile %} <span class='pill author sm'>Taskfile</span>{% endif %}</td>
<td class='c'>{{ f.size_ru }}</td>
<td><a class='btn sm ghost' href='/web/images/file?ref={{ image.ref_q }}&name={{ f.name_q }}'>скачать</a></td>
<td><form class='inline' method='post' action='/web/images/attach-delete'>
<input type='hidden' name='ref' value='{{ image.ref }}'>
<input type='hidden' name='name' value='{{ f.name }}'>
<button class='sm ghost' type='submit'>удалить</button>
</form></td></tr>
{% endfor %}
</table>
{% else %}
<p class='sub'>Файлов нет. Taskfile прикрепляется автоматически при <code>push</code>.</p>
{% endif %}
<form class='inline row upload' method='post' action='/web/images/attach' enctype='multipart/form-data'>
<input type='hidden' name='ref' value='{{ image.ref }}'>
<input type='file' name='file' required>
<button class='sm' type='submit'>Прикрепить</button>
</form>
</div>
{% endblock %}
