{% extends 'base.html.j2' %}
{% block main %}
<h1>Настройки</h1>
{% if done %}<div class='note'>{{ done }}</div>{% endif %}
{% if error %}<div class='err'>{{ error }}</div>{% endif %}
{% if zones %}
<h2>Часовой пояс</h2>
<form class='card' method='post' action='/web/settings/tz'>
<label>Время на страницах показывается в поясе
<select name='tz'>
<option value='' class='browser-tz'{% if not tz %} selected{% endif %}>как в браузере</option>
{% for z in zones %}<option value='{{ z }}'{% if z == tz %} selected{% endif %}>{{ z }}</option>{% endfor %}
</select></label>
<p class='sub small'>Сейчас: {{ ts(now) }}. Своя настройка у каждого пользователя.</p>
<button type='submit'>Сохранить</button>
</form>
{% endif %}
<h2>Смена пароля</h2>
<form class='card' method='post' action='/web/password'>
<label>Текущий пароль<input name='old' type='password'></label>
<label>Новый пароль<input name='new' type='password' ></label>
<label>Повторите новый<input name='confirm' type='password' ></label>
<p class='sub'>{{ hint }}</p>
<button type='submit'>Сменить</button>
</form>
{% endblock %}
