{% extends 'base.html.j2' %}
{% from '_cards.html.j2' import course_card, repo_card %}
{% from '_files.html.j2' import icon %}
{% block main %}
<h1 class='visually-hidden'>Поиск</h1>
<form class='search-bar' method='get' action='/search' role='search'>
<label class='visually-hidden' for='search-q'>Что найти</label>
<span class='search-ic' aria-hidden='true'><svg viewBox='0 0 16 16' width='16' height='16'><path d='M10.68 11.74a6 6 0 0 1-7.92-8.98 6 6 0 0 1 8.98 7.92l3.04 3.04a.75.75 0 1 1-1.06 1.06ZM11.5 7a4.5 4.5 0 1 0-9 0 4.5 4.5 0 0 0 9 0Z'/></svg></span>
<input id='search-q' type='search' name='q' value='{{ q }}' placeholder='пользователи, курсы, задания, образы' autofocus>
<input type='hidden' name='type' value='{{ kind }}'>
<button type='submit'>Найти</button>
</form>
{% if missing %}<div class='empty card'><p class='sub'>Пользователя «{{ missing }}» нет.</p></div>{% endif %}
{% if kinds %}
<div class='search-layout'>
<nav class='search-side card' aria-label='Что искать'>
{% for k in kinds %}<a href='/search?q={{ q | q }}&type={{ k.key }}' data-tab='{{ k.key }}'{% if k.key == kind %} class='on' aria-current='page'{% endif %}><span>{{ icon({'users': 'user', 'courses': 'course', 'tasks': 'task', 'images': 'image'}[k.key]) }} {{ k.title }}</span> <span class='count'>{{ k.count }}</span></a>{% endfor %}
</nav>
<section class='search-results' aria-live='polite'>
{% if not rows %}
<div class='empty card'><p class='sub'>{% if q %}По запросу «{{ q }}» здесь ничего нет — загляните в соседние разделы слева.{% else %}Пока пусто.{% endif %}</p></div>
{% elif kind == 'courses' %}
<div class='grid'>{% for r in rows %}{{ course_card(r, role_ru) }}{% endfor %}</div>
{% elif kind in ('tasks', 'images') %}
<div class='grid'>{% for r in rows %}{{ repo_card(r) }}{% endfor %}</div>
{% else %}
<div class='user-list'>{% for p in rows %}<a class='card user-row' href='/u/{{ p.user | q }}'><span class='avatar sm' aria-hidden='true'>{{ p.user[:1] | upper }}</span><span class='mono'>{{ p.user }}</span></a>{% endfor %}</div>
{% endif %}
{% if more %}<p class='sub small'>и ещё {{ more }} — уточните запрос</p>{% endif %}
</section>
</div>
{% endif %}
{% endblock %}
