{% extends 'base.html.j2' %}
{% block main %}
<h1>Пользователи</h1>
<div class='card'><div class='row' style='justify-content:space-between'>
<span>Самостоятельная регистрация: <b>{{ reg_label }}</b></span>
<form class='inline' method='post' action='/web/users/registration'>
<input type='hidden' name='open' value='{{ toggle_to }}'>
<button class='sm' type='submit'>{{ toggle_label }}</button>
</form>
</div></div>
<div class='card'><div class='row' style='justify-content:space-between'>
<span>Авто-одобрение заданий для всего пула: <b>{{ 'включено' if pool_auto else 'выключено' }}</b>
<span class='sub small'>(иначе — у отмеченных авторов ниже; по умолчанию всё одобряет админ)</span></span>
<form class='inline' method='post' action='/web/pool/auto-approve'>
<input type='hidden' name='on' value='{{ '0' if pool_auto else '1' }}'>
<button class='sm' type='submit'>{{ 'Выключить' if pool_auto else 'Включить' }}</button>
</form>
</div></div>
<div class='card'><form class='inline row' method='post' action='/web/users/delete-group'>
<span>Удалить группу целиком:</span>
<input name='group' placeholder='ИУ7-31' style='width:auto'>
<button class='sm ghost' type='submit'>Удалить группу</button>
</form></div>
{% if deletions %}
<h2>Запросы на удаление версий</h2>
<div class='card'><table>
<tr><th>Версия</th><th>Кто просит</th><th>Курсы</th><th>Когда</th><th></th></tr>
{% for d in deletions %}
<tr><td class='mono'><a href='/web/image/{{ d.ref | ref_url }}'>{{ d.ref | ver }}</a></td><td>{{ d.by }}</td>
<td>{% for c in d.courses %}<a href='/c/{{ c }}'>{{ c }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td><td>{{ ts(d.at) }}</td>
<td class='row'><form class='inline' data-api='POST /deletion-requests/{{ d.id }}' data-confirm='Удалить {{ d.ref }}? Курсы, где она стоит, получат предложение вернуть предыдущую версию.'><input type='hidden' name='action' value='approve'><button class='sm danger' type='submit'>Удалить</button></form>
<form class='inline' data-api='POST /deletion-requests/{{ d.id }}'><input type='hidden' name='action' value='reject'><button class='sm ghost' type='submit'>Оставить</button></form></td></tr>
{% endfor %}
</table></div>
<script src='/static/api.js'></script>
{% endif %}
<h2>Все пользователи</h2>
<form class='row search' method='get' action='/web/users'>
<input name='q' value='{{ q }}' placeholder='поиск по логину или комментарию (например, группе ИТ-21)'>
<button class='ghost' type='submit'>Найти</button>{% if q %}<a class='btn ghost sm' href='/web/users'>сбросить</a>{% endif %}
</form>
<p class='sub small'>Группа и комментарий редактируются кликом по ячейке (Enter/уход из поля — сохраняет). Не отображаются студентам.</p>
<p class='sub small'>Клик по заголовку столбца — сортировка (повторный — в обратную сторону). Логин открывает профиль с прогрессом.</p>
<table class='wide sortable'>
<thead><tr><th>Логин</th><th>Группа</th><th>Роль</th><th>Приватный комментарий</th><th>Создан</th><th data-nosort>Изменить роль</th><th>Авто-одобрение</th><th data-nosort>Пароль</th><th data-nosort>Удалить</th></tr></thead>
<tbody>
{% if rows %}{% for r in rows %}
<tr><td class='mono'><a href='/web/user/{{ r.user_q }}'>{{ r.user }}</a></td>
<td>
<form class='inline user-edit' method='post' action='/web/users/group'>
<input type='hidden' name='user' value='{{ r.user }}'>
<input name='group' value='{{ r.group }}' placeholder='—' class='inline-edit' style='width:9em' maxlength='64'>
</form>
</td>
<td data-sort='{{ {'admin': 'a', 'author': 'b', 'student': 'c'}.get(r.role, r.role) }}'><span class='pill {{ r.role }}'>{{ r.role }}</span></td>
<td>
<form class='inline user-edit' method='post' action='/web/users/comment'>
<input type='hidden' name='user' value='{{ r.user }}'>
<input name='comment' value='{{ r.comment }}' placeholder='—' class='inline-edit' style='width:14em' maxlength='500'>
</form>
</td>
<td class='small' data-sort='{{ (r.created_at or 0)|int }}'>{{ ts(r.created_at) }}</td>
<td>{% if r.is_self %}<span class='dim'>вы</span>{% else %}
<form class='inline row' method='post' action='/web/users/role'>
<input type='hidden' name='user' value='{{ r.user }}'>
<select name='role'>{% for opt in roles %}<option value='{{ opt }}'{% if opt == r.role %} selected{% endif %}>{{ opt }}</option>{% endfor %}</select>
<button class='sm' type='submit'>OK</button>
</form>
{% endif %}</td>
<td data-sort='{{ ('1' if r.auto_approve else '0') if r.role in ('author', 'admin') else '' }}'>{% if r.role in ('author', 'admin') %}
<form class='inline' method='post' action='/web/users/auto-approve'>
<input type='hidden' name='user' value='{{ r.user }}'>
<input type='hidden' name='on' value='{{ '0' if r.auto_approve else '1' }}'>
<button class='sm{% if not r.auto_approve %} ghost{% endif %}' type='submit'>{{ 'да' if r.auto_approve else 'нет' }}</button>
</form>{% else %}<span class='dim'>—</span>{% endif %}</td>
<td><form class='inline' method='post' action='/web/users/reset'>
<input type='hidden' name='user' value='{{ r.user }}'>
<button class='sm ghost' type='submit'>ссылка сброса</button>
</form></td>
<td>{% if r.is_self %}<span class='dim'>—</span>{% else %}
<form class='inline' method='post' action='/web/users/delete'>
<input type='hidden' name='user' value='{{ r.user }}'>
<button class='sm ghost' type='submit'>удалить</button>
</form>
{% endif %}</td>
</tr>
{% endfor %}{% else %}<tr><td colspan=9 class=dim>нет пользователей</td></tr>{% endif %}
</tbody>
</table>
<script src='/static/users.js'></script>
{% endblock %}
