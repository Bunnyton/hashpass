{% extends 'base.html.j2' %}
{% block main %}
<h1>Пользователи</h1>
<div class='card'><div class='row' style='justify-content:space-between'>
<span>Самостоятельная регистрация: <b>{{ reg_label }}</b></span>
<form class='inline' method='post' action='/web/users/registration'>
<input type='hidden' name='open' value='{{ toggle_to }}'>
<button class='sm' type='submit'>{{ toggle_label }}</button>
</form>
</div></div>
<div class='card'><form class='inline row' method='post' action='/web/users/delete-group'>
<span>Удалить группу целиком:</span>
<input name='group' placeholder='ИУ7-31' style='width:auto'>
<button class='sm ghost' type='submit'>Удалить группу</button>
</form></div>
<h2>Все пользователи</h2>
<table class='wide'><tr><th>Логин</th><th>Группа</th><th>Роль</th><th>Комментарий</th><th>Изменить роль</th><th>Пароль</th><th>Удалить</th></tr>
{% if rows %}{% for r in rows %}
<tr><td class='mono'>{{ r.user }}</td><td>{{ r.group }}</td>
<td><span class='pill {{ r.role }}'>{{ r.role }}</span></td>
<td>{{ r.comment }}</td>
<td>{% if r.is_self %}<span class='dim'>вы</span>{% else %}
<form class='inline row' method='post' action='/web/users/role'>
<input type='hidden' name='user' value='{{ r.user }}'>
<select name='role'>{% for opt in roles %}<option value='{{ opt }}'{% if opt == r.role %} selected{% endif %}>{{ opt }}</option>{% endfor %}</select>
<button class='sm' type='submit'>OK</button>
</form>
{% endif %}</td>
<td><form class='inline' method='post' action='/web/users/reset'>
<input type='hidden' name='user' value='{{ r.user }}'>
<button class='sm ghost' type='submit'>ссылка сброса</button>
</form></td>
<td>{% if r.is_self %}<span class='dim'>—</span>{% else %}
<form class='inline' method='post' action='/web/users/delete'>
<input type='hidden' name='user' value='{{ r.user }}'>
<button class='sm ghost' type='submit'>удалить</button>
</form>
{% endif %}</td>
</tr>
{% endfor %}{% else %}<tr><td colspan=7 class=dim>нет пользователей</td></tr>{% endif %}
</table>
{% endblock %}
