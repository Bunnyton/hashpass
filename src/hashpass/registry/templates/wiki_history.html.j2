{% extends 'base.html.j2' %}
{#- The wiki's own versions (aside from the task's): the list, or what one version changed. -#}
{% from '_cards.html.j2' import avatar %}
{% block main %}
<nav class='crumb' aria-label='Путь'><a href='/web/wiki/{{ repo }}/wiki.md'>← wiki {{ repo }}</a></nav>
{% if shown %}
<div class='card-hero'>
<h1>Wiki: версия {{ shown.n }}</h1>
<p class='row'><a class='who' href='/u/{{ shown.by | q }}'>{{ avatar(shown.by, 'xs') }}<b class='mono'>{{ shown.by }}</b></a>
<span class='msg'>{{ shown.message or 'без комментария' }}</span><span class='small dim'>{{ shown.at }}</span></p>
</div>
{% for f in files %}
<details class='card diff-file' open>
<summary class='row'><a class='mono' href='/web/wiki/{{ repo }}/{{ f.path }}?v={{ shown.n }}'>{{ {'added': '+', 'removed': '−', 'changed': '±'}[f.change] }} {{ f.path }}</a></summary>
{% if f.diff and not f.diff.startswith('(') %}<pre class='diff'>{% for line in f.diff.splitlines() %}<span class='{% if line.startswith("+") and not line.startswith("+++") %}add{% elif line.startswith("-") and not line.startswith("---") %}del{% elif line.startswith("@@") %}hunk{% endif %}'>{{ line }}</span>
{% endfor %}</pre>{% else %}<p class='sub small'>картинка — без построчной разницы</p>{% endif %}
</details>
{% endfor %}
{% else %}
<h1>История wiki</h1>
<div class='card'><table class='fb-rows'>
{% for v in versions %}<tr><td><a href='/web/wiki/{{ repo }}/history/{{ v.n }}'><span class='pill sm ver'>версия {{ v.n }}</span></a></td>
<td><a class='who' href='/u/{{ v.by | q }}'>{{ avatar(v.by, 'xs') }}<b class='mono'>{{ v.by }}</b></a></td>
<td>{{ v.message or 'без комментария' }}</td><td class='small dim'>{{ v.changed | join(', ') }}</td><td class='small dim'>{{ v.at }}</td></tr>
{% else %}<tr><td class='sub'>Версий пока нет.</td></tr>{% endfor %}
</table></div>
{% endif %}
{% endblock %}
