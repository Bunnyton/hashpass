# hashpass base image — a friendly, colourful interactive BASH shell (a straight port of the
# earlier config.fish).  Bash-native syntax means the tasks' hints (unquoted `find -name x*`,
# `.[!.]*`, `[[ ... ]]`) work verbatim; no third-party line editor -- readline gives us
# tab-completion, history and Cyrillic input out of the box.

# Interactive-only.
case $- in *i*) ;; *) return ;; esac

# Once per shell. The console starts bash with `--rcfile /etc/hp-bashrc`; every other
# interactive bash (su -, sudo -i, a user the student created) gets here from /etc/bash.bashrc
# (image/base.py appends the hook), so the prompt, the grading and the hints follow the student
# across identities. Not exported on purpose: a child shell must load its own copy.
[ -n "${__HP_LOADED-}" ] && return
__HP_LOADED=1
# `su -` and `sudo` scrub the environment; the grade port survives in /run/hp/port (hp-console).
# A shell that had to recover it this way is NESTED: it hooks in silently -- only the console's
# first shell greets the host (the greeting renders the intro; a second one would replay it).
__hp_nested=0
if [ -z "${HP_PORT-}" ] && [ -r /run/hp/port ]; then
    HP_PORT=$(cat /run/hp/port 2>/dev/null)
    export HP_PORT
    __hp_nested=1
fi

# Debian keeps /usr/games out of ROOT's login PATH (login.defs ENV_SUPATH), so a task run as
# root (`settings user root`) could `apt install sl` and still get "sl: command not found" --
# the package lands in /usr/games. Students and root alike get the games dirs here, once.
case ":$PATH:" in
    *:/usr/games:*) ;;
    *) PATH="$PATH:/usr/local/games:/usr/games" ;;
esac
export PATH

# Prompt: cwd in bright blue, then " ❯ " in bright green, a red ✗ mark on non-zero, and a green
# «[Решено]» once the task is done (__hp_solved, set by the live-grade hooks below).
# Snapshot $? first so PS1 sees the previous command's status, not PROMPT_COMMAND's own.
_hp_last_status=0
__hp_solved=0
_hp_render_prompt() {
    _hp_last_status=$?
    local mark='' done=''
    (( _hp_last_status != 0 )) && mark=$'\[\e[91m\] ✗\[\e[0m\]'
    (( __hp_solved == 1 )) && done=$'\[\e[1;92m\] [Решено]\[\e[0m\]'
    PS1='\[\e[94m\]\w\[\e[0m\]'"$done$mark"'\[\e[92m\] ❯ \[\e[0m\]'
}

# OSC 133 semantic prompts (used by `_extract_output` on the host to isolate a command's
# stdout from the recorded terminal delta -- without them the extraction falls back to the
# full noisy delta and `observe output` grading refuses valid solves).
#   \e]133;C\a — output starts (emitted by PS0, expanded just before the command runs)
#   \e]133;D\a — output ends   (emitted by PROMPT_COMMAND, right after the command returns)
# `_hp_last_status` is set by _hp_render_prompt above but we compute it up-front here so
# `;D;$rc` appears with the actual exit code.
PS0='\[\e]133;C\a\]'
PROMPT_COMMAND='_hp_render_prompt; printf "\e]133;D;%s\a" "$_hp_last_status"'

# Handy aliases.
alias ll='ls -alh --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'

# ---------------------------------------------------------------------------------------
# Live-grade hooks -- ONLY inside a task (HP_PORT set).
#
# bash lacks a native fish_preexec/fish_postexec pair, so we synthesise one:
#   - DEBUG trap fires before every simple command; we snapshot BASH_COMMAND into
#     __hp_cmd whenever it isn't one of our own housekeeping items (a naive trap
#     would clobber it with PROMPT_COMMAND's own text).
#   - PROMPT_COMMAND fires BETWEEN commands: it runs postexec with the last real
#     command, then clears the buffer, then arms precmd for the next round.
# ---------------------------------------------------------------------------------------
if [ -n "${HP_PORT-}" ]; then
    # Armed only when the FIRST prompt is about to be drawn: this rc is sourced early (from
    # /etc/bash.bashrc) and the DEBUG trap would otherwise capture the rest of the startup
    # files (`return` below, ~/.bashrc of a `su -` login…) and ship it as a phantom command --
    # one extra «try» per shell. Until armed, preexec/postexec do nothing.
    __hp_armed=0
    # Ship only what THIS shell produces: a nested shell must not replay the whole transcript.
    __hp_off=$(stat -c %s /run/hp/typescript 2>/dev/null || echo 0)
    __hp_shadow=()
    __hp_prompt_t=""
    __hp_submit_t=""
    __hp_cmd=""

    # Called BEFORE the prompt is drawn -- record when the prompt appeared so we can compute
    # (submit_t - prompt_t) as an approximate typing time and let the host flag pastes.
    __hp_precmd() {
        __hp_prompt_t=$(date +%s.%N)
    }

    # Called BEFORE the student's command runs.  We do two things:
    #   1. Snapshot the submit time (paired with __hp_prompt_t above).
    #   2. Query the host for the stage's allow/deny policy and shadow every base command
    #      that the stage forbids with a function that refuses and returns 1 -- so a `deny cp`
    #      task truly cannot run `cp`, and `allow ls cd` refuses everything else.  A function
    #      defined here shadows the binary/builtin for THIS run only; __hp_postexec unsets
    #      them so the next command is judged fresh against the (possibly changed) policy.
    __hp_preexec() {
        [ "$__hp_armed" -eq 1 ] || return
        local f
        for f in "${__hp_shadow[@]}"; do unset -f "$f" 2>/dev/null; done
        __hp_shadow=()

        __hp_submit_t=$(date +%s.%N)

        local cmd="$1"
        local pol
        pol=$(hp-io policy 2>/dev/null) || return
        [ -z "$pol" ] && return

        local allow_s deny_s neutral_s
        IFS=';' read -r allow_s deny_s neutral_s <<< "$pol"
        [ -z "$allow_s" ] && [ -z "$deny_s" ] && return

        local -a allow deny neutral
        if [ -n "$allow_s" ];   then IFS=',' read -ra allow   <<< "$allow_s";   fi
        if [ -n "$deny_s" ];    then IFS=',' read -ra deny    <<< "$deny_s";    fi
        if [ -n "$neutral_s" ]; then IFS=',' read -ra neutral <<< "$neutral_s"; fi

        # Walk each pipeline / && || ; segment; the base command is the first token
        # (skipping a leading `sudo`).
        local flat
        flat=$(printf '%s' "$cmd" | sed -E 's/(\|\||&&|;|\|)/\n/g')
        local seg base
        local -a toks
        while IFS= read -r seg; do
            # shellcheck disable=SC2206
            toks=( $seg )
            [ ${#toks[@]} -eq 0 ] && continue
            base="${toks[0]}"
            if [ "$base" = sudo ] && [ ${#toks[@]} -ge 2 ]; then
                base="${toks[1]}"
            fi
            [ -z "$base" ] && continue
            local blocked=0
            local d
            for d in "${deny[@]}"; do [ "$d" = "$base" ] && blocked=1 && break; done
            if [ "$blocked" -ne 1 ] && [ ${#allow[@]} -gt 0 ]; then
                local ok=0 a
                for a in "${allow[@]}" "${neutral[@]}" cd exit; do
                    [ "$a" = "$base" ] && ok=1 && break
                done
                [ "$ok" -eq 0 ] && blocked=1
            fi
            if [ "$blocked" -eq 1 ]; then
                # `builtin echo` so shadowing `echo` doesn't recurse when the message runs.
                eval "$base() { builtin echo \"Команда «$base» запрещена.\"; return 1; }"
                __hp_shadow+=("$base")
            fi
        done <<< "$flat"
    }

    # Called AFTER the command has finished.  Reads the delta of the typescript that
    # script(1) has written since the previous command, base64-encodes it, and ships
    # `cmd <cmd_b64> <output_b64> <typing_seconds>` to the host.  Cap the output at
    # 64 KiB to keep the socket message bounded.
    __hp_postexec() {
        # FIRST statement: $? is still the student's command status here (PROMPT_COMMAND runs
        # us before anything else). Shipped as `rc=<n>` so `accept cmd "…" ok` can insist on 0.
        local rc=$?
        if [ "$__hp_armed" -eq 0 ]; then       # first prompt: drop whatever startup captured
            __hp_armed=1
            __hp_check_solved                  # a `su -` shell opened after the finish
            return
        fi
        local cmd="$1"
        [ -z "$cmd" ] && return
        local log=/run/hp/typescript
        local size out=""
        size=$(stat -c %s "$log" 2>/dev/null || echo 0)
        if [ "$size" -gt "${__hp_off:-0}" ]; then
            out=$(tail -c +$((__hp_off + 1)) "$log" 2>/dev/null | tail -c 65536 | base64 -w0)
        fi
        __hp_off=$size

        local typing=""
        if [ -n "$__hp_prompt_t" ] && [ -n "$__hp_submit_t" ]; then
            typing=$(awk -v a="$__hp_prompt_t" -v b="$__hp_submit_t" \
                     'BEGIN{ printf "%.6f", b - a }' 2>/dev/null)
        fi

        local cmd_b64
        cmd_b64=$(printf '%s' "$cmd" | base64 -w0)
        hp-io "cmd $cmd_b64 $out $typing rc=$rc" 2>/dev/null

        # After hp-io's reply streamed back through the terminal (and was captured by
        # script(1)), advance the offset past it so the NEXT command doesn't see the reply
        # as its own output.
        __hp_off=$(stat -c %s "$log" 2>/dev/null || echo "$size")
        __hp_check_solved
    }

    # Ask the host once per command whether every step passed; then the prompt says «[Решено]»
    # for the rest of the session and we stop asking.
    __hp_check_solved() {
        [ "$__hp_solved" -eq 1 ] && return
        [ "$(hp-io state 2>/dev/null)" = solved ] && __hp_solved=1
    }

    # Snapshot BASH_COMMAND into __hp_cmd on every simple command, EXCEPT when the current
    # command is one of our own housekeeping items (PROMPT_COMMAND's __hp_postexec / precmd
    # / prompt-render / clear).  Without the filter our own PROMPT_COMMAND items would
    # clobber the student's last command before postexec runs against it.
    # `hp-io*` is ours too: without it the greeting below lands in __hp_cmd and the FIRST
    # PROMPT_COMMAND ships "hp-io hello" as a student command -- one phantom try per session
    # (every `hint tries N` fired a rung early) and a bogus first entry in the history.
    trap '[[ "$BASH_COMMAND" == __hp_* || "$BASH_COMMAND" == _hp_* ]] || \
          [[ "$BASH_COMMAND" == PROMPT_COMMAND* || "$BASH_COMMAND" == hp-io* ]] || \
          __hp_cmd="$BASH_COMMAND"; __hp_preexec "$__hp_cmd"' DEBUG

    # PROMPT_COMMAND runs BETWEEN commands: ship the last one to the host, blank the
    # buffer, arm the next timing sample, then render the prompt.
    PROMPT_COMMAND='__hp_postexec "$__hp_cmd"; __hp_cmd=""; __hp_precmd; _hp_render_prompt'

    # Greet the host once so it renders the intro / read / first stage announce -- from the
    # console's first shell only; a plain child `bash` inherits HP_GREETED, a `su -`/`sudo -i`
    # shell is marked nested above.
    if [ "$__hp_nested" -eq 0 ] && [ -z "${HP_GREETED-}" ]; then
        export HP_GREETED=1
        hp-io hello 2>/dev/null
    fi
    __hp_cmd=""
fi
