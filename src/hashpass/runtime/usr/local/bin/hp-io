#!/bin/bash
# hp-io <request>: talk to the host grade socket over the container's shared loopback. Send the
# request line, then render the streamed reply as it arrives -- so the host's typewriter types out
# live -- and on a 0x01 control byte pause for the reader: Enter for the next page, q / Ctrl+C to
# get the rest at once (that is how `read` pages long theory). Ctrl+C while the host is still
# typing asks for the same: the rest at once, no more pauses. The host does all the work; this
# only streams the reply and handles the pause.
# its own PATH: the student may have wiped theirs (bash-path, 2026-11-04)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[ -n "$HP_PORT" ] || exit 0
exec 3<>"/dev/tcp/127.0.0.1/$HP_PORT" 2>/dev/null || exit 0
printf '%s\n' "$1" >&3
export LC_ALL=C
# Ctrl+C at any moment = «skip»: tell the host once (it stops typing and drops later pauses);
# trapped, so the reply is not killed half-way.
skipped=0
skip_rest() { [ "$skipped" -eq 1 ] && return; skipped=1; printf 'q' >&3 2>/dev/null; }
trap skip_rest INT
# The tty would echo «^C», and any key pressed while ~80 KB of colour art streams, into the middle
# of the reply -- an echoed Enter inside an escape code tore the meme (2026-10-12). Silence the echo
# for the reply; the keys stay queued and show at the next prompt.
tty_was=$(stty -g </dev/tty 2>/dev/null) && stty -echo -echoctl </dev/tty 2>/dev/null
trap '[ -n "$tty_was" ] && stty "$tty_was" </dev/tty 2>/dev/null' EXIT
# Block for one byte, then drain whatever has already arrived (<= 64 KiB, 5 ms) in one read: a
# typed character still shows the moment it lands, while a big reply (a colour meme, ~80 KB) no
# longer crawls through one loop iteration per byte (~2 s before, a blink now).
while IFS= read -r -N1 ch <&3; do
    buf=$ch
    if [ "$ch" != $'\x01' ]; then
        more=""
        IFS= read -r -t 0.005 -N 65536 more <&3
        buf+=$more
    fi
    while [[ $buf == *$'\x01'* ]]; do
        printf '%s' "${buf%%$'\x01'*}"
        if [ "$skipped" -eq 1 ]; then          # the host already has «q»: no pause, no answer
            buf=${buf#*$'\x01'}
            continue
        fi
        printf '\x1b[2m  — далее: Enter · пропустить: q —\x1b[0m' > /dev/tty
        # ONE key, no Enter (the line says so): Enter / space -> next page; «q» (or «й» on a
        # Russian layout) or Ctrl+C -> the host prints the rest at once; any other key is not an
        # answer. A whole-line read kept a bare «q» waiting: the student then typed `env` + Enter,
        # the pager got «qenv» = «next page» and the command was gone (2026-11-06).
        # Ctrl+C is trapped so it answers the pager instead of killing this reply.
        ans="" skip=0 next=0
        trap 'skip=1' INT
        # bash's `read` is not interrupted by a trapped Ctrl+C -- poll in short slices instead
        # (-n1 reads in non-canonical mode; a timed-out slice consumes nothing).
        while [ "$skip" -eq 0 ] && [ "$next" -eq 0 ]; do
            key=""
            IFS= read -r -s -n1 -t 0.2 key < /dev/tty
            rc=$?
            if [ $rc -gt 128 ]; then continue; fi  # the slice timed out
            [ $rc -ne 0 ] && { skip=1; break; }      # EOF / tty gone: skip
            if [ "$key" = $'\xd0' ]; then           # LC_ALL=C: «й» / «Й» is two bytes
                IFS= read -r -s -n1 -t 0.2 more < /dev/tty && key+=$more
            fi
            case "$key" in
                ''|' ') next=1 ;;                   # Enter (the delimiter) or space
                q|Q|й|Й) ans=q skip=1 ;;
            esac
        done
        trap skip_rest INT
        printf '\r\x1b[K' > /dev/tty
        if [ "$skip" -eq 1 ]; then skip_rest; else printf 'x' >&3; fi
        buf=${buf#*$'\x01'}
    done
    printf '%s' "$buf"
done
